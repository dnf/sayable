use v6.d;
use Test;
use lib 'lib';
use SayableDate;
use SayableDate::Formatter;
use SayableDate::Locales::Registry;

# All tests use explicit inputs for determinism.

# ================================================================
# Null / edge cases
# ================================================================
# 1.1
ok !defined(SayableDate::format-date(Str)), '1.1 null date';
# 1.2
ok !defined(SayableDate::format-date('')), '1.2 empty string';
# 1.3
ok !defined(SayableDate::format-date('invalid')), '1.3 invalid date';
# 1.4
ok !defined(SayableDate::format-relative('2025-03-15', as-of => Str)), '1.4 null as-of';
# 1.5
ok !defined(SayableDate::format-relative(Str, as-of => '2025-03-15')), '1.5 null date';

# ================================================================
# format_date — normal compactness (English)
# ================================================================
# 2.1
is SayableDate::format-date('2025-03-15'), 'March 15th', '2.1 march 15';
# 2.2
is SayableDate::format-date('2025-01-01'), 'January 1st', '2.2 jan 1';
# 2.3
is SayableDate::format-date('2025-05-22'), 'May 22nd', '2.3 may 22';
# 2.4
is SayableDate::format-date('2025-07-03'), 'July 3rd', '2.4 jul 3';
# 2.5
is SayableDate::format-date('2025-12-31'), 'December 31st', '2.5 dec 31';
# 2.6
is SayableDate::format-date('2025-06-11'), 'June 11th', '2.6 jun 11';
# 2.7
is SayableDate::format-date('2025-03-15T14:30:00'), 'March 15th', '2.7 ISO datetime';

# ================================================================
# format_date — short compactness (English)
# ================================================================
{
    my %en = SayableDate::Locales::Registry::get-locale('en');
    my $f = SayableDate::Formatter.new(%en, compactness => 'short');
    # 3.1
    is $f.format-date('2025-03-15'), 'Mar 15', '3.1 short march 15';
    # 3.2
    is $f.format-date('2025-01-01'), 'Jan 1', '3.2 short jan 1';
    # 3.3
    is $f.format-date('2025-12-25'), 'Dec 25', '3.3 short dec 25';
}

# ================================================================
# format_date — compact (English)
# ================================================================
{
    my %en = SayableDate::Locales::Registry::get-locale('en');
    my $f = SayableDate::Formatter.new(%en, compactness => 'compact');
    # 4.1
    is $f.format-date('2025-03-15'), '3/15', '4.1 compact march 15';
    # 4.2
    is $f.format-date('2025-01-01'), '1/1', '4.2 compact jan 1';
}

# ================================================================
# format_relative — proximity tiers (English)
# ================================================================
{
    my %en = SayableDate::Locales::Registry::get-locale('en');
    my $f = SayableDate::Formatter.new(%en);
    # 5.1
    is $f.format-relative('2025-03-15', as-of => '2025-03-15'), 'today', '5.1 today';
    # 5.2
    is $f.format-relative('2025-03-16', as-of => '2025-03-15'), 'tomorrow', '5.2 tomorrow';
    # 5.3
    is $f.format-relative('2025-03-14', as-of => '2025-03-15'), 'yesterday', '5.3 yesterday';
    # 5.4
    is $f.format-relative('2025-03-17', as-of => '2025-03-15'), 'the day after tomorrow', '5.4 day after tomorrow';
    # 5.5
    is $f.format-relative('2025-03-13', as-of => '2025-03-15'), 'the day before yesterday', '5.5 day before yesterday';
    # 5.6
    is $f.format-relative('2025-03-19', as-of => '2025-03-15'), 'this Wednesday', '5.6 this weekday';
    # 5.7
    is $f.format-relative('2025-03-20', as-of => '2025-03-15'), 'this Thursday', '5.7 this weekday';
    # 5.8
    is $f.format-relative('2025-03-11', as-of => '2025-03-15'), 'last Tuesday', '5.8 last weekday';
    # 5.9
    is $f.format-relative('2025-03-22', as-of => '2025-03-15'), 'next Saturday', '5.9 next weekday';
    # 5.10
    is $f.format-relative('2025-03-27', as-of => '2025-03-15'), 'next Thursday', '5.10 next weekday';
    # 5.11
    is $f.format-relative('2025-03-01', as-of => '2025-03-15'), 'March 1st', '5.11 calendar fallback same year';
    # 5.12
    is $f.format-relative('2025-04-10', as-of => '2025-03-15'), 'April 10th', '5.12 calendar fallback same year';
    # 5.13
    is $f.format-relative('2026-01-05', as-of => '2025-03-15'), 'January 5th, 2026', '5.13 different year';
    # 5.14
    is $f.format-relative('2024-12-25', as-of => '2025-03-15'), 'December 25th, 2024', '5.14 past year';
}

# ================================================================
# format_relative — compact skips weekday tiers
# ================================================================
{
    my %en = SayableDate::Locales::Registry::get-locale('en');
    my $f = SayableDate::Formatter.new(%en, compactness => 'compact');
    # 6.1
    is $f.format-relative('2025-03-15', as-of => '2025-03-15'), 'today', '6.1 compact today';
    # 6.2
    is $f.format-relative('2025-03-16', as-of => '2025-03-15'), 'tomorrow', '6.2 compact tomorrow';
    # 6.3
    is $f.format-relative('2025-03-19', as-of => '2025-03-15'), '3/19', '6.3 compact numeric';
    # 6.4
    is $f.format-relative('2026-01-05', as-of => '2025-03-15'), '1/5/26', '6.4 compact diff year';
}

# ================================================================
# Sections 13-16: with year, short months, short phrases, input validation
# ================================================================
# 13.1
is SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('en')).format-date-with-year('2018-02-04'), 'February 4th, 2018', '13.1 format_date_with_year';
# 13.2
is SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('en'), compactness => 'short').format-date-with-year('2025-03-15'), 'Mar 15, 2025', '13.2 format_date_with_year';
# 13.3
is SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('en'), compactness => 'compact').format-date-with-year('1997-01-21'), '1/21/97', '13.3 format_date_with_year';
# 13.4
is SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('tg'), compactness => 'compact').format-date-with-year('2007-05-20'), '20/5/07', '13.4 two-digit year keeps its leading zero';
# 13.5
is SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('fi'), compactness => 'short').format-date-with-year('1996-06-21'), '21. kesäkuuta 1996', '13.5 format_date_with_year';
# 14.1
is SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('sk'), compactness => 'short').format-date('2031-02-15'), '15. februára', '14.1 format_date';
# 14.2
is SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('cs'), compactness => 'short').format-date('2025-12-10'), '10. prosince', '14.2 format_date';
# 14.3
is SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('uk'), compactness => 'short').format-date('2025-11-05'), '5 листопада', '14.3 format_date';
# 14.4
is SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('fi'), compactness => 'short').format-relative('1998-08-08', as-of => '1998-08-15'), '8. elokuuta', '14.4 format_relative';
# 15.1
is SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('kw'), compactness => 'short').format-relative('2035-12-04', as-of => '2035-12-02'), 'an Mth ma', '15.1 day after tomorrow';
# 15.2
is SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('mam'), compactness => 'short').format-relative('2000-01-23', as-of => '2000-01-25'), 'Dom nchi\'j', '15.2 day before yesterday';
# 15.3
is SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('kek'), compactness => 'short').format-relative('2014-10-24', as-of => '2014-10-22'), 'a\'in Vie', '15.3 day after tomorrow';
# 16.1
ok !defined(SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('en')).format-date('2025-02-30')), '16.1 February 30 doesn\'t exist';
# 16.2
ok !defined(SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('en')).format-date('2025-13-01')), '16.2 Month 13';
# 16.3
ok !defined(SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('en')).format-date('2025-6-1')), '16.3 Unpadded month and day';
# 16.4
ok !defined(SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('en')).format-date(' 2025-06-01')), '16.4 Surrounding whitespace';
# 16.5
is SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('en')).format-date('2025-06-01T10:00:00'), 'June 1st', '16.5 An ISO datetime: only the date part is used';
# 16.6
ok !defined(SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('en')).format-date-with-year('2023-02-29')), '16.6 February 29 in a non-leap year';
# 16.7
ok !defined(SayableDate::Formatter.new(SayableDate::Locales::Registry::get-locale('en')).format-relative('2025-03-16', as-of => '2025-04-31')), '16.7 Invalid asOf';

done-testing;
