parameters:
    level: 9
    paths:
        - src
    tmpDir: .phpstan.cache
    ignoreErrors:
        # CLDR plural rules use explicit range checks for readability,
        # matching the authoritative specification. PHPStan infers tighter
        # integer ranges from prior conditions, making some bounds redundant.
        - identifier: smallerOrEqual.alwaysTrue
          path: src/Locales/Locales.php
        - identifier: notIdentical.alwaysTrue
          path: src/Locales/Locales.php
