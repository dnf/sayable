    "fsharp",
    "gleam",
    "go",
    "goose",
    "groovy",
    "haskell",
    "janet",
    "java",
    "julia",
    "kotlin",
    "lisp",
    "lua",
    "mojo",
    "nim",
    "ocaml",
    "octave",
    "odin",
    "pascal",
    "perl",
    "pharo",
    "php",
    "powershell",
    "prolog",
    "python",
    "r",
    "racket",
    "raku",
    "ruby",
    "rust",
    "scala",
    "swift",
    "tcl",
    "typescript",
    "v",
    "vbnet",
    "wren",
    "zig"
  ],
  "tools": {
    "cli": {
      "dependency": "cmake"
    },
    "shell": {
      "dependency": "shellcheck"
    }
  },
  "generated": {
    "dockerfile": "age/Dockerfile",
    "workflows": ".github/workflows/{lang}.yml"
  },
  "tasks": {
    "test": {
      "check": "just check",
      "codegen": "cd age && python3 -m unittest codegen.test_locale_groups -v"
    }
  },
  "metadata": "age/config/metadata.json",
  "logs": ".logs"
}
