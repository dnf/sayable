{
  "schema": 1,
  "hecatron": ">=0.3.0",
  "project": "sayable",
  "components": [
    "age",
    "date",
    "duration",
    "time"
  ],
  "implPath": "{component}/impl/{lang}",
  "languages": [
    "ada",
