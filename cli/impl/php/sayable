function cmdLocales(): void
{
    // Use age locales as the canonical list (all components share the same set)
    $ref = new ReflectionClass(SayableAge\Locales\Locales::class);
    $codes = [];
    foreach ($ref->getMethods(ReflectionMethod::IS_PUBLIC | ReflectionMethod::IS_STATIC) as $method) {
        // Skip the get() lookup method and any methods that require parameters
        if ($method->getName() === 'get' || $method->getNumberOfRequiredParameters() > 0) {
            continue;
        }
        $locale = $method->invoke(null);
        if ($locale instanceof SayableAge\AgeLocale) {
            $codes[] = $locale->code;
        }
    }
    sort($codes);
    $unique = array_unique($codes);
    foreach ($unique as $code) {
        echo $code . "\n";
    }
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------

$args = array_slice($argv, 1);
[$command, $positionals, $options] = parseArgs($args);

if ($command === null) {
    echo HELP . "\n";
    exit(2);
}

if ($command === 'help') {
    echo HELP . "\n";
    exit(0);
}

if ($command === 'version') {
    echo 'sayable ' . VERSION . "\n";
    exit(0);
}

if ($command === 'locales') {
    cmdLocales();
    exit(0);
}

$commands = [
    'age' => 'cmdAge',
    'stage' => 'cmdStage',
    'date' => 'cmdDate',
    'relative' => 'cmdRelative',
    'time' => 'cmdTime',
    'duration' => 'cmdDuration',
    'since' => 'cmdSince',
    'until' => 'cmdUntil',
];

if (!isset($commands[$command])) {
    error("unknown command '{$command}'");
}

$commands[$command]($positionals, $options);
