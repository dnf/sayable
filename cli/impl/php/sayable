}

/**
 * Map a compactness string to the Duration Compactness enum.
 */
function durationCompactness(string $level): SayableDuration\Compactness
{
    return match ($level) {
        'short' => SayableDuration\Compactness::Short,
        'compact' => SayableDuration\Compactness::Compact,
        default => SayableDuration\Compactness::Normal,
    };
}

/**
 * Parse CLI arguments into [command, positionals, options].
 *
 * @param list<string> $argv
 * @return array{?string, list<string>, array<string, mixed>}
 */
function parseArgs(array $argv): array
{
    if (count($argv) === 0) {
        return [null, [], []];
    }

    // Global flags that can appear as the first argument
    if (in_array($argv[0], ['-h', '--help', 'help'], true)) {
        return ['help', [], []];
    }
    if (in_array($argv[0], ['-v', '--version', 'version'], true)) {
        return ['version', [], []];
    }

    $command = $argv[0];
    $positionals = [];
    $options = [
        'locale' => 'en',
        'as_of' => null,
        'compactness' => 'normal',
        'gender' => null,
        'with_year' => false,
    ];

    $i = 1;
    $stopOpts = false;
    $argc = count($argv);

    while ($i < $argc) {
        $arg = $argv[$i];

        if ($arg === '--' && !$stopOpts) {
            $stopOpts = true;
            $i++;
            continue;
        }

        if (!$stopOpts && str_starts_with($arg, '-')) {
            if ($arg === '-l' || $arg === '--locale') {
                if ($i + 1 >= $argc) {
                    error("'{$arg}' requires a value");
                }
                $i++;
                $options['locale'] = $argv[$i];
            } elseif ($arg === '-d' || $arg === '--as-of') {
                if ($i + 1 >= $argc) {
                    error("'{$arg}' requires a value");
                }
                $i++;
                $options['as_of'] = $argv[$i];
            } elseif ($arg === '-g' || $arg === '--gender') {
                if ($i + 1 >= $argc) {
                    error("'{$arg}' requires a value");
                }
                $i++;
                $options['gender'] = $argv[$i];
            } elseif ($arg === '--short') {
                $options['compactness'] = 'short';
            } elseif ($arg === '--compact') {
                $options['compactness'] = 'compact';
            } elseif ($arg === '--with-year') {
                $options['with_year'] = true;
            } elseif ($arg === '-h' || $arg === '--help') {
                return ['help', [], []];
            } elseif ($arg === '-v' || $arg === '--version') {
                return ['version', [], []];
            } else {
                error("unknown option '{$arg}'");
            }
        } else {
            $positionals[] = $arg;
        }

        $i++;
    }

    return [$command, $positionals, $options];
}

