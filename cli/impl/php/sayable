/**
 * @param list<string> $positionals
 * @param array<string, mixed> $options
 */
function cmdDuration(array $positionals, array $options): void
{
    if (count($positionals) === 0) {
        error('duration requires a value argument');
    }
    $value = nullify($positionals[0]);

    $localeCode = $options['locale'];
    $locale = SayableDuration\Locales\Locales::get($localeCode);
    if ($locale === null) {
        error("unknown locale '{$localeCode}'");
    }

    $formatter = new SayableDuration\SayableDuration($locale, durationCompactness($options['compactness']));

    if ($value === null) {
        // Null input -> null result
        exit(1);
    } elseif (isIntegerString($value)) {
        $result = $formatter->formatDuration((int) $value);
    } else {
        // Timestamp mode: need an end argument
        if (count($positionals) < 2) {
            error('duration with timestamps requires start and end arguments');
        }
        $end = nullify($positionals[1]);
        if ($end === null) {
            exit(1);
        }
        $result = $formatter->formatDurationIso($value, $end);
    }

    if ($result === null) {
        exit(1);
    }
    echo $result . "\n";
}

/**
 * Check if a string represents an integer (including negative).
 */
function isIntegerString(string $s): bool
{
    if ($s === '') {
        return false;
    }
    $start = 0;
    if ($s[0] === '-') {
        if (strlen($s) === 1) {
            return false;
        }
        $start = 1;
    }
    for ($i = $start, $len = strlen($s); $i < $len; $i++) {
        if ($s[$i] < '0' || $s[$i] > '9') {
            return false;
        }
    }
    return true;
}

