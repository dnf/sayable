/**
 * @param list<string> $positionals
 * @param array<string, mixed> $options
 */
function cmdAge(array $positionals, array $options): void
{
    if (count($positionals) === 0) {
        error('age requires a date-of-birth argument');
    }
    $dob = nullify($positionals[0]);

    $localeCode = $options['locale'];
    $locale = SayableAge\Locales\Locales::get($localeCode);
    if ($locale === null) {
        error("unknown locale '{$localeCode}'");
    }

    $asOf = $options['as_of'];
    if ($asOf !== null) {
        $asOf = nullify($asOf);
    } else {
        $asOf = getToday();
    }

    $formatter = new SayableAge\SayableAge($locale, ageCompactness($options['compactness']));
    $result = $formatter->formatAge($dob, $asOf);

    if ($result === null) {
        exit(1);
    }
    echo $result . "\n";
}

