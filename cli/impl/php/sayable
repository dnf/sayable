/**
 * Print error to stderr and exit with code 2.
 */
function error(string $msg): never
{
    fwrite(STDERR, "error: {$msg}\n");
    fwrite(STDERR, "Run 'sayable help' for usage.\n");
    exit(2);
}

/**
 * Convert the CLI 'null' sentinel to PHP null.
 */
function nullify(?string $value): ?string
{
    if ($value === 'null') {
        return null;
    }
    return $value;
}

/**
 * Get today's date as YYYY-MM-DD.
 */
function getToday(): string
{
    return date('Y-m-d');
}

/**
 * Map a compactness string to the Age Compactness enum.
 */
function ageCompactness(string $level): SayableAge\Compactness
{
    return match ($level) {
        'short' => SayableAge\Compactness::Short,
        'compact' => SayableAge\Compactness::Compact,
        default => SayableAge\Compactness::Normal,
    };
}

/**
 * Map a compactness string to the Date Compactness enum.
 */
function dateCompactness(string $level): SayableDate\Compactness
{
    return match ($level) {
        'short' => SayableDate\Compactness::Short,
        'compact' => SayableDate\Compactness::Compact,
        default => SayableDate\Compactness::Normal,
    };
}

/**
 * Map a compactness string to the Time Compactness enum.
 */
function timeCompactness(string $level): SayableTime\Compactness
{
    return match ($level) {
        'short' => SayableTime\Compactness::Short,
        'compact' => SayableTime\Compactness::Compact,
        default => SayableTime\Compactness::Normal,
