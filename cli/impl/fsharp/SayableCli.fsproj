<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SayableCli</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../age/impl/fsharp/SayableAge/SayableAge.fsproj" />
    <ProjectReference Include="../../../date/impl/fsharp/SayableDate/SayableDate.fsproj" />
    <ProjectReference Include="../../../time/impl/fsharp/SayableTime/SayableTime.fsproj" />
    <ProjectReference Include="../../../duration/impl/fsharp/SayableDuration/SayableDuration.fsproj" />
  </ItemGroup>

</Project>
