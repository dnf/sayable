#!/usr/bin/env bash
set -euo pipefail

# Resolve the directory this script lives in
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"

# Source directories for all four components
AGE_SRC="${PROJECT_ROOT}/age/impl/java/src/main/java"
DATE_SRC="${PROJECT_ROOT}/date/impl/java/src/main/java"
TIME_SRC="${PROJECT_ROOT}/time/impl/java/src/main/java"
DURATION_SRC="${PROJECT_ROOT}/duration/impl/java/src/main/java"

# Build directory
BUILD_DIR="${SCRIPT_DIR}/build"

# Compile if Sayable.class is missing or older than any CLI or library source
_needs_build=false
if [[ ! -f "${BUILD_DIR}/Sayable.class" ]]; then
    _needs_build=true
elif [[ -n "$(find "${SCRIPT_DIR}/Sayable.java" "${AGE_SRC}" "${DATE_SRC}" "${TIME_SRC}" "${DURATION_SRC}" \
        -name '*.java' -newer "${BUILD_DIR}/Sayable.class" 2>/dev/null | head -1)" ]]; then
    _needs_build=true
fi

if ${_needs_build}; then
    rm -rf "${BUILD_DIR}"
    mkdir -p "${BUILD_DIR}"
    javac -encoding UTF-8 \
        -sourcepath "${AGE_SRC}:${DATE_SRC}:${TIME_SRC}:${DURATION_SRC}:${SCRIPT_DIR}" \
        -d "${BUILD_DIR}" \
        "${SCRIPT_DIR}/Sayable.java" 2>&1
fi

# Run
java -cp "${BUILD_DIR}" Sayable "$@"
