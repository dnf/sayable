#!/usr/bin/env bash
# Sayable CLI wrapper for Common Lisp (SBCL).
# Loads all four component libraries and runs the CLI.
# --end-runtime-options and --end-toplevel-options keep SBCL from reading the
# CLI's own arguments (such as --version or --help) as its options.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"

exec sbcl --noinform --end-runtime-options \
  --non-interactive --disable-debugger \
  --load "${PROJECT_ROOT}/age/impl/lisp/package.lisp" \
  --load "${PROJECT_ROOT}/age/impl/lisp/types.lisp" \
  --load "${PROJECT_ROOT}/age/impl/lisp/formatter.lisp" \
  --load "${PROJECT_ROOT}/age/impl/lisp/load-locales.lisp" \
  --load "${PROJECT_ROOT}/date/impl/lisp/package.lisp" \
  --load "${PROJECT_ROOT}/date/impl/lisp/types.lisp" \
  --load "${PROJECT_ROOT}/date/impl/lisp/formatter.lisp" \
  --load "${PROJECT_ROOT}/date/impl/lisp/load-locales.lisp" \
  --load "${PROJECT_ROOT}/duration/impl/lisp/package.lisp" \
  --load "${PROJECT_ROOT}/duration/impl/lisp/types.lisp" \
  --load "${PROJECT_ROOT}/duration/impl/lisp/formatter.lisp" \
  --load "${PROJECT_ROOT}/duration/impl/lisp/load-locales.lisp" \
  --load "${PROJECT_ROOT}/time/impl/lisp/package.lisp" \
  --load "${PROJECT_ROOT}/time/impl/lisp/types.lisp" \
  --load "${PROJECT_ROOT}/time/impl/lisp/formatter.lisp" \
  --load "${PROJECT_ROOT}/time/impl/lisp/load-locales.lisp" \
  --load "${SCRIPT_DIR}/main.lisp" \
  --end-toplevel-options "$@"
