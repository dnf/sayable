cabal-version: 2.4
name:          sayable-cli
version:       0.5.0.0
license:       MIT
build-type:    Simple

executable sayable-cli
  main-is:          Main.hs
  build-depends:
      base >= 4.16 && < 5
    , sayable-age
    , sayable-date
    , sayable-time
    , sayable-duration
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -O2
