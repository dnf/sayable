    print(result)


def cmd_locales():
    # Use age locales as the canonical list (all components share the same set)
    codes = []
    import sayable_age.locales as age_locales
    for name in sorted(dir(age_locales)):
        obj = getattr(age_locales, name)
        if hasattr(obj, "code") and isinstance(obj.code, str):
            codes.append(obj.code)
    for code in sorted(set(codes)):
        print(code)


COMMANDS = {
    "age": cmd_age,
    "stage": cmd_stage,
    "date": cmd_date,
    "relative": cmd_relative,
    "time": cmd_time,
    "duration": cmd_duration,
    "since": cmd_since,
    "until": cmd_until,
}


def main():
    command, positionals, options = parse_args(sys.argv[1:])

    if command is None:
        print(HELP)
        sys.exit(2)

    if command == "help":
        print(HELP)
        sys.exit(0)

    if command == "version":
        print(f"sayable {VERSION}")
        sys.exit(0)

    if command == "locales":
        cmd_locales()
        sys.exit(0)

    if command not in COMMANDS:
        error(f"unknown command '{command}'")

    COMMANDS[command](positionals, options)


if __name__ == "__main__":
    main()
