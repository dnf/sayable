def cmd_duration(positionals, options):
    if not positionals:
        error("duration requires a value argument")
    value = nullify(positionals[0])

    locale_code = options["locale"]
    locale = get_duration_locale(locale_code)
    if locale is None:
        error(f"unknown locale '{locale_code}'")

    formatter = SayableDuration(locale, compactness=options["compactness"])

    if value is None:
        result = formatter.format_duration(None)
    elif value.lstrip("-").isdigit():
        result = formatter.format_duration(int(value))
    else:
        # Timestamp mode: need an end argument
        if len(positionals) < 2:
            error("duration with timestamps requires start and end arguments")
        end = nullify(positionals[1])
        result = formatter.format_duration(value, end)

    if result is None:
        sys.exit(1)
    print(result)


