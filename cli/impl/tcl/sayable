}

proc cmd_locales {} {
    # Use age locales as the canonical list (all components share the same set)
    ::sayableage::_ensure_registry
    set codes {}
    dict for {code _} $::_sayableage_registry {
        lappend codes $code
    }
    return [join [lsort $codes] "\n"]
}

# Run one request; returns {exit-code stdout-text}. The Tcl libraries signal
# a null result with "", so empty text always means "print nothing".
proc dispatch {argv} {
    global VERSION HELP

    lassign [parse_args $argv] command positionals options

    switch -- $command {
        ""        { return [list 2 $HELP] }
        help      { return [list 0 $HELP] }
        version   { return [list 0 "sayable $VERSION"] }
        locales   { return [list 0 [cmd_locales]] }
        age       { set result [cmd_age $positionals $options] }
        stage     { set result [cmd_stage $positionals $options] }
        date      { set result [cmd_date $positionals $options] }
        relative  { set result [cmd_relative $positionals $options] }
        time      { set result [cmd_time $positionals $options] }
        duration  { set result [cmd_duration $positionals $options] }
        since     { set result [cmd_since $positionals $options] }
        until     { set result [cmd_until $positionals $options] }
        default   { cli_error "unknown command '$command'" }
    }
    return [list [expr {$result eq "" ? 1 : 0}] $result]
}

proc run {argv} {
    try {
        return [dispatch $argv]
    } trap {SAYABLE USAGE} {msg} {
        puts stderr "error: $msg"
        puts stderr "Run 'sayable help' for usage."
        return [list 2 ""]
    }
}

# Answer one tab-separated request per stdin line (see cli/SPEC.md).
proc repl {} {
    fconfigure stdin -encoding utf-8 -translation auto
    fconfigure stdout -encoding utf-8 -translation lf -buffering line
    while {[gets stdin line] >= 0} {
        try {
            lassign [run [split $line "\t"]] code output
        } on error {msg opts} {
            # A crash exits non-zero in one-shot mode; report it and keep serving.
            puts stderr [dict get $opts -errorinfo]
            lassign [list 1 ""] code output
        }
        set flattened [string map {"\n" "\t"} [string trimright $output "\n"]]
        puts "$code\t$flattened"
        flush stdout
    }
}

proc main {} {
    global argv

    if {$argv eq [list --repl]} {
        repl
        exit 0
    }

    lassign [run $argv] code output
    if {$output ne ""} {
        puts $output
    }
    exit $code
}

main
