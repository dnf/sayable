proc cmd_duration {positionals options} {
    if {[llength $positionals] == 0} {
        cli_error "duration requires a value argument"
    }
    set value [nullify [lindex $positionals 0]]

    set locale_code [dict get $options locale]
    set locale [::sayableduration::get_locale $locale_code]
    if {$locale eq ""} {
        cli_error "unknown locale '$locale_code'"
    }

    set compactness [dict get $options compactness]
    set formatter [::sayableduration::new $locale $compactness]

    if {[is_null $value]} {
        set result [::sayableduration::format_duration $formatter ""]
    } elseif {[regexp {^-?[0-9]+$} $value]} {
        set result [::sayableduration::format_duration $formatter $value]
    } else {
        # Timestamp mode: need end argument
        if {[llength $positionals] < 2} {
            cli_error "duration with timestamps requires start and end arguments"
        }
        set end_val [nullify [lindex $positionals 1]]
        if {[is_null $end_val]} {
            set result [::sayableduration::format_duration $formatter $value ""]
        } else {
            set result [::sayableduration::format_duration $formatter $value $end_val]
        }
    }

    return $result
}

