#!/usr/bin/env bash
set -euo pipefail

# Resolve the directory this script lives in
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"

# Create symlinks with unique names so SPM can distinguish the four
# component packages (they all live in directories named "swift").
DEPS_DIR="${SCRIPT_DIR}/.deps"
mkdir -p "${DEPS_DIR}"
for pkg in SayableAge:age SayableDate:date SayableTime:time SayableDuration:duration; do
    name="${pkg%%:*}"
    component="${pkg##*:}"
    target="${PROJECT_ROOT}/${component}/impl/swift"
    link="${DEPS_DIR}/${name}"
    if [[ ! -L "${link}" ]]; then
        ln -s "${target}" "${link}"
    fi
done

# Build if needed (check if binary exists and is newer than source)
BUILD_DIR="${SCRIPT_DIR}/.build/release"
BINARY="${BUILD_DIR}/SayableCli"

needs_build() {
    [[ ! -f "${BINARY}" ]] && return 0
    [[ "${SCRIPT_DIR}/Package.swift" -nt "${BINARY}" ]] && return 0
    [[ "${SCRIPT_DIR}/Sources/SayableCli/main.swift" -nt "${BINARY}" ]] && return 0
    return 1
}

if needs_build; then
    swift build -c release --package-path "${SCRIPT_DIR}" 2>/dev/null
fi

exec "${BINARY}" "$@"
