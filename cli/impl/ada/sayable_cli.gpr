project Sayable_CLI is

   for Source_Dirs use
     (".",
      "../../../age/impl/ada/src",
      "../../../age/impl/ada/src/locales",
      "../../../date/impl/ada/src",
      "../../../date/impl/ada/src/locales",
      "../../../time/impl/ada/src",
      "../../../time/impl/ada/src/locales",
      "../../../duration/impl/ada/src",
      "../../../duration/impl/ada/src/locales");

   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");

   package Naming is
      --  Age component: files named sayableage* but packages named parenttime*
      for Spec ("Parenttime_Types") use "sayableage_types.ads";
      for Spec ("Parenttime") use "sayableage.ads";
      for Body ("Parenttime") use "sayableage.adb";
      for Spec ("Parenttime_Locales") use "sayableage_locales.ads";
      for Body ("Parenttime_Locales") use "sayableage_locales.adb";
   end Naming;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2012", "-O2");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use
        ("-L" & external ("SDK_LIB", ""));
   end Linker;

end Sayable_CLI;
