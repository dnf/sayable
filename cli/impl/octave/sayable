% ===== MAIN SCRIPT =====

VERSION = '0.5.0';

HELP_TEXT = strjoin({
  'Usage: sayable <command> [arguments] [options]', ...
  '', ...
  'Commands:', ...
  '  age <dob>              Format an age', ...
  '  stage <dob>            Get developmental stage', ...
  '  date <date>            Format a calendar date', ...
  '  relative <date>        Format a relative date', ...
  '  time <time>            Format a clock time', ...
  '  duration <value> [end] Format a duration', ...
  '  since <start>          Format elapsed time', ...
  '  until <target>         Format remaining time', ...
  '  locales                List available locale codes', ...
  '  version                Show version', ...
  '  help                   Show this help', ...
  '', ...
  'Options:', ...
  '  -l, --locale <code>    Locale code (default: en)', ...
  '  -d, --as-of <value>    Reference date/timestamp', ...
  '      --short            Short compactness', ...
  '      --compact          Compact compactness', ...
  '  -g, --gender <m|f>     Gender for stage labels', ...
  '      --with-year        Include year (date only)', ...
  '  -h, --help             Show this help', ...
  '  -v, --version          Show version'}, '\n');

% Resolve project root from this script's location
script_path = mfilename('fullpath');
if (isempty(script_path))
  script_dir = '.';
else
  script_dir = fileparts(script_path);
endif
project_root = fullfile(script_dir, '..', '..', '..');

% Add all component source directories to the path
addpath(fullfile(project_root, 'age', 'impl', 'octave'));
addpath(fullfile(project_root, 'age', 'impl', 'octave', 'locales'));
addpath(fullfile(project_root, 'date', 'impl', 'octave'));
addpath(fullfile(project_root, 'date', 'impl', 'octave', 'locales'));
addpath(fullfile(project_root, 'duration', 'impl', 'octave'));
addpath(fullfile(project_root, 'duration', 'impl', 'octave', 'locales'));
addpath(fullfile(project_root, 'time', 'impl', 'octave'));
addpath(fullfile(project_root, 'time', 'impl', 'octave', 'locales'));

% Parse command line arguments
args = argv();
[command, positionals, options] = parse_cli_args(args);

if (isempty(command))
  fprintf(stdout, '%s\n', HELP_TEXT);
  exit(2);
endif

if (strcmp(command, 'help'))
  fprintf(stdout, '%s\n', HELP_TEXT);
  exit(0);
endif

if (strcmp(command, 'version'))
  fprintf(stdout, 'sayable %s\n', VERSION);
  exit(0);
endif

if (strcmp(command, 'locales'))
  cmd_locales();
  exit(0);
endif

if (strcmp(command, 'age'))
  cmd_age(positionals, options);
elseif (strcmp(command, 'stage'))
  cmd_stage(positionals, options);
elseif (strcmp(command, 'date'))
  cmd_date(positionals, options);
elseif (strcmp(command, 'relative'))
  cmd_relative(positionals, options);
elseif (strcmp(command, 'time'))
  cmd_time(positionals, options);
elseif (strcmp(command, 'duration'))
  cmd_duration(positionals, options);
elseif (strcmp(command, 'since'))
  cmd_since(positionals, options);
elseif (strcmp(command, 'until'))
  cmd_until(positionals, options);
else
  cli_error(sprintf("unknown command '%s'", command));
endif
