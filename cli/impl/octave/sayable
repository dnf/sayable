% Run one command as the one-shot CLI would, without printing or exiting.
% output is [] when the run prints nothing to stdout.
function [code, output] = run_command(args)
  try
    [code, output] = dispatch(args);
  catch err
    if (!strcmp(err.identifier, usage_error_id()))
      rethrow(err);
    endif
    code = 2;
    output = [];
  end_try_catch
endfunction

function [code, output] = dispatch(args)
  [command, positionals, options] = parse_cli_args(args);

  code = 0;
  if (isempty(command))
    code = 2;
    output = help_text();
  elseif (strcmp(command, 'help'))
    output = help_text();
  elseif (strcmp(command, 'version'))
    output = sprintf('sayable %s', cli_version());
  elseif (strcmp(command, 'locales'))
    output = cmd_locales();
  else
    output = run_formatter(command, positionals, options);
    if (isempty(output))
      code = 1;
    endif
  endif
endfunction

function result = run_formatter(command, positionals, options)
  switch (command)
    case 'age'
      result = cmd_age(positionals, options);
    case 'stage'
      result = cmd_stage(positionals, options);
    case 'date'
      result = cmd_date(positionals, options);
    case 'relative'
      result = cmd_relative(positionals, options);
    case 'time'
      result = cmd_time(positionals, options);
    case 'duration'
      result = cmd_duration(positionals, options);
    case 'since'
      result = cmd_since(positionals, options);
    case 'until'
      result = cmd_until(positionals, options);
    otherwise
      cli_error(sprintf("unknown command '%s'", command));
  endswitch
endfunction

function line = format_response(code, output)
  text = '';
  if (!isempty(output))
    text = strrep(regexprep(output, '\n+$', ''), "\n", "\t");
  endif
  line = sprintf('%d\t%s\n', code, text);
endfunction

% Read one line from stdin without its newline, or return -1 at end of input.
% fgetl would peek past the newline, blocking until the next request arrives,
% so the line is read a byte at a time.
function line = read_request(fid)
  newline_byte = uint8(10);
  bytes = zeros(1, 0, 'uint8');
  byte = fread(fid, 1, 'uint8=>uint8');
  if (isempty(byte))
    line = -1;
    return;
  endif
  while (!isempty(byte) && byte != newline_byte)
    bytes(end + 1) = byte;
    byte = fread(fid, 1, 'uint8=>uint8');
  endwhile
  line = regexprep(char(bytes), '\r$', '');
endfunction

% Answer one tab-separated request per stdin line (see cli/SPEC.md).
function repl()
  line = read_request(stdin);
  while (ischar(line))
    try
      [code, output] = run_command(strsplit(line, "\t", 'CollapseDelimiters', false));
    catch err
      % A crash exits 1 in one-shot mode; keep serving.
      fprintf(stderr, 'error: %s\n', err.message);
      code = 1;
      output = [];
    end_try_catch
    fputs(stdout, format_response(code, output));
    fflush(stdout);
    line = read_request(stdin);
  endwhile
endfunction

