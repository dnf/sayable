#!/usr/bin/env -S octave --no-gui
% Sayable CLI — unified command-line interface to all four Sayable components.
%
% See cli/SPEC.md for the full specification.

% Suppress warnings from component files that shadow Octave built-ins
% (is_leap_year.m, version.m in the age/date/duration implementations)
warning('off', 'Octave:shadowed-function');

% --- All function definitions must precede the main script code in Octave ---

function result = nullify(value)
  if (strcmp(value, 'null'))
    result = [];
  else
    result = value;
  endif
endfunction

% A usage error is raised with this identifier once its message is on stderr,
% so run_command can answer exit 2 without ending the process.
function id = usage_error_id()
  id = 'sayable:usage';
endfunction

function cli_error(msg)
  fprintf(stderr, 'error: %s\n', msg);
  fprintf(stderr, "Run 'sayable help' for usage.\n");
  error(usage_error_id(), '%s', msg);
endfunction

function today_str = get_today()
  v = clock();
  today_str = sprintf('%04d-%02d-%02d', floor(v(1)), floor(v(2)), floor(v(3)));
endfunction

function result = is_integer_string(s)
  if (isempty(s))
    result = false;
    return;
  endif
  if (s(1) == '-')
    digits = s(2:end);
  else
    digits = s;
  endif
  if (isempty(digits))
    result = false;
    return;
  endif
  result = all(digits >= '0' & digits <= '9');
endfunction

function [command, positionals, options] = parse_cli_args(args)
  if (length(args) == 0)
    command = '';
    positionals = {};
    options = struct();
    return;
  endif

  first = args{1};
  if (strcmp(first, '-h') || strcmp(first, '--help') || strcmp(first, 'help'))
    command = 'help';
    positionals = {};
    options = struct();
    return;
  endif
  if (strcmp(first, '-v') || strcmp(first, '--version') || strcmp(first, 'version'))
    command = 'version';
    positionals = {};
    options = struct();
    return;
  endif

  command = first;
  positionals = {};
  options.locale = 'en';
  options.as_of = '';
  options.compactness = 'normal';
  options.gender = '';
  options.with_year = false;

  i = 2;
  stop_opts = false;
  while (i <= length(args))
    a = args{i};

    if (strcmp(a, '--') && !stop_opts)
      stop_opts = true;
      i = i + 1;
      continue;
    endif

    if (!stop_opts && length(a) > 0 && a(1) == '-')
      if (strcmp(a, '-l') || strcmp(a, '--locale'))
        if (i + 1 > length(args))
          cli_error(sprintf("'%s' requires a value", a));
        endif
        i = i + 1;
        options.locale = args{i};
      elseif (strcmp(a, '-d') || strcmp(a, '--as-of'))
        if (i + 1 > length(args))
          cli_error(sprintf("'%s' requires a value", a));
        endif
        i = i + 1;
        options.as_of = args{i};
      elseif (strcmp(a, '-g') || strcmp(a, '--gender'))
        if (i + 1 > length(args))
          cli_error(sprintf("'%s' requires a value", a));
        endif
        i = i + 1;
        options.gender = args{i};
      elseif (strcmp(a, '--short'))
        options.compactness = 'short';
      elseif (strcmp(a, '--compact'))
        options.compactness = 'compact';
      elseif (strcmp(a, '--with-year'))
        options.with_year = true;
      elseif (strcmp(a, '-h') || strcmp(a, '--help'))
        command = 'help';
        positionals = {};
        options = struct();
        return;
      elseif (strcmp(a, '-v') || strcmp(a, '--version'))
        command = 'version';
        positionals = {};
        options = struct();
        return;
      else
        cli_error(sprintf("unknown option '%s'", a));
      endif
    else
      positionals{end + 1} = a;
    endif

    i = i + 1;
  endwhile
endfunction

function result = cmd_age(positionals, options)
  if (length(positionals) == 0)
    cli_error('age requires a date-of-birth argument');
  endif
  dob = nullify(positionals{1});

  locale_code = options.locale;
  loc = get_age_locale(locale_code);
  if (isempty(loc))
    cli_error(sprintf("unknown locale '%s'", locale_code));
  endif

  as_of = options.as_of;
  if (!isempty(as_of))
    as_of = nullify(as_of);
  else
    as_of = get_today();
  endif

  formatter = sayable_age_new(loc, options.compactness);
  result = formatter.format_age(dob, as_of);

endfunction

