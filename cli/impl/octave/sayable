function result = cmd_duration(positionals, options)
  if (length(positionals) == 0)
    cli_error('duration requires a value argument');
  endif
  value = nullify(positionals{1});

  locale_code = options.locale;
  loc = get_duration_locale(locale_code);
  if (isempty(loc))
    cli_error(sprintf("unknown locale '%s'", locale_code));
  endif

  formatter = sayable_duration_new(loc, options.compactness);

  if (strcmp(positionals{1}, 'null'))
    result = formatter.format_duration([], '');
  elseif (is_integer_string(value))
    result = formatter.format_duration(str2double(value), '');
  else
    if (length(positionals) < 2)
      cli_error('duration with timestamps requires start and end arguments');
    endif
    end_val = nullify(positionals{2});
    result = formatter.format_duration(value, end_val);
  endif

endfunction

