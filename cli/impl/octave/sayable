  loc = get_date_locale(locale_code);
  if (isempty(loc))
    cli_error(sprintf("unknown locale '%s'", locale_code));
  endif

  formatter = sayable_date_new(loc, options.compactness);

  if (options.with_year)
    result = formatter.format_date_with_year(date_val);
  else
    result = formatter.format_date(date_val);
  endif

  if (isempty(result))
    exit(1);
  endif
  fprintf(stdout, '%s\n', result);
endfunction

