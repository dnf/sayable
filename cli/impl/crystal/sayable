#!/usr/bin/env bash
# Sayable CLI wrapper for Crystal — compiles if needed, then runs.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SOURCE="${SCRIPT_DIR}/main.cr"
BINARY="${SCRIPT_DIR}/sayable-crystal"

# Recompile if binary is missing or source is newer
if [[ ! -f "${BINARY}" ]] || [[ "${SOURCE}" -nt "${BINARY}" ]]; then
    crystal build "${SOURCE}" -o "${BINARY}" --no-debug 2>&1
fi

exec "${BINARY}" "$@"
