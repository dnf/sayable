use v6.d;
use Test;
use lib 'lib';
use SayableAge;
use SayableAge::Formatter;
use SayableAge::Locales::Registry;
use SayableAge::Locale;

# All tests use explicit (dob, as-of) pairs for determinism.

# ================================================================
# Null / edge cases
# ================================================================
# 1.1
ok !defined(SayableAge::format-age(Str, '2025-06-15')), '1.1 nil input';
# 1.3
ok !defined(SayableAge::format-age('', '2025-06-15')), '1.3 empty string';
# 1.4
ok !defined(SayableAge::format-age('2025-07-01', '2025-06-15')), '1.4 future dob';
# 1.5
is SayableAge::format-age('1525-06-15', '2025-06-15'), '500 years', '1.5 exactly 500 years';
# 1.6
ok !defined(SayableAge::format-age('1524-06-15', '2025-06-15')), '1.6 501 years exceeds max';
# 1.7
ok !defined(SayableAge::format-age('1025-06-15', '2025-06-15')), '1.7 1000 years exceeds max';

# ================================================================
# Days tier: 0-6 days
# ================================================================
# 2.1
is SayableAge::format-age('2025-06-15', '2025-06-15'), 'Newborn', '2.1 born today';
# 2.2
is SayableAge::format-age('2025-06-14', '2025-06-15'), '1 day', '2.2 1 day';
# 2.3
is SayableAge::format-age('2025-06-12', '2025-06-15'), '3 days', '2.3 3 days';
# 2.4
is SayableAge::format-age('2025-06-09', '2025-06-15'), '6 days', '2.4 6 days';
# 2.5
is SayableAge::format-age('2025-06-08', '2025-06-15'), '1 week', '2.5 7 days becomes 1 week';

# ================================================================
# Weeks+days tier: 7 days to <3 months
# ================================================================
# 3.1
is SayableAge::format-age('2025-06-08', '2025-06-15'), '1 week', '3.1 7 days';
# 3.2
is SayableAge::format-age('2025-06-07', '2025-06-15'), '1 week, 1 day', '3.2 8 days';
# 3.3
is SayableAge::format-age('2025-06-06', '2025-06-15'), '1 week, 2 days', '3.3 9 days';
# 3.4
is SayableAge::format-age('2025-06-02', '2025-06-15'), '1 week, 6 days', '3.4 13 days';
# 3.5
is SayableAge::format-age('2025-06-01', '2025-06-15'), '2 weeks', '3.5 14 days';
# 3.6
is SayableAge::format-age('2025-05-31', '2025-06-15'), '2 weeks, 1 day', '3.6 15 days';
# 3.7
is SayableAge::format-age('2025-05-26', '2025-06-15'), '2 weeks, 6 days', '3.7 20 days';
# 3.8
is SayableAge::format-age('2025-05-25', '2025-06-15'), '3 weeks', '3.8 21 days';
# 3.9
is SayableAge::format-age('2025-05-15', '2025-06-15'), '4 weeks, 3 days', '3.9 at 1 cal month still weeks';
# 3.10
is SayableAge::format-age('2025-04-15', '2025-06-15'), '8 weeks, 5 days', '3.10 at 2 cal months still weeks';
# 3.11
is SayableAge::format-age('2025-03-15', '2025-06-14'), '13 weeks', '3.11 one day before 3mo';
# 3.12
is SayableAge::format-age('2025-03-15', '2025-06-15'), '3 months', '3.12 on 3mo birthday switches';

# ================================================================
# Month boundaries: standard months
# ================================================================
# 4.1
is SayableAge::format-age('2025-01-01', '2025-04-01'), '3 months', '4.1 jan1-apr1';
# 4.2
like SayableAge::format-age('2025-01-01', '2025-03-31'), rx/^ \d+ ' weeks' [', ' \d+ ' day' 's'?]? $/, '4.2 jan1-mar31 still weeks';
# 4.3
is SayableAge::format-age('2025-06-15', '2025-09-15'), '3 months', '4.3 jun15-sep15';
# 4.4
like SayableAge::format-age('2025-06-15', '2025-09-14'), rx/^ \d+ ' weeks' [', ' \d+ ' day' 's'?]? $/, '4.4 jun15-sep14 still weeks';
# 4.5
is SayableAge::format-age('2025-06-15', '2025-12-15'), '6 months', '4.5 jun15-dec15';

# ================================================================
# Month boundaries: February non-leap
# ================================================================
# 5.1
is SayableAge::format-age('2025-01-31', '2025-02-28'), '4 weeks', '5.1 jan31-feb28 non-leap';
# 5.2
is SayableAge::format-age('2025-01-31', '2025-04-30'), '3 months', '5.2 jan31-apr30 clamped';
# 5.3
like SayableAge::format-age('2025-01-31', '2025-04-29'), rx/^ \d+ ' weeks' [', ' \d+ ' day' 's'?]? $/, '5.3 jan31-apr29 still weeks';
# 5.4
is SayableAge::format-age('2025-02-01', '2025-05-01'), '3 months', '5.4 feb1-may1';
# 5.5
like SayableAge::format-age('2025-02-01', '2025-04-30'), rx/^ \d+ ' weeks' [', ' \d+ ' day' 's'?]? $/, '5.5 feb1-apr30 still weeks';

# ================================================================
# Month boundaries: February leap year
# ================================================================
# 6.1
is SayableAge::format-age('2024-01-31', '2024-02-29'), '4 weeks, 1 day', '6.1 jan31-feb29 leap';
# 6.2
is SayableAge::format-age('2024-01-31', '2024-02-28'), '4 weeks', '6.2 jan31-feb28 leap';
# 6.3
is SayableAge::format-age('2024-01-31', '2024-04-30'), '3 months', '6.3 jan31-apr30 leap';
# 6.4
like SayableAge::format-age('2024-01-30', '2024-02-29'), rx/^ \d+ ' weeks' [', ' \d+ ' day' 's'?]? $/, '6.4 jan30-feb29 leap still weeks';
# 6.5
like SayableAge::format-age('2024-01-30', '2024-02-28'), rx/^ \d+ ' weeks' [', ' \d+ ' day' 's'?]? $/, '6.5 jan30-feb28 leap still weeks';

# ================================================================
# Month boundaries: 30-day months
# ================================================================
# 7.1
is SayableAge::format-age('2025-03-31', '2025-06-30'), '3 months', '7.1 mar31-jun30';
# 7.2
like SayableAge::format-age('2025-03-31', '2025-06-29'), rx/^ \d+ ' weeks' [', ' \d+ ' day' 's'?]? $/, '7.2 mar31-jun29 still weeks';
# 7.3
is SayableAge::format-age('2025-08-31', '2025-11-30'), '3 months', '7.3 aug31-nov30';
# 7.4
like SayableAge::format-age('2025-08-31', '2025-11-29'), rx/^ \d+ ' weeks' [', ' \d+ ' day' 's'?]? $/, '7.4 aug31-nov29 still weeks';

# ================================================================
# Month boundaries: leap year baby (born Feb 29)
# ================================================================
# 8.1
is SayableAge::format-age('2024-02-29', '2024-05-29'), '3 months', '8.1 feb29-may29';
# 8.2
like SayableAge::format-age('2024-02-29', '2024-05-28'), rx/^ \d+ ' weeks' [', ' \d+ ' day' 's'?]? $/, '8.2 feb29-may28 still weeks';
# 8.3
is SayableAge::format-age('2024-02-29', '2025-02-28'), '12 months', '8.3 feb29-feb28 next year';
# 8.4
is SayableAge::format-age('2024-02-29', '2025-03-01'), '12 months', '8.4 feb29-mar1 next year';

# ================================================================
# Months tier: 3-23 months
# ================================================================
# 9.1
is SayableAge::format-age('2025-01-15', '2025-04-15'), '3 months', '9.1 3 months at transition';
# 9.2
is SayableAge::format-age('2025-01-15', '2025-07-15'), '6 months', '9.2 6 months';
# 9.3
is SayableAge::format-age('2024-06-15', '2025-06-15'), '12 months', '9.3 12 months not 1 year';
# 9.4
is SayableAge::format-age('2024-01-15', '2025-12-15'), '23 months', '9.4 23 months upper boundary';
# 9.5
is SayableAge::format-age('2025-01-15', '2025-07-14'), '5 months', '9.5 one day before month boundary';
# 9.6
is SayableAge::format-age('2024-11-10', '2025-04-10'), '5 months', '9.6 crossing year boundary';

# ================================================================
# Years+months tier: 24-35 months
# ================================================================
# 10.1
is SayableAge::format-age('2023-06-15', '2025-06-15'), '2 years', '10.1 2 years at 24mo';
# 10.2
is SayableAge::format-age('2023-06-15', '2025-07-15'), '2 years, 1 month', '10.2 2y1m';
# 10.3
is SayableAge::format-age('2023-06-15', '2025-12-15'), '2 years, 6 months', '10.3 2y6m';
# 10.4
is SayableAge::format-age('2023-06-15', '2026-05-15'), '2 years, 11 months', '10.4 2y11m';
# 10.5
is SayableAge::format-age('2023-06-15', '2025-06-14'), '23 months', '10.5 one day before 24mo';

# ================================================================
# Half-year tier: 3-6 years
# ================================================================
# 11.1
is SayableAge::format-age('2022-06-15', '2025-06-15'), '3 years', '11.1 3 years exactly';
# 11.2
is SayableAge::format-age('2022-06-15', '2025-11-15'), '3 years', '11.2 3y5m';
# 11.3
is SayableAge::format-age('2022-06-15', '2025-12-15'), '3½ years', '11.3 3.5y at 3y6m';
# 11.4
is SayableAge::format-age('2022-06-15', '2026-05-15'), '3½ years', '11.4 3.5y at 3y11m';
# 11.5
is SayableAge::format-age('2021-06-15', '2025-06-15'), '4 years', '11.5 4 years';
# 11.6
is SayableAge::format-age('2021-06-15', '2025-12-15'), '4½ years', '11.6 4.5y';
# 11.7
is SayableAge::format-age('2020-06-15', '2025-06-15'), '5 years', '11.7 5 years';
# 11.8
is SayableAge::format-age('2020-06-15', '2026-02-15'), '5½ years', '11.8 5.5y at 5y8m';
# 11.9
is SayableAge::format-age('2019-06-15', '2025-06-15'), '6 years', '11.9 6 years';
# 11.10
is SayableAge::format-age('2019-06-15', '2025-12-15'), '6½ years', '11.10 6.5y';
# 11.11
is SayableAge::format-age('2019-06-15', '2026-05-15'), '6½ years', '11.11 6.5y at 6y11m';
# 11.12
is SayableAge::format-age('2022-06-15', '2025-06-14'), '2 years, 11 months', '11.12 one day before 3rd bday';

# ================================================================
# Integer tier: 7+ years
# ================================================================
# 12.1
is SayableAge::format-age('2018-06-15', '2025-06-15'), '7 years', '12.1 7 years';
# 12.2
is SayableAge::format-age('2018-03-20', '2025-06-15'), '7 years', '12.2 7y6m no half';
# 12.3
is SayableAge::format-age('1980-01-01', '2025-06-15'), '45 years', '12.3 45 years';

# ================================================================
# Cross-year transitions with Feb
# ================================================================
# 13.1
is SayableAge::format-age('2024-12-31', '2025-03-31'), '3 months', '13.1 dec31-mar31';
# 13.2
like SayableAge::format-age('2024-12-31', '2025-03-30'), rx/^ \d+ ' weeks' [', ' \d+ ' day' 's'?]? $/, '13.2 dec31-mar30 still weeks';
# 13.3
is SayableAge::format-age('2024-11-30', '2025-02-28'), '3 months', '13.3 nov30-feb28';
# 13.4
like SayableAge::format-age('2024-11-30', '2025-02-27'), rx/^ \d+ ' weeks' [', ' \d+ ' day' 's'?]? $/, '13.4 nov30-feb27 still weeks';

# ================================================================
# Born-on-31st progression
# ================================================================
# 14.1
is SayableAge::format-age('2025-01-31', '2025-04-30'), '3 months', '14.1 jan31-apr30';
# 14.2
is SayableAge::format-age('2025-01-31', '2025-05-31'), '4 months', '14.2 jan31-may31';
# 14.3
is SayableAge::format-age('2025-01-31', '2025-06-30'), '5 months', '14.3 jan31-jun30 clamped';
# 14.4
is SayableAge::format-age('2025-01-31', '2025-07-01'), '5 months', '14.4 jan31-jul1';
# 14.5
is SayableAge::format-age('2025-01-31', '2025-07-31'), '6 months', '14.5 jan31-jul31';

# ================================================================
# Default as_of (uses current date) — tests 15.1, 15.2
# The library has no way to override today, so the inputs are derived from the real date.
# ================================================================
# 15.1
is SayableAge::format-age(Date.today.earlier(years => 5).Str), '5 years', '15.1 five years before today';
# 15.2
is SayableAge::format-age(Date.today.earlier(days => 5).Str), '5 days', '15.2 five days before today';
# 23.1 to 23.3 use the real date too, so the inputs are derived from it.
# 23.1
is SayableAge::format-stage(Date.today.Str), 'Newborn', '23.1 born today';
# 23.2
is SayableAge::format-stage(Date.today.earlier(years => 5).Str), 'Child', '23.2 five years before today';
# 23.3
is SayableAge::format-stage(Date.today.earlier(years => 45).Str), 'Adult', '23.3 45 years before today';

# ================================================================
# formatStage
# ================================================================
# 16.1
ok !defined(SayableAge::format-stage(Str, '2025-06-15')), '16.1 nil returns Nil';
# 16.3
ok !defined(SayableAge::format-stage('', '2025-06-15')), '16.3 empty returns Nil';
# 16.4
ok !defined(SayableAge::format-stage('2025-07-01', '2025-06-15')), '16.4 future returns Nil';
# 16.5
is SayableAge::format-stage('1525-06-15', '2025-06-15'), 'Adult', '16.5 500y returns adult';
# 16.6
ok !defined(SayableAge::format-stage('1524-06-15', '2025-06-15')), '16.6 501y exceeds max';

# Newborn: 0-1 months
# 17.1
is SayableAge::format-stage('2025-06-15', '2025-06-15'), 'Newborn', '17.1 born today';
# 17.2
is SayableAge::format-stage('2025-06-14', '2025-06-15'), 'Newborn', '17.2 1 day';
# 17.3
is SayableAge::format-stage('2025-05-25', '2025-06-15'), 'Newborn', '17.3 3 weeks';
# 17.4
is SayableAge::format-stage('2025-05-15', '2025-06-15'), 'Newborn', '17.4 1 month';
# 17.5
is SayableAge::format-stage('2025-04-16', '2025-06-15'), 'Newborn', '17.5 1m29d';
# 17.6
is SayableAge::format-stage('2025-04-15', '2025-06-15'), 'Infant', '17.6 exactly 2 months';

# Infant: 2-11 months
# 18.1
is SayableAge::format-stage('2025-04-15', '2025-06-15'), 'Infant', '18.1 2 months';
# 18.2
is SayableAge::format-stage('2024-12-15', '2025-06-15'), 'Infant', '18.2 6 months';
# 18.3
is SayableAge::format-stage('2024-07-15', '2025-06-15'), 'Infant', '18.3 11 months';
# 18.4
is SayableAge::format-stage('2024-06-15', '2025-06-15'), 'Toddler', '18.4 exactly 12 months';

# Toddler: 12-35 months
# 19.1
is SayableAge::format-stage('2024-06-15', '2025-06-15'), 'Toddler', '19.1 12 months';
# 19.2
is SayableAge::format-stage('2024-01-15', '2025-07-15'), 'Toddler', '19.2 18 months';
# 19.3
is SayableAge::format-stage('2023-06-15', '2025-06-15'), 'Toddler', '19.3 24 months';
# 19.4
is SayableAge::format-stage('2023-06-15', '2026-05-15'), 'Toddler', '19.4 35 months';
# 19.5
is SayableAge::format-stage('2022-06-15', '2025-06-15'), 'Child', '19.5 exactly 36 months';

# Child: 36-155 months
# 20.1
is SayableAge::format-stage('2022-06-15', '2025-06-15'), 'Child', '20.1 3 years';
# 20.2
is SayableAge::format-stage('2021-06-15', '2025-06-15'), 'Child', '20.2 4 years';
# 20.3
is SayableAge::format-stage('2019-06-15', '2025-06-15'), 'Child', '20.3 6 years';
# 20.4
is SayableAge::format-stage('2016-06-15', '2025-06-15'), 'Child', '20.4 9 years';
# 20.5
is SayableAge::format-stage('2013-06-15', '2026-05-15'), 'Child', '20.5 12y11m';
# 20.6
is SayableAge::format-stage('2012-06-15', '2025-06-15'), 'Teenager', '20.6 exactly 13 years';

# Teenager: 156-215 months
# 21.1
is SayableAge::format-stage('2012-06-15', '2025-06-15'), 'Teenager', '21.1 13 years';
# 21.2
is SayableAge::format-stage('2010-06-15', '2025-06-15'), 'Teenager', '21.2 15 years';
# 21.3
is SayableAge::format-stage('2008-06-15', '2026-05-15'), 'Teenager', '21.3 17y11m';
# 21.4
is SayableAge::format-stage('2007-06-15', '2025-06-15'), 'Adult', '21.4 exactly 18 years';

# Adult: 216+ months
# 22.1
is SayableAge::format-stage('2007-06-15', '2025-06-15'), 'Adult', '22.1 18 years';
# 22.2
is SayableAge::format-stage('2000-06-15', '2025-06-15'), 'Adult', '22.2 25 years';
# 22.3
is SayableAge::format-stage('1980-01-01', '2025-06-15'), 'Adult', '22.3 45 years';

# ================================================================
# SayableAge::Formatter class
# ================================================================
{
    my %en = SayableAge::Locales::Registry::get-locale('en');
    my $pt = SayableAge::Formatter.new(%en);
    # 24.1, 24.2, 24.3, 24.4, 24.5, 24.6, 24.7
    is $pt.format-age('2025-06-15', '2025-06-15'), 'Newborn', '24.1';
    is $pt.format-age('2025-06-12', '2025-06-15'), '3 days', '24.2';
    is $pt.format-age('2025-06-07', '2025-06-15'), '1 week, 1 day', '24.3';
    is $pt.format-age('2025-01-15', '2025-07-15'), '6 months', '24.4';
    is $pt.format-age('2023-06-15', '2025-07-15'), '2 years, 1 month', '24.5';
    is $pt.format-age('2022-06-15', '2025-12-15'), '3½ years', '24.6';
    is $pt.format-age('2018-06-15', '2025-06-15'), '7 years', '24.7';

    # 24.8, 24.9, 24.10, 24.11, 24.12, 24.13
    is $pt.format-stage('2025-06-15', '2025-06-15'), 'Newborn', '24.8';
    is $pt.format-stage('2025-01-15', '2025-06-15'), 'Infant', '24.9';
    is $pt.format-stage('2024-06-15', '2025-06-15'), 'Toddler', '24.10';
    is $pt.format-stage('2022-06-15', '2025-06-15'), 'Child', '24.11';
    is $pt.format-stage('2012-06-15', '2025-06-15'), 'Teenager', '24.12';
    is $pt.format-stage('2007-06-15', '2025-06-15'), 'Adult', '24.13';

    # 24.14, 24.15
    ok !defined($pt.format-age(Str, '2025-06-15')), '24.14';
    ok !defined($pt.format-stage(Str, '2025-06-15')), '24.15';
    ok !defined($pt.format-age('', '2025-06-15')), '24.14b';
}

# ================================================================
# Spanish-like locale (inline)
# ================================================================
{
    my %es = (
        code => 'es',
        plural => -> $n { $n == 1 ?? 'one' !! 'other' },
        units => {
            day   => { one => '{n} día', other => '{n} días' },
            week  => { one => '{n} semana', other => '{n} semanas' },
            month => { one => '{n} mes', other => '{n} meses' },
            year  => { one => '{n} año', other => '{n} años' },
        },
        half => '{0} y medio',
        delimiter => ', ',
        just-born => 'Recién nacido',
        stages => {
            newborn  => 'Recién nacido',
            infant   => 'Bebé',
            toddler  => 'Niño pequeño',
            child    => 'Niño',
            teenager => 'Adolescente',
            adult    => 'Adulto',
        },
    );

    my $pt = SayableAge::Formatter.new(%es);

    # 25.1..25.20
    is $pt.format-age('2025-06-15', '2025-06-15'), 'Recién nacido', '25.1';
    is $pt.format-age('2025-06-14', '2025-06-15'), '1 día', '25.2';
    is $pt.format-age('2025-06-12', '2025-06-15'), '3 días', '25.3';
    is $pt.format-age('2025-06-08', '2025-06-15'), '1 semana', '25.4';
    is $pt.format-age('2025-06-07', '2025-06-15'), '1 semana, 1 día', '25.5';
    is $pt.format-age('2025-05-26', '2025-06-15'), '2 semanas, 6 días', '25.6';
    is $pt.format-age('2025-01-15', '2025-07-15'), '6 meses', '25.7';
    is $pt.format-age('2023-06-15', '2025-07-15'), '2 años, 1 mes', '25.8';
    is $pt.format-age('2023-06-15', '2025-12-15'), '2 años, 6 meses', '25.9';
    is $pt.format-age('2022-06-15', '2025-12-15'), '3 años y medio', '25.10';
    is $pt.format-age('2022-06-15', '2025-06-15'), '3 años', '25.11';
    is $pt.format-age('2018-06-15', '2025-06-15'), '7 años', '25.12';
    is $pt.format-stage('2025-06-15', '2025-06-15'), 'Recién nacido', '25.13';
    is $pt.format-stage('2025-01-15', '2025-06-15'), 'Bebé', '25.14';
    is $pt.format-stage('2024-06-15', '2025-06-15'), 'Niño pequeño', '25.15';
    is $pt.format-stage('2022-06-15', '2025-06-15'), 'Niño', '25.16';
    is $pt.format-stage('2012-06-15', '2025-06-15'), 'Adolescente', '25.17';
    is $pt.format-stage('2007-06-15', '2025-06-15'), 'Adulto', '25.18';
    ok !defined($pt.format-age(Str, '2025-06-15')), '25.19';
    ok !defined($pt.format-stage(Str, '2025-06-15')), '25.20';
}

# ================================================================
# Compactness: short
# ================================================================
{
    my %en = SayableAge::Locales::Registry::get-locale('en');
    my $pt = SayableAge::Formatter.new(%en, compactness => 'short');
    # 26.1..26.9
    is $pt.format-age('2025-06-12', '2025-06-15'), '3 d', '26.1';
    is $pt.format-age('2025-06-08', '2025-06-15'), '1 wk', '26.2';
    is $pt.format-age('2025-06-07', '2025-06-15'), '1 wk, 1 d', '26.3';
    is $pt.format-age('2025-01-15', '2025-07-15'), '6 mo', '26.4';
    is $pt.format-age('2023-06-15', '2025-07-15'), '2 yr, 1 mo', '26.5';
    is $pt.format-age('2022-06-15', '2025-12-15'), '3½ yr', '26.6';
    is $pt.format-age('2018-06-15', '2025-06-15'), '7 yr', '26.7';
    is $pt.format-age('2025-06-15', '2025-06-15'), 'Newborn', '26.8';
    is $pt.format-stage('2025-01-15', '2025-06-15'), 'Infant', '26.9';
}

# ================================================================
# Compactness: compact
# ================================================================
{
    my %en = SayableAge::Locales::Registry::get-locale('en');
    my $pt = SayableAge::Formatter.new(%en, compactness => 'compact');
    # 27.1..27.8
    is $pt.format-age('2025-06-12', '2025-06-15'), '3d', '27.1';
    is $pt.format-age('2025-06-08', '2025-06-15'), '1w', '27.2';
    is $pt.format-age('2025-06-07', '2025-06-15'), '1w1d', '27.3';
    is $pt.format-age('2025-01-15', '2025-07-15'), '6m', '27.4';
    is $pt.format-age('2023-06-15', '2025-07-15'), '2y1m', '27.5';
    is $pt.format-age('2022-06-15', '2025-12-15'), '3½y', '27.6';
    is $pt.format-age('2018-06-15', '2025-06-15'), '7y', '27.7';
    is $pt.format-age('2025-06-15', '2025-06-15'), 'Newborn', '27.8';
}

# ================================================================
# Gender support for format_stage
# ================================================================

# English stages are plain strings -- gender param is ignored
{
    my %en = SayableAge::Locales::Registry::get-locale('en');
    my $pt = SayableAge::Formatter.new(%en);
    is $pt.format-stage('2025-06-15', '2025-06-15', gender => 'm'), 'Newborn', '28.1 en gender m';
    is $pt.format-stage('2025-06-15', '2025-06-15', gender => 'f'), 'Newborn', '28.2 en gender f';
    is $pt.format-stage('2025-06-15', '2025-06-15'), 'Newborn', '28.3 en gender nil';
    is $pt.format-stage('2007-06-15', '2025-06-15', gender => 'f'), 'Adult', '28.4 en adult gender f';
}

# Spanish: gendered stages
{
    my %es = SayableAge::Locales::Registry::get-locale('es');
    is SayableAge::Formatter.new(%es).format-stage('2025-06-15', '2025-06-15'), 'Recién nacido', '28.5 es newborn default';
    is SayableAge::Formatter.new(%es).format-stage('2025-06-15', '2025-06-15', gender => 'm'), 'Recién nacido', '28.6 es newborn m';
    is SayableAge::Formatter.new(%es).format-stage('2025-06-15', '2025-06-15', gender => 'f'), 'Recién nacida', '28.7 es newborn f';
    is SayableAge::Formatter.new(%es).format-stage('2025-01-15', '2025-06-15', gender => 'f'), 'Bebé', '28.8 es infant f';
    is SayableAge::Formatter.new(%es).format-stage('2025-01-15', '2025-06-15', gender => 'm'), 'Bebé', '28.9 es infant m';
    is SayableAge::Formatter.new(%es).format-stage('2024-06-15', '2025-06-15', gender => 'm'), 'Niño pequeño', '28.10 es toddler m';
    is SayableAge::Formatter.new(%es).format-stage('2024-06-15', '2025-06-15', gender => 'f'), 'Niña pequeña', '28.11 es toddler f';
    is SayableAge::Formatter.new(%es).format-stage('2022-06-15', '2025-06-15', gender => 'm'), 'Niño', '28.12 es child m';
    is SayableAge::Formatter.new(%es).format-stage('2022-06-15', '2025-06-15', gender => 'f'), 'Niña', '28.13 es child f';
    is SayableAge::Formatter.new(%es).format-stage('2012-06-15', '2025-06-15', gender => 'f'), 'Adolescente', '28.14 es teenager f';
    is SayableAge::Formatter.new(%es).format-stage('2007-06-15', '2025-06-15', gender => 'm'), 'Adulto', '28.15 es adult m';
    is SayableAge::Formatter.new(%es).format-stage('2007-06-15', '2025-06-15', gender => 'f'), 'Adulta', '28.16 es adult f';
}

# Arabic: all 6 stages are gendered
{
    my %ar = SayableAge::Locales::Registry::get-locale('ar');
    my $pt = SayableAge::Formatter.new(%ar);
    is $pt.format-stage('2025-06-15', '2025-06-15', gender => 'm'), 'حديث الولادة', '28.17 ar newborn m';
    is $pt.format-stage('2025-06-15', '2025-06-15', gender => 'f'), 'حديثة الولادة', '28.18 ar newborn f';
    is $pt.format-stage('2025-01-15', '2025-06-15', gender => 'm'), 'رضيع', '28.19 ar infant m';
    is $pt.format-stage('2025-01-15', '2025-06-15', gender => 'f'), 'رضيعة', '28.20 ar infant f';
    is $pt.format-stage('2024-06-15', '2025-06-15', gender => 'm'), 'طفل صغير', '28.21 ar toddler m';
    is $pt.format-stage('2024-06-15', '2025-06-15', gender => 'f'), 'طفلة صغيرة', '28.22 ar toddler f';
    is $pt.format-stage('2022-06-15', '2025-06-15', gender => 'm'), 'طفل', '28.23 ar child m';
    is $pt.format-stage('2022-06-15', '2025-06-15', gender => 'f'), 'طفلة', '28.24 ar child f';
    is $pt.format-stage('2012-06-15', '2025-06-15', gender => 'm'), 'مراهق', '28.25 ar teenager m';
    is $pt.format-stage('2012-06-15', '2025-06-15', gender => 'f'), 'مراهقة', '28.26 ar teenager f';
    is $pt.format-stage('2007-06-15', '2025-06-15', gender => 'm'), 'بالغ', '28.27 ar adult m';
    is $pt.format-stage('2007-06-15', '2025-06-15', gender => 'f'), 'بالغة', '28.28 ar adult f';
}

# German: only adult is gendered
{
    my %de = SayableAge::Locales::Registry::get-locale('de');
    my $pt = SayableAge::Formatter.new(%de);
    is $pt.format-stage('2007-06-15', '2025-06-15', gender => 'm'), 'Erwachsener', '28.29 de adult m';
    is $pt.format-stage('2007-06-15', '2025-06-15', gender => 'f'), 'Erwachsene', '28.30 de adult f';
    is $pt.format-stage('2007-06-15', '2025-06-15'), 'Erwachsener', '28.31 de adult default';
}

# French: gendered stages
{
    my %fr = SayableAge::Locales::Registry::get-locale('fr');
    my $pt = SayableAge::Formatter.new(%fr);
    is $pt.format-stage('2025-06-15', '2025-06-15', gender => 'm'), 'Nouveau-né', '28.32 fr newborn m';
    is $pt.format-stage('2025-06-15', '2025-06-15', gender => 'f'), 'Nouveau-née', '28.33 fr newborn f';
    is $pt.format-stage('2024-06-15', '2025-06-15'), 'Tout-petit', '28.34 fr toddler';
    is $pt.format-stage('2012-06-15', '2025-06-15', gender => 'm'), 'Adolescent', '28.35 fr teenager m';
    is $pt.format-stage('2012-06-15', '2025-06-15', gender => 'f'), 'Adolescente', '28.36 fr teenager f';
    is $pt.format-stage('2007-06-15', '2025-06-15', gender => 'f'), 'Adulte', '28.37 fr adult f';
}

# Module-level convenience with gender
is SayableAge::format-stage('2007-06-15', '2025-06-15', gender => 'f'), 'Adult', '28.38 module level gender f';
is SayableAge::format-stage('2007-06-15', '2025-06-15', gender => 'm'), 'Adult', '28.39 module level gender m';

# resolve-stage helper
is SayableAge::Locale::resolve-stage('Adult', 'm'), 'Adult', '28.40 resolve-stage string m';
is SayableAge::Locale::resolve-stage('Adult', 'f'), 'Adult', '28.41 resolve-stage string f';
is SayableAge::Locale::resolve-stage('Adult'), 'Adult', '28.42 resolve-stage string nil';

{
    my %label = m => 'Adulto', f => 'Adulta';
    is SayableAge::Locale::resolve-stage(%label, 'm'), 'Adulto', '28.43 resolve-stage hash m';
    is SayableAge::Locale::resolve-stage(%label, 'f'), 'Adulta', '28.44 resolve-stage hash f';
    is SayableAge::Locale::resolve-stage(%label), 'Adulto', '28.45 resolve-stage hash nil';
}

# Nil handling with gender
{
    my %es = SayableAge::Locales::Registry::get-locale('es');
    my $pt = SayableAge::Formatter.new(%es);
    ok !defined($pt.format-stage(Str, '2025-06-15', gender => 'f')), '28.47 nil with gender f';
    ok !defined($pt.format-stage('', '2025-06-15', gender => 'm')), '28.48 empty with gender m';
}

# ================================================================
# Section 29: Locale-specific edge cases -- new plural rules
# ================================================================

# Hebrew (he) -- dual forms
{
    my %he = SayableAge::Locales::Registry::get-locale('he');
    my $pt = SayableAge::Formatter.new(%he);
    # 29.1
    is $pt.format-age('2025-06-15', '2025-06-15'), 'רק נולד', '29.1 he just born';
    # 29.2
    is $pt.format-age('2025-06-14', '2025-06-15'), 'יום', '29.2 he one day';
    # 29.3
    is $pt.format-age('2025-06-12', '2025-06-15'), '3 ימים', '29.3 he three days';
    # 29.4
    is $pt.format-age('2025-06-01', '2025-06-15'), 'שבועיים', '29.4 he two weeks dual';
    # 29.5
    is $pt.format-age('2025-05-25', '2025-06-15'), '3 שבועות', '29.5 he three weeks';
    # 29.6
    is $pt.format-age('2025-01-15', '2025-07-15'), '6 חודשים', '29.6 he six months';
    # 29.7
    is $pt.format-age('2025-03-15', '2025-06-15'), '3 חודשים', '29.7 he three months';
    # 29.8
    is $pt.format-age('2023-06-15', '2025-07-15'), 'שנתיים, חודש', '29.8 he two years dual one month';
    # 29.9
    is $pt.format-age('2022-06-15', '2025-12-15'), '3 שנים וחצי', '29.9 he half years';
    # 29.10
    is $pt.format-age('2018-06-15', '2025-06-15'), '7 שנים', '29.10 he seven years';
    # 29.11
    is $pt.format-stage('2025-06-15', '2025-06-15', gender => 'm'), 'רק נולד', '29.11 he stage m newborn';
    # 29.12
    is $pt.format-stage('2025-06-15', '2025-06-15', gender => 'f'), 'רק נולדה', '29.12 he stage f newborn';
    # 29.13
    is $pt.format-stage('2007-06-15', '2025-06-15', gender => 'm'), 'מבוגר', '29.13 he stage m adult';
    # 29.14
    is $pt.format-stage('2007-06-15', '2025-06-15', gender => 'f'), 'מבוגרת', '29.14 he stage f adult';
}

# Macedonian (mk) -- mod10/mod100 rule
{
    my %mk = SayableAge::Locales::Registry::get-locale('mk');
    my $pt = SayableAge::Formatter.new(%mk);
    # 29.15
    is $pt.format-age('2025-06-15', '2025-06-15'), 'Новороденче', '29.15 mk just born';
    # 29.16
    is $pt.format-age('2025-06-14', '2025-06-15'), '1 ден', '29.16 mk one day';
    # 29.17
    is $pt.format-age('2025-06-12', '2025-06-15'), '3 дена', '29.17 mk three days';
    # 29.18
    is $pt.format-age('2025-01-15', '2025-07-15'), '6 месеци', '29.18 mk six months';
    # 29.19
    is $pt.format-age('2023-06-15', '2025-07-15'), '2 години, 1 месец', '29.19 mk 2y1m';
    # 29.20
    is $pt.format-age('2022-06-15', '2025-12-15'), '3 години и пол', '29.20 mk half years';
    # 29.21
    is $pt.format-age('2018-06-15', '2025-06-15'), '7 години', '29.21 mk seven years';
}

# Swahili (sw) -- noun class changes
{
    my %sw = SayableAge::Locales::Registry::get-locale('sw');
    my $pt = SayableAge::Formatter.new(%sw);
    # 29.22
    is $pt.format-age('2025-06-15', '2025-06-15'), 'Mzaliwa mpya', '29.22 sw just born';
    # 29.23
    is $pt.format-age('2025-06-14', '2025-06-15'), 'siku 1', '29.23 sw one day';
    # 29.24
    is $pt.format-age('2025-06-12', '2025-06-15'), 'siku 3', '29.24 sw three days';
    # 29.25
    is $pt.format-age('2025-01-15', '2025-07-15'), 'miezi 6', '29.25 sw six months';
    # 29.26
    is $pt.format-age('2023-06-15', '2025-07-15'), 'miaka 2, mwezi 1', '29.26 sw 2y1m';
    # 29.27
    is $pt.format-age('2022-06-15', '2025-12-15'), 'miaka 3 na nusu', '29.27 sw half years';
}

# Indonesian (id) -- other_only
{
    my %id = SayableAge::Locales::Registry::get-locale('id');
    my $pt = SayableAge::Formatter.new(%id);
    # 29.28
    is $pt.format-age('2025-06-15', '2025-06-15'), 'Baru lahir', '29.28 id just born';
    # 29.29
    is $pt.format-age('2025-06-14', '2025-06-15'), '1 hari', '29.29 id one day';
    # 29.30
    is $pt.format-age('2025-06-12', '2025-06-15'), '3 hari', '29.30 id three days';
    # 29.31
    is $pt.format-age('2025-01-15', '2025-07-15'), '6 bulan', '29.31 id six months';
    # 29.32
    is $pt.format-age('2022-06-15', '2025-12-15'), '3 setengah tahun', '29.32 id half years';
    # 29.33
    is $pt.format-age('2018-06-15', '2025-06-15'), '7 tahun', '29.33 id seven years';
}

# Amharic (am) -- Ethiopic delimiter
{
    my %am = SayableAge::Locales::Registry::get-locale('am');
    my $pt = SayableAge::Formatter.new(%am);
    # 29.34
    is $pt.format-age('2025-06-15', '2025-06-15'), 'አዲስ የተወለደ', '29.34 am just born';
    # 29.35
    is $pt.format-age('2025-06-14', '2025-06-15'), '1 ቀን', '29.35 am one day';
    # 29.36
    is $pt.format-age('2025-06-12', '2025-06-15'), '3 ቀናት', '29.36 am three days';
    # 29.37
    is $pt.format-age('2025-06-07', '2025-06-15'), '1 ሳምንት፣ 1 ቀን', '29.37 am 1w1d ethiopic';
    # 29.38
    is $pt.format-age('2025-01-15', '2025-07-15'), '6 ወራት', '29.38 am six months';
    # 29.39
    is $pt.format-age('2022-06-15', '2025-12-15'), '3 ዓመታት ተኩል', '29.39 am half years';
}

# ================================================================
# Section 30: Locale lookup by code string
# ================================================================
# 30.1
{
    my $loc = SayableAge::Locales::Registry::get-locale('en');
    ok $loc.defined, '30.1 get en';
    is $loc<code>, 'en', '30.1 en code';
}
# 30.2
{
    my $loc = SayableAge::Locales::Registry::get-locale('fr');
    ok $loc.defined, '30.2 get fr';
    is $loc<code>, 'fr', '30.2 fr code';
}
# 30.3
ok !defined(SayableAge::Locales::Registry::get-locale('xx')), '30.3 unknown locale';
# 30.4
ok !defined(SayableAge::Locales::Registry::get-locale('')), '30.4 empty code';
# 30.5
ok !defined(SayableAge::Locales::Registry::get-locale('EN')), '30.5 case sensitive';

# ================================================================
# Sections 31-33: weeks+days across month ends, half-year plurals, input validation
# ================================================================
# 31.1
is SayableAge::Formatter.new(SayableAge::Locales::Registry::get-locale('en')).format-age('2016-12-31', '2017-03-29'), '12 weeks, 4 days', '31.1 88 days across a 28-day February';
# 31.2
is SayableAge::Formatter.new(SayableAge::Locales::Registry::get-locale('en')).format-age('1991-11-27', '1992-02-25'), '12 weeks, 6 days', '31.2 90 days across a year end into a leap year';
# 31.3
is SayableAge::Formatter.new(SayableAge::Locales::Registry::get-locale('en')).format-age('2020-11-30', '2021-01-02'), '4 weeks, 5 days', '31.3 33 days across a year end';
# 31.4
is SayableAge::Formatter.new(SayableAge::Locales::Registry::get-locale('en'), compactness => 'compact').format-age('2016-12-31', '2017-03-29'), '12w4d', '31.4 Compact form of 31.1';
# 32.1
is SayableAge::Formatter.new(SayableAge::Locales::Registry::get-locale('pl')).format-age('2021-06-15', '2025-01-15'), '3 i pół lata', '32.1 Polish 3 is \'few\'';
# 32.2
is SayableAge::Formatter.new(SayableAge::Locales::Registry::get-locale('pl'), compactness => 'short').format-age('2020-06-15', '2025-12-15'), '5 i pół lat', '32.2 Polish 5 is \'many\'';
# 32.3
is SayableAge::Formatter.new(SayableAge::Locales::Registry::get-locale('shi')).format-age('2005-06-08', '2012-06-07'), '6 ⵉⵙⴳⴳⵯⴰⵙⵏ ⴷ ⵓⵣⴳⵏ', '32.3 Tachelhit 6 is \'few\'';
# 33.1
ok !defined(SayableAge::Formatter.new(SayableAge::Locales::Registry::get-locale('en')).format-age('2025-02-30', '2032-06-25')), '33.1 February 30 doesn\'t exist';
# 33.2
ok !defined(SayableAge::Formatter.new(SayableAge::Locales::Registry::get-locale('en')).format-age('2025-13-01', '2027-01-31')), '33.2 Month 13';
# 33.3
ok !defined(SayableAge::Formatter.new(SayableAge::Locales::Registry::get-locale('en')).format-age('2023-02-29', '2025-03-01')), '33.3 February 29 in a non-leap year';
# 33.4
ok !defined(SayableAge::Formatter.new(SayableAge::Locales::Registry::get-locale('en')).format-age('2025-06-00', '2027-02-25')), '33.4 Day 00';
# 33.5
ok !defined(SayableAge::Formatter.new(SayableAge::Locales::Registry::get-locale('en')).format-age('2025-6-1', '2027-02-25')), '33.5 Unpadded month and day';
# 33.6
ok !defined(SayableAge::Formatter.new(SayableAge::Locales::Registry::get-locale('en')).format-age(' 2025-06-01', '2027-02-25')), '33.6 Surrounding whitespace';
# 33.7
ok !defined(SayableAge::Formatter.new(SayableAge::Locales::Registry::get-locale('en')).format-age('2025-06-15T10:00:00', '2027-02-25')), '33.7 A datetime is not a date';
# 33.8
ok !defined(SayableAge::Formatter.new(SayableAge::Locales::Registry::get-locale('en')).format-age('2020-01-01', '2025-04-31')), '33.8 Invalid asOf';
# 33.9
ok !defined(SayableAge::Formatter.new(SayableAge::Locales::Registry::get-locale('en')).format-stage('2025-02-30', '2027-09-05')), '33.9 formatStage validates too';
# 33.10
is SayableAge::Formatter.new(SayableAge::Locales::Registry::get-locale('en')).format-age('2024-02-29', '2026-03-01'), '2 years', '33.10 February 29 in a leap year is valid';

done-testing;
