(defn- plural [n]
  (cond
    (= n 0) :zero
    (= n 1) :one
    (= n 2) :two
    (let [mod100 (% n 100)]
      (cond
        (and (>= mod100 3) (<= mod100 10)) :few
        (and (>= mod100 11) (<= mod100 99)) :many
        :other))))

