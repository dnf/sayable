(defn- plural [n]
  (let [mod100 (% n 100)]
    (cond
      (= n 0) :zero
      (= n 1) :one
      (or (= mod100 2) (= mod100 22) (= mod100 42) (= mod100 62) (= mod100 82)) :two
      (or (= mod100 3) (= mod100 23) (= mod100 43) (= mod100 63) (= mod100 83)) :few
      (and (not= n 1) (or (= mod100 1) (= mod100 21) (= mod100 41) (= mod100 61) (= mod100 81))) :many
      :other)))

