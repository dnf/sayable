(defn- plural [n]
  (let [mod10 (% n 10)
        mod100 (% n 100)]
    (cond
      (and (= mod10 1) (not= mod100 11)) :one
      (and (>= mod10 2) (<= mod10 9)
           (or (< mod100 12) (> mod100 19))) :few
      :other)))

(def locale
