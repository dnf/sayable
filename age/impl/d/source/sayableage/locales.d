immutable AgeLocale UK = AgeLocale(
    code: "uk",
    plural: function (int n) {
        int mod10 = n % 10;
        int mod100 = n % 100;
        if (mod10 == 1 && mod100 != 11) return PluralCategory.one;
        if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return PluralCategory.few;
        return PluralCategory.many;
    },
    day: makePluralUnit(one: "{n} день", few: "{n} дні", many: "{n} днів", other: "{n} днів"),
    week: makePluralUnit(one: "{n} тиждень", few: "{n} тижні", many: "{n} тижнів", other: "{n} тижнів"),
    month: makePluralUnit(one: "{n} місяць", few: "{n} місяці", many: "{n} місяців", other: "{n} місяців"),
    year: makePluralUnit(one: "{n} рік", few: "{n} роки", many: "{n} років", other: "{n} років"),
    half: "{n} з половиною",
    delimiter: ", ",
    justBorn: "Новонароджений",
    newborn: stageGendered("Новонароджений", "Новонароджена"),
    infant: stageNeutral("Немовля"),
    toddler: stageNeutral("Малюк"),
    child: stageNeutral("Дитина"),
    teenager: stageNeutral("Підліток"),
    adult: stageGendered("Дорослий", "Доросла"),
    short_: CompactnessOverride(
        day: simpleUnit("{n} дн."),
        week: simpleUnit("{n} тиж."),
        month: simpleUnit("{n} міс."),
        year: simpleUnit("{n} р."),
    ),
    compact_: CompactnessOverride(
        day: simpleUnit("{n}д"),
        week: simpleUnit("{n}т"),
        month: simpleUnit("{n}м"),
        year: simpleUnit("{n}р"),
        delimiter: nullable(""),
        half: nullable("{n}½"),
    ),
);

