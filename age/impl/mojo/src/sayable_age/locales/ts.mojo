"""Tsonga locale."""

from ..locale import (
    AgeLocale,
    CompactnessOverride,
    StageLabel,
    UnitForms,
    simple_unit,
    plural_unit,
    stage_neutral,
    stage_gendered,
)


fn build_ts() -> AgeLocale:
    """Build the Tsonga locale."""
    fn plural(n: Int) -> String:
        if n == 1:
            return "one"
        return "other"

    var day = plural_unit(one="siku {n}", other="masiku {n}")
    var week = plural_unit(one="vhiki {n}", other="mavhiki {n}")
    var month = plural_unit(one="n'hweti {n}", other="tin'hweti {n}")
    var year = plural_unit(one="lembe {n}", other="malembe {n}")

    var newborn = stage_neutral("N'wana wo velekiwa")
    var infant = stage_neutral("Xihlangi")
    var toddler = stage_neutral("N'wana lontsongo")
    var child = stage_neutral("N'wana")
    var teenager = stage_neutral("Jaha")
    var adult = stage_neutral("Munhu lonkulu")

    var short_ovr = CompactnessOverride()
    short_ovr.day = plural_unit(one="siku {n}", other="masiku {n}")
    short_ovr.has_day = True
    short_ovr.week = plural_unit(one="vhiki {n}", other="mavhiki {n}")
    short_ovr.has_week = True
    short_ovr.month = plural_unit(one="n'hw. {n}", other="tin'hw. {n}")
    short_ovr.has_month = True
    short_ovr.year = plural_unit(one="lembe {n}", other="mal. {n}")
    short_ovr.has_year = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.day = simple_unit("{n}d")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n}w")
    compact_ovr.has_week = True
    compact_ovr.month = simple_unit("{n}m")
    compact_ovr.has_month = True
    compact_ovr.year = simple_unit("{n}y")
    compact_ovr.has_year = True
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="ts",
        plural_fn=plural,
        day=day,
        week=week,
        month=month,
        year=year,
        half="{0} ni hafu",
        delimiter=", ",
        just_born="N'wana loyi a ha ku velekiwa",
        newborn=newborn,
        infant=infant,
        toddler=toddler,
        child=child,
        teenager=teenager,
        adult=adult,
        short_override=short_ovr,
        has_short=True,
        compact_override=compact_ovr,
        has_compact=True,
    )
