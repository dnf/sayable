    plural_unit,
    stage_neutral,
    stage_gendered,
)


fn build_bg() -> AgeLocale:
    """Build the Bulgarian locale."""
    fn plural(n: Int) -> String:
        if n == 1:
            return "one"
        return "other"

    var day = plural_unit(one="{n} ден", other="{n} дни")
    var week = plural_unit(one="{n} седмица", other="{n} седмици")
    var month = plural_unit(one="{n} месец", other="{n} месеца")
    var year = plural_unit(one="{n} година", other="{n} години")

    var newborn = stage_neutral("Новородено")
    var infant = stage_neutral("Бебе")
    var toddler = stage_neutral("Малко дете")
    var child = stage_neutral("Дете")
    var teenager = stage_neutral("Тийнейджър")
    var adult = stage_gendered("Възрастен", "Възрастна")

    var short_ovr = CompactnessOverride()
    short_ovr.day = simple_unit("{n} д")
    short_ovr.has_day = True
    short_ovr.week = simple_unit("{n} седм.")
    short_ovr.has_week = True
    short_ovr.month = simple_unit("{n} мес.")
    short_ovr.has_month = True
    short_ovr.year = simple_unit("{n} год.")
    short_ovr.has_year = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.day = simple_unit("{n} д")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n} седм.")
    compact_ovr.has_week = True
    compact_ovr.month = simple_unit("{n} мес.")
    compact_ovr.has_month = True
    compact_ovr.year = simple_unit("{n} г.")
    compact_ovr.has_year = True
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="bg",
        plural_fn=plural,
        day=day,
        week=week,
        month=month,
        year=year,
        half="{0} и половина",
        delimiter=", ",
        just_born="Новородено",
        newborn=newborn,
        infant=infant,
        toddler=toddler,
        child=child,
        teenager=teenager,
        adult=adult,
        short_override=short_ovr,
        has_short=True,
        compact_override=compact_ovr,
        has_compact=True,
    )
