"""Bulgarian locale."""

from ..locale import (
    AgeLocale,
    CompactnessOverride,
    StageLabel,
    UnitForms,
    simple_unit,
    plural_unit,
    stage_neutral,
    stage_gendered,
)


fn build_bg() -> AgeLocale:
    """Build the Bulgarian locale."""
    fn plural(n: Int) -> String:
        if n == 1:
            return "one"
        return "other"

    var units = Dict[String, UnitForms]()
    units["day"] = plural_unit(List[Tuple[String, String]](("one", "{n} ден"), ("other", "{n} дни")))
    units["week"] = plural_unit(List[Tuple[String, String]](("one", "{n} седмица"), ("other", "{n} седмици")))
    units["month"] = plural_unit(List[Tuple[String, String]](("one", "{n} месец"), ("other", "{n} месеца")))
    units["year"] = plural_unit(List[Tuple[String, String]](("one", "{n} година"), ("other", "{n} години")))

    var stages = Dict[String, StageLabel]()
    stages["newborn"] = stage_neutral("Новородено")
    stages["infant"] = stage_neutral("Бебе")
    stages["toddler"] = stage_neutral("Малко дете")
    stages["child"] = stage_neutral("Дете")
    stages["teenager"] = stage_neutral("Тийнейджър")
    stages["adult"] = stage_gendered("Възрастен", "Възрастна")

    var short_ovr = CompactnessOverride()
    var short_units = Dict[String, UnitForms]()
    short_units["day"] = simple_unit("{n} д")
    short_units["week"] = simple_unit("{n} седм.")
    short_units["month"] = simple_unit("{n} мес.")
    short_units["year"] = simple_unit("{n} год.")
    short_ovr.units = short_units

    var compact_ovr = CompactnessOverride()
    var compact_units = Dict[String, UnitForms]()
    compact_units["day"] = simple_unit("{n} д")
    compact_units["week"] = simple_unit("{n} седм.")
    compact_units["month"] = simple_unit("{n} мес.")
    compact_units["year"] = simple_unit("{n} г.")
    compact_ovr.units = compact_units
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="bg",
        plural_fn=plural,
        units=units,
        half="{0} и половина",
        delimiter=", ",
        just_born="Новородено",
        stages=stages,
        short_override=short_ovr,
        has_short=True,
        compact_override=compact_ovr,
        has_compact=True,
    )
