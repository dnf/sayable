    units["month"] = simple_unit("{n} mwa")
    units["year"] = simple_unit("{n} lane")

    var stages = Dict[String, StageLabel]()
    stages["newborn"] = stage_neutral("Zanfan fek ne")
    stages["infant"] = stage_neutral("Ti baba")
