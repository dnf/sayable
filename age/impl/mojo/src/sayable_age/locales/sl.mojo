"""Slovenian locale."""

from ..locale import (
    AgeLocale,
    CompactnessOverride,
    StageLabel,
    UnitForms,
    simple_unit,
    plural_unit,
    stage_neutral,
    stage_gendered,
)


fn _plural(n: Int) -> String:
    var mod100 = n % 100
    if mod100 == 1:
        return "one"
    if mod100 == 2:
        return "two"
    if mod100 == 3 or mod100 == 4:
        return "few"
    return "other"


fn build_sl() -> AgeLocale:
    """Build the Slovenian locale."""

    var day = plural_unit(one="{n} dan", two="{n} dneva", few="{n} dni", other="{n} dni")
    var week = plural_unit(one="{n} teden", two="{n} tedna", few="{n} tedne", other="{n} tednov")
    var month = plural_unit(one="{n} mesec", two="{n} meseca", few="{n} mesece", other="{n} mesecev")
    var year = plural_unit(one="{n} leto", two="{n} leti", few="{n} leta", other="{n} let")

    var newborn = stage_gendered("Novorojenček", "Novorojenčica")
    var infant = stage_gendered("Dojenček", "Dojenčica")
    var toddler = stage_gendered("Malček", "Malčica")
    var child = stage_neutral("Otrok")
    var teenager = stage_gendered("Najstnik", "Najstnica")
    var adult = stage_gendered("Odrasel", "Odrasla")

    var short_ovr = CompactnessOverride()
    short_ovr.day = simple_unit("{n} d")
    short_ovr.has_day = True
    short_ovr.week = simple_unit("{n} t")
    short_ovr.has_week = True
    short_ovr.month = simple_unit("{n} m")
    short_ovr.has_month = True
    short_ovr.year = simple_unit("{n} l")
    short_ovr.has_year = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.day = simple_unit("{n} d")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n} t")
    compact_ovr.has_week = True
    compact_ovr.month = simple_unit("{n} m")
    compact_ovr.has_month = True
    compact_ovr.year = simple_unit("{n} l")
    compact_ovr.has_year = True
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="sl",
        plural_fn=_plural,
        day=day,
        week=week,
        month=month,
        year=year,
        half="{0} in pol",
        delimiter=", ",
        just_born="Novorojenček",
        newborn=newborn,
        infant=infant,
        toddler=toddler,
        child=child,
        teenager=teenager,
        adult=adult,
        short_override=short_ovr,
        has_short=True,
        compact_override=compact_ovr,
        has_compact=True,
    )
