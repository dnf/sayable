"""Latvian locale."""

from ..locale import (
    AgeLocale,
    CompactnessOverride,
    StageLabel,
    UnitForms,
    simple_unit,
    plural_unit,
    stage_neutral,
    stage_gendered,
)


fn _plural(n: Int) -> String:
    var mod10 = n % 10
    var mod100 = n % 100
    if mod10 == 0 or 11 <= mod100 <= 19:
        return "zero"
    if mod10 == 1 and mod100 != 11:
        return "one"
    return "other"


fn build_lv() -> AgeLocale:
    """Build the Latvian locale."""

    var units = Dict[String, UnitForms]()
    units["day"] = plural_unit(List[Tuple[String, String]](("zero", "{n} dienu"), ("one", "{n} diena"), ("other", "{n} dienas")))
    units["week"] = plural_unit(List[Tuple[String, String]](("zero", "{n} nedēļu"), ("one", "{n} nedēļa"), ("other", "{n} nedēļas")))
    units["month"] = plural_unit(List[Tuple[String, String]](("zero", "{n} mēnešu"), ("one", "{n} mēnesis"), ("other", "{n} mēneši")))
    units["year"] = plural_unit(List[Tuple[String, String]](("zero", "{n} gadu"), ("one", "{n} gads"), ("other", "{n} gadi")))

    var stages = Dict[String, StageLabel]()
    stages["newborn"] = stage_gendered("Jaundzimušais", "Jaundzimušā")
    stages["infant"] = stage_gendered("Zīdainis", "Zīdaine")
    stages["toddler"] = stage_gendered("Mazulis", "Mazule")
    stages["child"] = stage_neutral("Bērns")
    stages["teenager"] = stage_gendered("Pusaudzis", "Pusaudze")
    stages["adult"] = stage_gendered("Pieaugušais", "Pieaugusī")

    var short_ovr = CompactnessOverride()
    var short_units = Dict[String, UnitForms]()
    short_units["day"] = simple_unit("{n} d.")
    short_units["week"] = simple_unit("{n} ned.")
    short_units["month"] = simple_unit("{n} mēn.")
    short_units["year"] = simple_unit("{n} g.")
    short_ovr.units = short_units

    var compact_ovr = CompactnessOverride()
    var compact_units = Dict[String, UnitForms]()
    compact_units["day"] = simple_unit("{n} d.")
    compact_units["week"] = simple_unit("{n} n.")
    compact_units["month"] = simple_unit("{n} m.")
    compact_units["year"] = simple_unit("{n} g.")
    compact_ovr.units = compact_units
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="lv",
        plural_fn=_plural,
        units=units,
        half="{n}½",
        delimiter=", ",
        just_born="Jaundzimušais",
        stages=stages,
        short_override=short_ovr,
        has_short=True,
        compact_override=compact_ovr,
        has_compact=True,
    )
