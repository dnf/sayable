    var adult = stage_gendered("Adult", "Adulta")

    var short_ovr = CompactnessOverride()
    short_ovr.day = plural_unit(one="{n} dia", other="{n} dies")
    short_ovr.has_day = True
    short_ovr.week = simple_unit("{n} setm.")
