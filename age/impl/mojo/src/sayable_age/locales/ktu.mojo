fn build_ktu() -> AgeLocale:
    """Build the Kituba locale."""
    fn plural(n: Int) -> String:
        if n == 1:
            return "one"
        return "other"

    var day = plural_unit(one="lumbu {n}", other="malumbu {n}")
    var week = plural_unit(one="poso {n}", other="maposo {n}")
    var month = plural_unit(one="ngonda {n}", other="mingonda {n}")
    var year = plural_unit(one="mvula {n}", other="mimvula {n}")

    var newborn = stage_neutral("Mwana ya buta")
    var infant = stage_neutral("Mwana moke")
    var toddler = stage_neutral("Mwana")
    var child = stage_neutral("Mwana")
    var teenager = stage_neutral("Elenge")
    var adult = stage_neutral("Muntu ya nene")

    var short_ovr = CompactnessOverride()
    short_ovr.day = simple_unit("malumbu {n}")
    short_ovr.has_day = True
    short_ovr.week = plural_unit(one="poso {n}", other="maposo {n}")
    short_ovr.has_week = True
    short_ovr.month = plural_unit(one="ngonda {n}", other="mingonda {n}")
    short_ovr.has_month = True
    short_ovr.year = plural_unit(one="mvula {n}", other="mimvula {n}")
    short_ovr.has_year = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.day = simple_unit("malumbu {n}")
    compact_ovr.has_day = True
    compact_ovr.week = plural_unit(one="poso {n}", other="maposo {n}")
    compact_ovr.has_week = True
    compact_ovr.month = plural_unit(one="ngon {n}", other="mingon {n}")
    compact_ovr.has_month = True
    compact_ovr.year = plural_unit(one="mvula {n}", other="mimv {n}")
    compact_ovr.has_year = True
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="ktu",
        plural_fn=plural,
        day=day,
        week=week,
        month=month,
        year=year,
        half="{0} na ndambu",
        delimiter=", ",
        just_born="Mwana ya buta",
        newborn=newborn,
        infant=infant,
        toddler=toddler,
        child=child,
        teenager=teenager,
        adult=adult,
        short_override=short_ovr,
