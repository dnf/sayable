fn build_dv() -> AgeLocale:
    """Build the Dhivehi locale."""
    fn plural(n: Int) -> String:
        return "other"

    var units = Dict[String, UnitForms]()
    units["day"] = simple_unit("{n} ދުވަސް")
    units["week"] = simple_unit("{n} ހަފްތާ")
    units["month"] = simple_unit("{n} މަސް")
    units["year"] = simple_unit("{n} އަހަރު")

    var stages = Dict[String, StageLabel]()
    stages["newborn"] = stage_neutral("އަލަށް އުފަންވި")
    stages["infant"] = stage_neutral("ތުއްތު ކުއްޖާ")
    stages["toddler"] = stage_neutral("ހިނގާ ކުއްޖާ")
    stages["child"] = stage_neutral("ކުޑަ ކުއްޖާ")
    stages["teenager"] = stage_neutral("ފުރާވަރު")
    stages["adult"] = stage_neutral("ބޮޑު މީހާ")

    var short_ovr = CompactnessOverride()
    var short_units = Dict[String, UnitForms]()
    short_units["day"] = simple_unit("{n} ދުވަސް")
    short_units["week"] = simple_unit("{n} ހަފްތާ")
    short_units["month"] = simple_unit("{n} މަސް")
    short_units["year"] = simple_unit("{n} އަހަރު")
    short_ovr.units = short_units^

    var compact_ovr = CompactnessOverride()
    var compact_units = Dict[String, UnitForms]()
    compact_units["day"] = simple_unit("{n}d")
    compact_units["week"] = simple_unit("{n}w")
    compact_units["month"] = simple_unit("{n}m")
    compact_units["year"] = simple_unit("{n}y")
    compact_ovr.units = compact_units^
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="dv",
        plural_fn=plural,
        units=units^,
        half="{0} ބައި",
        delimiter="، ",
        just_born="އަލަށް އުފަންވި",
