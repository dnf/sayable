    var child = stage_neutral("ކުޑަ ކުއްޖާ")
    var teenager = stage_neutral("ފުރާވަރު")
    var adult = stage_neutral("ބޮޑު މީހާ")

    var short_ovr = CompactnessOverride()
    short_ovr.day = simple_unit("{n} ދުވަސް")
    short_ovr.has_day = True
    short_ovr.week = simple_unit("{n} ހަފްތާ")
    short_ovr.has_week = True
    short_ovr.month = simple_unit("{n} މަސް")
