"""Amharic locale."""

from ..locale import (
    AgeLocale,
    CompactnessOverride,
    StageLabel,
    UnitForms,
    simple_unit,
    plural_unit,
    stage_neutral,
    stage_gendered,
)


fn build_am() -> AgeLocale:
    """Build the Amharic locale."""
    fn plural(n: Int) -> String:
        if n == 0 or n == 1:
            return "one"
        return "other"

    var day = plural_unit(one="{n} ቀን", other="{n} ቀናት")
    var week = plural_unit(one="{n} ሳምንት", other="{n} ሳምንታት")
    var month = plural_unit(one="{n} ወር", other="{n} ወራት")
    var year = plural_unit(one="{n} ዓመት", other="{n} ዓመታት")

    var newborn = stage_neutral("አዲስ የተወለደ")
    var infant = stage_neutral("ሕፃን")
    var toddler = stage_neutral("ሕፃን ልጅ")
    var child = stage_neutral("ልጅ")
    var teenager = stage_neutral("ታዳጊ")
    var adult = stage_neutral("አዋቂ")

    var short_ovr = CompactnessOverride()
    short_ovr.day = simple_unit("{n} ቀናት")
    short_ovr.has_day = True
    short_ovr.week = plural_unit(one="{n} ሳምንት", other="{n} ሳምንታት")
    short_ovr.has_week = True
    short_ovr.month = simple_unit("{n} ወራት")
    short_ovr.has_month = True
    short_ovr.year = plural_unit(one="{n} ዓመት", other="{n} ዓመታት")
    short_ovr.has_year = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.day = simple_unit("{n} ቀ")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n} ሳምንት")
    compact_ovr.has_week = True
    compact_ovr.month = simple_unit("{n} ወር")
    compact_ovr.has_month = True
    compact_ovr.year = plural_unit(one="{n} ዓመት", other="{n} ዓ")
    compact_ovr.has_year = True
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="am",
        plural_fn=plural,
        day=day,
        week=week,
        month=month,
        year=year,
        half="{0} ተኩል",
        delimiter="፣ ",
        just_born="አዲስ የተወለደ",
        newborn=newborn,
        infant=infant,
        toddler=toddler,
        child=child,
        teenager=teenager,
