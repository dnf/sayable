"""Armenian locale."""

from ..locale import (
    AgeLocale,
    CompactnessOverride,
    StageLabel,
    UnitForms,
    simple_unit,
    plural_unit,
    stage_neutral,
    stage_gendered,
)


fn build_hy() -> AgeLocale:
    """Build the Armenian locale."""
    fn plural(n: Int) -> String:
        if n == 0 or n == 1:
            return "one"
        return "other"

    var units = Dict[String, UnitForms]()
    units["day"] = plural_unit(List[Tuple[String, String]](("one", "{n} օր"), ("other", "{n} օր")))
    units["week"] = plural_unit(List[Tuple[String, String]](("one", "{n} շաբաթ"), ("other", "{n} շաբաթ")))
    units["month"] = plural_unit(List[Tuple[String, String]](("one", "{n} ամիս"), ("other", "{n} ամիս")))
    units["year"] = plural_unit(List[Tuple[String, String]](("one", "{n} տարի"), ("other", "{n} տարի")))

    var stages = Dict[String, StageLabel]()
    stages["newborn"] = stage_neutral("Նորածին")
    stages["infant"] = stage_neutral("Մանկիկ")
    stages["toddler"] = stage_neutral("Փոքրիկ")
    stages["child"] = stage_neutral("Երեխա")
    stages["teenager"] = stage_neutral("Պատանի")
    stages["adult"] = stage_neutral("Մեծահասակ")

    var short_ovr = CompactnessOverride()
    var short_units = Dict[String, UnitForms]()
    short_units["day"] = simple_unit("{n} օր")
    short_units["week"] = simple_unit("{n} շաբ")
    short_units["month"] = simple_unit("{n} ամս")
    short_units["year"] = simple_unit("{n} տ")
    short_ovr.units = short_units

    var compact_ovr = CompactnessOverride()
    var compact_units = Dict[String, UnitForms]()
    compact_units["day"] = simple_unit("{n} օ")
    compact_units["week"] = simple_unit("{n} շ")
    compact_units["month"] = simple_unit("{n} ա")
    compact_units["year"] = simple_unit("{n} տ")
    compact_ovr.units = compact_units
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="hy",
        plural_fn=plural,
        units=units,
        half="{0} ու կես",
        delimiter=", ",
        just_born="Նորածին",
        stages=stages,
        short_override=short_ovr,
        has_short=True,
        compact_override=compact_ovr,
        has_compact=True,
    )
