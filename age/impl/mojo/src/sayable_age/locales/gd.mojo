    short_units["week"] = plural_unit(List[Tuple[String, String]](("one", "{n} shn"), ("two", "{n} shn"), ("few", "{n} sn"), ("other", "{n} sn")))
    short_units["month"] = plural_unit(List[Tuple[String, String]](("one", "{n} mhìos"), ("two", "{n} mhìos"), ("few", "{n} mìos"), ("other", "{n} mìos")))
    short_units["year"] = plural_unit(List[Tuple[String, String]](("one", "{n} bhlia"), ("two", "{n} bhlia"), ("few", "{n} blia"), ("other", "{n} blia")))
    short_ovr.units = short_units

    var compact_ovr = CompactnessOverride()
    var compact_units = Dict[String, UnitForms]()
    compact_units["day"] = simple_unit("{n}là")
    compact_units["week"] = simple_unit("{n}s")
