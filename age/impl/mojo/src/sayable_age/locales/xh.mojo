    units["month"] = plural_unit(List[Tuple[String, String]](("one", "inyanga {n}"), ("other", "iinyanga {n}")))
    units["year"] = plural_unit(List[Tuple[String, String]](("one", "unyaka {n}"), ("other", "iminyaka {n}")))

    var stages = Dict[String, StageLabel]()
    stages["newborn"] = stage_neutral("Usana olusanda kuzalwa")
    stages["infant"] = stage_neutral("Usana")
    stages["toddler"] = stage_neutral("Umntwana omncinane")
    stages["child"] = stage_neutral("Umntwana")
    stages["teenager"] = stage_neutral("Ulutsha")
    stages["adult"] = stage_neutral("Umntu omdala")

    var short_ovr = CompactnessOverride()
    var short_units = Dict[String, UnitForms]()
    short_units["day"] = plural_unit(List[Tuple[String, String]](("one", "usuku {n}"), ("other", "iintsuku {n}")))
    short_units["week"] = plural_unit(List[Tuple[String, String]](("one", "iveki {n}"), ("other", "iiveki {n}")))
    short_units["month"] = plural_unit(List[Tuple[String, String]](("one", "iny. {n}"), ("other", "iiny. {n}")))
    short_units["year"] = plural_unit(List[Tuple[String, String]](("one", "uny. {n}"), ("other", "imy. {n}")))
    short_ovr.units = short_units

    var compact_ovr = CompactnessOverride()
    var compact_units = Dict[String, UnitForms]()
    compact_units["day"] = simple_unit("{n}d")
    compact_units["week"] = simple_unit("{n}w")
    compact_units["month"] = simple_unit("{n}m")
    compact_units["year"] = simple_unit("{n}y")
    compact_ovr.units = compact_units
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
