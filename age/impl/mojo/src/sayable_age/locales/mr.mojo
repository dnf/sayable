"""Marathi locale."""

from ..locale import (
    AgeLocale,
    CompactnessOverride,
    StageLabel,
    UnitForms,
    simple_unit,
    plural_unit,
    stage_neutral,
    stage_gendered,
)


fn build_mr() -> AgeLocale:
    """Build the Marathi locale."""
    fn plural(n: Int) -> String:
        if n == 1:
            return "one"
        return "other"

    var day = plural_unit(one="{n} दिवस", other="{n} दिवस")
    var week = plural_unit(one="{n} आठवडा", other="{n} आठवडे")
    var month = plural_unit(one="{n} महिना", other="{n} महिने")
    var year = plural_unit(one="{n} वर्ष", other="{n} वर्षे")

    var newborn = stage_neutral("नवजात")
    var infant = stage_neutral("अर्भक")
    var toddler = stage_neutral("बाळ")
    var child = stage_neutral("मूल")
    var teenager = stage_gendered("किशोर", "किशोरी")
    var adult = stage_neutral("प्रौढ")

    var short_ovr = CompactnessOverride()
    short_ovr.day = simple_unit("{n} दिवस")
    short_ovr.has_day = True
    short_ovr.week = simple_unit("{n} आ")
    short_ovr.has_week = True
    short_ovr.month = plural_unit(one="{n} महिना", other="{n} महिने")
    short_ovr.has_month = True
    short_ovr.year = plural_unit(one="{n} वर्ष", other="{n} वर्षे")
    short_ovr.has_year = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.day = simple_unit("{n}दि")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n}आ")
    compact_ovr.has_week = True
    compact_ovr.month = simple_unit("{n}म")
    compact_ovr.has_month = True
    compact_ovr.year = simple_unit("{n}व")
    compact_ovr.has_year = True
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="mr",
        plural_fn=plural,
        day=day,
        week=week,
        month=month,
        year=year,
        half="साडे {n}",
        delimiter=", ",
        just_born="नवजात",
        newborn=newborn,
        infant=infant,
        toddler=toddler,
        child=child,
        teenager=teenager,
        adult=adult,
        short_override=short_ovr,
        has_short=True,
        compact_override=compact_ovr,
        has_compact=True,
    )
