fn build_ku() -> AgeLocale:
    """Build the Kurdish locale."""
    fn plural(n: Int) -> String:
        if n == 1:
            return "one"
        return "other"

    var day = plural_unit(one="{n} roj", other="{n} roj")
    var week = plural_unit(one="{n} hefte", other="{n} hefte")
