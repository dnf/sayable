fn _plural(n: Int) -> String:
    var mod10 = n % 10
    var mod100 = n % 100
    if mod10 == 1 and mod100 != 11:
        return "one"
    return "other"


fn build_mk() -> AgeLocale:
    """Build the Macedonian locale."""

    var day = plural_unit(one="{n} ден", other="{n} дена")
    var week = plural_unit(one="{n} недела", other="{n} недели")
    var month = plural_unit(one="{n} месец", other="{n} месеци")
    var year = plural_unit(one="{n} година", other="{n} години")

    var newborn = stage_neutral("Новороденче")
    var infant = stage_neutral("Бебе")
    var toddler = stage_neutral("Мало дете")
    var child = stage_neutral("Дете")
    var teenager = stage_neutral("Тинејџер")
    var adult = stage_neutral("Возрасен")

    var short_ovr = CompactnessOverride()
    short_ovr.day = plural_unit(one="{n} ден", other="{n} дена")
    short_ovr.has_day = True
    short_ovr.week = simple_unit("{n} сед.")
    short_ovr.has_week = True
    short_ovr.month = simple_unit("{n} мес.")
    short_ovr.has_month = True
    short_ovr.year = simple_unit("{n} год.")
    short_ovr.has_year = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.day = simple_unit("{n} д.")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n} с.")
    compact_ovr.has_week = True
    compact_ovr.month = simple_unit("{n} м.")
    compact_ovr.has_month = True
    compact_ovr.year = simple_unit("{n} г.")
    compact_ovr.has_year = True
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="mk",
        plural_fn=_plural,
        day=day,
        week=week,
        month=month,
        year=year,
        half="{0} и пол",
        delimiter=", ",
        just_born="Новороденче",
        newborn=newborn,
        infant=infant,
        toddler=toddler,
