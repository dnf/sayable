    units["year"] = plural_unit(List[Tuple[String, String]](Tuple[String, String]("one", "{n} jaar"), Tuple[String, String]("other", "{n} jaar")))

    var stages = Dict[String, StageLabel]()
    stages["newborn"] = stage_neutral("Pasgeborene")
