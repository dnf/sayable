fn build_sg() -> AgeLocale:
    """Build the Sango locale."""
    fn plural(n: Int) -> String:
        return "other"

    var units = Dict[String, UnitForms]()
    units["day"] = simple_unit("lâ {n}")
    units["week"] = simple_unit("bîkua-ûse {n}")
    units["month"] = simple_unit("nze {n}")
    units["year"] = simple_unit("ngû {n}")

    var stages = Dict[String, StageLabel]()
    stages["newborn"] = stage_neutral("Molengê tî dûngö")
    stages["infant"] = stage_neutral("Molengê kêtê")
    stages["toddler"] = stage_neutral("Molengê")
    stages["child"] = stage_neutral("Wan")
    stages["teenager"] = stage_neutral("Kôlï-wa")
    stages["adult"] = stage_neutral("Kôlï")

    var short_ovr = CompactnessOverride()
    var short_units = Dict[String, UnitForms]()
    short_units["day"] = simple_unit("lâ {n}")
    short_units["week"] = simple_unit("bîk. {n}")
    short_units["month"] = simple_unit("nze {n}")
    short_units["year"] = simple_unit("ngû {n}")
    short_ovr.units = short_units^

    var compact_ovr = CompactnessOverride()
    var compact_units = Dict[String, UnitForms]()
    compact_units["day"] = simple_unit("{n}d")
    compact_units["week"] = simple_unit("{n}w")
    compact_units["month"] = simple_unit("{n}m")
    compact_units["year"] = simple_unit("{n}y")
    compact_ovr.units = compact_units^
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
