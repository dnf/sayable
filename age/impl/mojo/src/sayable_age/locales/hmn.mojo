    units["year"] = simple_unit("{n} xyoo")

    var stages = Dict[String, StageLabel]()
    stages["newborn"] = stage_neutral("Nyuam qhuav yug")
    stages["infant"] = stage_neutral("Me nyuam mos")
    stages["toddler"] = stage_neutral("Me nyuam tseem taug kev")
    stages["child"] = stage_neutral("Me nyuam")
    stages["teenager"] = stage_neutral("Tub ntxhais hluas")
    stages["adult"] = stage_neutral("Neeg laus")

    var short_ovr = CompactnessOverride()
    var short_units = Dict[String, UnitForms]()
    short_units["day"] = simple_unit("{n} hnub")
    short_units["week"] = simple_unit("{n} lim tiam")
    short_units["month"] = simple_unit("{n} hlis")
    short_units["year"] = simple_unit("{n} xyoo")
    short_ovr.units = short_units

    var compact_ovr = CompactnessOverride()
    var compact_units = Dict[String, UnitForms]()
    compact_units["day"] = simple_unit("{n}d")
    compact_units["week"] = simple_unit("{n}w")
    compact_units["month"] = simple_unit("{n}m")
