"""Polish locale."""

from ..locale import (
    AgeLocale,
    CompactnessOverride,
    StageLabel,
    UnitForms,
    simple_unit,
    plural_unit,
    stage_neutral,
    stage_gendered,
)


fn _plural(n: Int) -> String:
    if n == 1:
        return "one"
    var mod10 = n % 10
    var mod100 = n % 100
    if 2 <= mod10 <= 4 and (mod100 < 12 or mod100 > 14):
        return "few"
    return "many"


fn build_pl() -> AgeLocale:
    """Build the Polish locale."""

    var day = plural_unit(one="{n} dzień", few="{n} dni", many="{n} dni", other="{n} dni")
    var week = plural_unit(one="{n} tydzień", few="{n} tygodnie", many="{n} tygodni", other="{n} tygodni")
    var month = plural_unit(one="{n} miesiąc", few="{n} miesiące", many="{n} miesięcy", other="{n} miesięcy")
    var year = plural_unit(one="{n} rok", few="{n} lata", many="{n} lat", other="{n} lat")

    var newborn = stage_neutral("Noworodek")
    var infant = stage_neutral("Niemowlę")
    var toddler = stage_neutral("Maluch")
    var child = stage_neutral("Dziecko")
    var teenager = stage_gendered("Nastolatek", "Nastolatka")
    var adult = stage_gendered("Dorosły", "Dorosła")

    var short_ovr = CompactnessOverride()
    short_ovr.day = plural_unit(one="{n} dzień", few="{n} dni", many="{n} dni", other="{n} dnia")
    short_ovr.has_day = True
    short_ovr.week = plural_unit(one="{n} tydz.", few="{n} tyg.", many="{n} tyg.", other="{n} tyg.")
    short_ovr.has_week = True
    short_ovr.month = simple_unit("{n} mies.")
    short_ovr.has_month = True
    short_ovr.year = plural_unit(one="{n} rok", few="{n} lata", many="{n} lat", other="{n} roku")
    short_ovr.has_year = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.day = simple_unit("{n} d.")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n} t.")
    compact_ovr.has_week = True
    compact_ovr.month = plural_unit(one="{n} m-c", few="{n} m-ce", many="{n} m-cy", other="{n} m-ca")
    compact_ovr.has_month = True
    compact_ovr.year = plural_unit(one="{n} r.", few="{n} l.", many="{n} l.", other="{n} r.")
    compact_ovr.has_year = True
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="pl",
        plural_fn=_plural,
        day=day,
        week=week,
        month=month,
        year=year,
        half="{n} i pół",
        delimiter=", ",
        just_born="Noworodek",
        newborn=newborn,
        infant=infant,
        toddler=toddler,
        child=child,
        teenager=teenager,
        adult=adult,
