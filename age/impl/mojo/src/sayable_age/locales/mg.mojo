"""Malagasy locale."""

from ..locale import (
    AgeLocale,
    CompactnessOverride,
    StageLabel,
    UnitForms,
    simple_unit,
    plural_unit,
    stage_neutral,
    stage_gendered,
)


fn build_mg() -> AgeLocale:
    """Build the Malagasy locale."""
    fn plural(n: Int) -> String:
        if n == 0 or n == 1:
            return "one"
        return "other"

    var units = Dict[String, UnitForms]()
    units["day"] = simple_unit("{n} andro")
    units["week"] = simple_unit("{n} herinandro")
    units["month"] = simple_unit("{n} volana")
    units["year"] = simple_unit("{n} taona")

    var stages = Dict[String, StageLabel]()
    stages["newborn"] = stage_neutral("Vao teraka")
    stages["infant"] = stage_neutral("Zazakely")
    stages["toddler"] = stage_neutral("Zazakely")
    stages["child"] = stage_neutral("Ankizy")
    stages["teenager"] = stage_neutral("Tanora")
    stages["adult"] = stage_neutral("Olon-dehibe")

    var short_ovr = CompactnessOverride()
    var short_units = Dict[String, UnitForms]()
    short_units["day"] = simple_unit("{n} and")
    short_units["week"] = simple_unit("{n} her")
    short_units["month"] = simple_unit("{n} vol")
    short_units["year"] = simple_unit("{n} tna")
    short_ovr.units = short_units^

    var compact_ovr = CompactnessOverride()
    var compact_units = Dict[String, UnitForms]()
    compact_units["day"] = simple_unit("{n} a")
    compact_units["week"] = simple_unit("{n} h")
    compact_units["month"] = simple_unit("{n} v")
    compact_units["year"] = simple_unit("{n} t")
    compact_ovr.units = compact_units^
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="mg",
        plural_fn=plural,
        units=units^,
        half="{0} sy sasany",
        delimiter=", ",
        just_born="Vao teraka",
        stages=stages^,
        short_override=short_ovr^,
        has_short=True,
        compact_override=compact_ovr^,
        has_compact=True,
    )
