    AgeLocale,
    CompactnessOverride,
    StageLabel,
    UnitForms,
    simple_unit,
    plural_unit,
    stage_neutral,
    stage_gendered,
)


fn build_tn() -> AgeLocale:
    """Build the Tswana locale."""
    fn plural(n: Int) -> String:
        if n == 1:
            return "one"
        return "other"

    var day = plural_unit(one="letsatsi {n}", other="malatsi {n}")
    var week = plural_unit(one="beke {n}", other="dibeke {n}")
    var month = plural_unit(one="kgwedi {n}", other="dikgwedi {n}")
    var year = plural_unit(one="ngwaga {n}", other="dingwaga {n}")

    var newborn = stage_neutral("Lesea le sa tswa tsalwa")
    var infant = stage_neutral("Lesea")
    var toddler = stage_neutral("Ngwana yo monnye")
    var child = stage_neutral("Ngwana")
    var teenager = stage_neutral("Lekgarebe")
    var adult = stage_neutral("Motho yo mogolo")

    var short_ovr = CompactnessOverride()
    short_ovr.day = plural_unit(one="letsatsi {n}", other="malatsi {n}")
    short_ovr.has_day = True
    short_ovr.week = plural_unit(one="beke {n}", other="dibeke {n}")
    short_ovr.has_week = True
    short_ovr.month = plural_unit(one="kgw. {n}", other="dikgw. {n}")
    short_ovr.has_month = True
    short_ovr.year = plural_unit(one="ngw. {n}", other="dingw. {n}")
    short_ovr.has_year = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.day = simple_unit("{n}d")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n}w")
    compact_ovr.has_week = True
    compact_ovr.month = simple_unit("{n}m")
    compact_ovr.has_month = True
    compact_ovr.year = simple_unit("{n}y")
    compact_ovr.has_year = True
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="tn",
        plural_fn=plural,
        day=day,
        week=week,
        month=month,
        year=year,
        half="{0} le halofo",
        delimiter=", ",
        just_born="O sa tswa tsalwa",
        newborn=newborn,
        infant=infant,
        toddler=toddler,
        child=child,
        teenager=teenager,
        adult=adult,
        short_override=short_ovr,
        has_short=True,
        compact_override=compact_ovr,
        has_compact=True,
    )
