    units["month"] = plural_unit(List[Tuple[String, String]](Tuple[String, String]("one", "kgwedi {n}"), Tuple[String, String]("other", "dikgwedi {n}")))
    units["year"] = plural_unit(List[Tuple[String, String]](Tuple[String, String]("one", "ngwaga {n}"), Tuple[String, String]("other", "dingwaga {n}")))

    var stages = Dict[String, StageLabel]()
    stages["newborn"] = stage_neutral("Lesea le sa tswa tsalwa")
    stages["infant"] = stage_neutral("Lesea")
    stages["toddler"] = stage_neutral("Ngwana yo monnye")
    stages["child"] = stage_neutral("Ngwana")
    stages["teenager"] = stage_neutral("Lekgarebe")
    stages["adult"] = stage_neutral("Motho yo mogolo")

    var short_ovr = CompactnessOverride()
    var short_units = Dict[String, UnitForms]()
    short_units["day"] = plural_unit(List[Tuple[String, String]](Tuple[String, String]("one", "letsatsi {n}"), Tuple[String, String]("other", "malatsi {n}")))
    short_units["week"] = plural_unit(List[Tuple[String, String]](Tuple[String, String]("one", "beke {n}"), Tuple[String, String]("other", "dibeke {n}")))
    short_units["month"] = plural_unit(List[Tuple[String, String]](Tuple[String, String]("one", "kgw. {n}"), Tuple[String, String]("other", "dikgw. {n}")))
    short_units["year"] = plural_unit(List[Tuple[String, String]](Tuple[String, String]("one", "ngw. {n}"), Tuple[String, String]("other", "dingw. {n}")))
    short_ovr.units = short_units^

    var compact_ovr = CompactnessOverride()
    var compact_units = Dict[String, UnitForms]()
    compact_units["day"] = simple_unit("{n}d")
    compact_units["week"] = simple_unit("{n}w")
    compact_units["month"] = simple_unit("{n}m")
    compact_units["year"] = simple_unit("{n}y")
    compact_ovr.units = compact_units^
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
