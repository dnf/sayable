fn build_so() -> AgeLocale:
    """Build the Somali locale."""
    fn plural(n: Int) -> String:
        if n == 1:
            return "one"
        return "other"

    var day = plural_unit(one="maalin {n}", other="maalmood {n}")
    var week = plural_unit(one="toddobaad {n}", other="toddobaadyo {n}")
