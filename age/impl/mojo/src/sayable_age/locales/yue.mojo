"""Cantonese locale."""

from ..locale import (
    AgeLocale,
    CompactnessOverride,
    StageLabel,
    UnitForms,
    simple_unit,
    plural_unit,
    stage_neutral,
    stage_gendered,
)


fn build_yue() -> AgeLocale:
    """Build the Cantonese locale."""
    fn plural(n: Int) -> String:
        return "other"

    var units = Dict[String, UnitForms]()
    units["day"] = simple_unit("{n}日")
    units["week"] = simple_unit("{n}個星期")
    units["month"] = simple_unit("{n}個月")
    units["year"] = simple_unit("{n}歲")

    var stages = Dict[String, StageLabel]()
    stages["newborn"] = stage_neutral("初生嬰兒")
    stages["infant"] = stage_neutral("嬰兒")
    stages["toddler"] = stage_neutral("幼兒")
    stages["child"] = stage_neutral("細路")
    stages["teenager"] = stage_neutral("後生")
    stages["adult"] = stage_neutral("成人")

    var short_ovr = CompactnessOverride()
    var short_units = Dict[String, UnitForms]()
    short_units["day"] = simple_unit("{n} 日")
    short_units["week"] = simple_unit("{n} 個星期")
    short_units["month"] = simple_unit("{n} 個月")
    short_units["year"] = simple_unit("{n} 年")
    short_ovr.units = short_units

    var compact_ovr = CompactnessOverride()
    var compact_units = Dict[String, UnitForms]()
    compact_units["day"] = simple_unit("{n}日")
    compact_units["week"] = simple_unit("{n}週")
    compact_units["month"] = simple_unit("{n}月")
    compact_units["year"] = simple_unit("{n}年")
    compact_ovr.units = compact_units

    return AgeLocale(
        code="yue",
        plural_fn=plural,
        units=units,
        half="{0}半",
        delimiter="",
        just_born="初生嬰兒",
        stages=stages,
        short_override=short_ovr,
        has_short=True,
        compact_override=compact_ovr,
        has_compact=True,
    )
