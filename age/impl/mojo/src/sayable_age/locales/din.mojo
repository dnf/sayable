)


fn build_din() -> AgeLocale:
    """Build the Dinka locale."""
    fn plural(n: Int) -> String:
        if n == 1:
            return "one"
        return "other"

    var day = plural_unit(one="akɔl {n}", other="akɔl {n}")
    var week = plural_unit(one="bɛ̈t {n}", other="bɛ̈t {n}")
    var month = plural_unit(one="pɛi {n}", other="pɛi {n}")
    var year = plural_unit(one="ruɔ̈n {n}", other="ruɔ̈ɔ̈n {n}")

    var newborn = stage_neutral("Meth yen dhiëth")
    var infant = stage_neutral("Meth")
    var toddler = stage_neutral("Meth thiiŋ")
    var child = stage_neutral("Meth")
    var teenager = stage_neutral("Dhɔ̈l")
    var adult = stage_neutral("Raan dit")

    var short_ovr = CompactnessOverride()
    short_ovr.day = simple_unit("akɔl {n}")
    short_ovr.has_day = True
    short_ovr.week = simple_unit("bɛ̈t {n}")
    short_ovr.has_week = True
    short_ovr.month = simple_unit("pɛi {n}")
    short_ovr.has_month = True
    short_ovr.year = plural_unit(one="ruɔ̈n {n}", other="ruɔ̈ɔ̈n {n}")
    short_ovr.has_year = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.day = simple_unit("{n}d")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n}w")
    compact_ovr.has_week = True
    compact_ovr.month = simple_unit("{n}m")
    compact_ovr.has_month = True
    compact_ovr.year = simple_unit("{n}y")
    compact_ovr.has_year = True
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="din",
        plural_fn=plural,
        day=day,
        week=week,
        month=month,
        year=year,
        half="{0} ku abɛ̈c",
        delimiter=", ",
        just_born="Meth yen dhiëth",
        newborn=newborn,
        infant=infant,
        toddler=toddler,
        child=child,
        teenager=teenager,
        adult=adult,
        short_override=short_ovr,
        has_short=True,
        compact_override=compact_ovr,
        has_compact=True,
    )
