fn build_ve() -> AgeLocale:
    """Build the Venda locale."""
    fn plural(n: Int) -> String:
        if n == 1:
            return "one"
        return "other"

    var day = plural_unit(one="duvha {n}", other="maduvha {n}")
    var week = plural_unit(one="vhege {n}", other="mavhege {n}")
    var month = plural_unit(one="nwedzi {n}", other="minwedzi {n}")
    var year = plural_unit(one="nwaha {n}", other="minwaha {n}")

    var newborn = stage_neutral("Mbuwe")
    var infant = stage_neutral("Kwana")
    var toddler = stage_neutral("Nwana mutuku")
    var child = stage_neutral("Nwana")
    var teenager = stage_neutral("Mutukana")
    var adult = stage_neutral("Muthu muhulwane")

    var short_ovr = CompactnessOverride()
    short_ovr.day = plural_unit(one="duv. {n}", other="mad. {n}")
    short_ovr.has_day = True
    short_ovr.week = plural_unit(one="vheg. {n}", other="mav. {n}")
    short_ovr.has_week = True
    short_ovr.month = plural_unit(one="nwedzi {n}", other="min. {n}")
    short_ovr.has_month = True
    short_ovr.year = plural_unit(one="nwaha {n}", other="min. {n}")
    short_ovr.has_year = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.day = simple_unit("{n}d")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n}w")
    compact_ovr.has_week = True
    compact_ovr.month = simple_unit("{n}m")
    compact_ovr.has_month = True
    compact_ovr.year = simple_unit("{n}y")
    compact_ovr.has_year = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
