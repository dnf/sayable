fn _plural(n: Int) -> String:
    if n == 1:
        return "one"
    if n == 2:
        return "two"
    var mod100 = n % 100
    if n == 0 or 3 <= mod100 <= 10:
        return "few"
    if 11 <= mod100 <= 19:
        return "many"
    return "other"


