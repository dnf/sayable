"""Lithuanian locale."""

from ..locale import (
    AgeLocale,
    CompactnessOverride,
    StageLabel,
    UnitForms,
    simple_unit,
    plural_unit,
    stage_neutral,
    stage_gendered,
)


fn _plural(n: Int) -> String:
    var mod10 = n % 10
    var mod100 = n % 100
    if mod10 == 1 and mod100 != 11:
        return "one"
    if 2 <= mod10 <= 9 and (mod100 < 12 or mod100 > 19):
        return "few"
    return "other"


fn build_lt() -> AgeLocale:
    """Build the Lithuanian locale."""

    var units = Dict[String, UnitForms]()
    units["day"] = plural_unit(List[Tuple[String, String]](("one", "{n} diena"), ("few", "{n} dienos"), ("other", "{n} dienų")))
    units["week"] = plural_unit(List[Tuple[String, String]](("one", "{n} savaitė"), ("few", "{n} savaitės"), ("other", "{n} savaičių")))
    units["month"] = plural_unit(List[Tuple[String, String]](("one", "{n} mėnuo"), ("few", "{n} mėnesiai"), ("other", "{n} mėnesių")))
    units["year"] = plural_unit(List[Tuple[String, String]](("one", "{n} metai"), ("few", "{n} metai"), ("other", "{n} metų")))

    var stages = Dict[String, StageLabel]()
    stages["newborn"] = stage_gendered("Naujagimis", "Naujagimė")
    stages["infant"] = stage_gendered("Kūdikis", "Kūdikė")
    stages["toddler"] = stage_gendered("Mažylis", "Mažylė")
    stages["child"] = stage_neutral("Vaikas")
    stages["teenager"] = stage_gendered("Paauglys", "Paauglė")
    stages["adult"] = stage_gendered("Suaugęs", "Suaugusi")

    var short_ovr = CompactnessOverride()
    var short_units = Dict[String, UnitForms]()
    short_units["day"] = simple_unit("{n} d.")
    short_units["week"] = simple_unit("{n} sav.")
    short_units["month"] = simple_unit("{n} mėn.")
    short_units["year"] = simple_unit("{n} m.")
    short_ovr.units = short_units

    var compact_ovr = CompactnessOverride()
    var compact_units = Dict[String, UnitForms]()
    compact_units["day"] = simple_unit("{n} d.")
    compact_units["week"] = simple_unit("{n} sav.")
    compact_units["month"] = simple_unit("{n} mėn.")
    compact_units["year"] = simple_unit("{n} m.")
    compact_ovr.units = compact_units
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="lt",
        plural_fn=_plural,
        units=units,
        half="{n}½",
        delimiter=", ",
        just_born="Naujagimis",
        stages=stages,
        short_override=short_ovr,
        has_short=True,
        compact_override=compact_ovr,
        has_compact=True,
    )
