"""Nepali locale."""

from ..locale import (
    AgeLocale,
    CompactnessOverride,
    StageLabel,
    UnitForms,
    simple_unit,
    plural_unit,
    stage_neutral,
    stage_gendered,
)


fn build_ne() -> AgeLocale:
    """Build the Nepali locale."""
    fn plural(n: Int) -> String:
        if n == 1:
            return "one"
        return "other"

    var day = plural_unit(one="{n} दिन", other="{n} दिन")
    var week = plural_unit(one="{n} हप्ता", other="{n} हप्ता")
    var month = plural_unit(one="{n} महिना", other="{n} महिना")
    var year = plural_unit(one="{n} वर्ष", other="{n} वर्ष")

    var newborn = stage_neutral("नवजात शिशु")
    var infant = stage_neutral("शिशु")
    var toddler = stage_neutral("बाल्यकाल")
    var child = stage_neutral("बालक")
    var teenager = stage_neutral("किशोर")
    var adult = stage_neutral("वयस्क")

    var short_ovr = CompactnessOverride()
    short_ovr.day = simple_unit("{n} दिन")
    short_ovr.has_day = True
    short_ovr.week = simple_unit("{n} हप्ता")
    short_ovr.has_week = True
    short_ovr.month = simple_unit("{n} महिना")
    short_ovr.has_month = True
    short_ovr.year = simple_unit("{n} वर्ष")
    short_ovr.has_year = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.day = simple_unit("{n} दिन")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n} हप्ता")
    compact_ovr.has_week = True
    compact_ovr.month = simple_unit("{n} महिना")
    compact_ovr.has_month = True
    compact_ovr.year = simple_unit("{n} वर्ष")
    compact_ovr.has_year = True
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="ne",
        plural_fn=plural,
        day=day,
        week=week,
        month=month,
        year=year,
        half="साढे {n}",
        delimiter=", ",
        just_born="नवजात शिशु",
        newborn=newborn,
        infant=infant,
        toddler=toddler,
        child=child,
        teenager=teenager,
        adult=adult,
        short_override=short_ovr,
        has_short=True,
        compact_override=compact_ovr,
        has_compact=True,
    )
