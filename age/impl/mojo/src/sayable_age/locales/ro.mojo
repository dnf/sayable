    var units = Dict[String, UnitForms]()
    units["day"] = plural_unit(List[Tuple[String, String]](Tuple[String, String]("one", "{n} zi"), Tuple[String, String]("few", "{n} zile"), Tuple[String, String]("other", "{n} de zile")))
