    stage_gendered,
)


fn _plural(n: Int) -> String:
    if n == 1:
        return "one"
    if n == 0 or 1 <= n % 100 <= 19:
        return "few"
    return "other"


fn build_ro() -> AgeLocale:
    """Build the Romanian locale."""

    var day = plural_unit(one="{n} zi", few="{n} zile", other="{n} de zile")
    var week = plural_unit(one="{n} săptămână", few="{n} săptămâni", other="{n} de săptămâni")
    var month = plural_unit(one="{n} lună", few="{n} luni", other="{n} de luni")
    var year = plural_unit(one="{n} an", few="{n} ani", other="{n} de ani")

    var newborn = stage_gendered("Nou-născut", "Nou-născută")
    var infant = stage_neutral("Sugar")
    var toddler = stage_neutral("Copil mic")
    var child = stage_neutral("Copil")
    var teenager = stage_gendered("Adolescent", "Adolescentă")
    var adult = stage_gendered("Adult", "Adultă")

    var short_ovr = CompactnessOverride()
    short_ovr.day = plural_unit(one="{n} zi", few="{n} zile", other="{n} zile")
    short_ovr.has_day = True
    short_ovr.week = simple_unit("{n} săpt.")
    short_ovr.has_week = True
    short_ovr.month = plural_unit(one="{n} lună", few="{n} luni", other="{n} luni")
    short_ovr.has_month = True
    short_ovr.year = plural_unit(one="{n} an", few="{n} ani", other="{n} ani")
    short_ovr.has_year = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.day = simple_unit("{n} z")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n} săpt.")
    compact_ovr.has_week = True
    compact_ovr.month = simple_unit("{n} l")
    compact_ovr.has_month = True
    compact_ovr.year = simple_unit("{n} a")
    compact_ovr.has_year = True
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="ro",
        plural_fn=_plural,
        day=day,
        week=week,
        month=month,
        year=year,
        half="{0} și jumătate",
        delimiter=", ",
        just_born="Nou-născut",
        newborn=newborn,
        infant=infant,
        toddler=toddler,
        child=child,
        teenager=teenager,
        adult=adult,
        short_override=short_ovr,
        has_short=True,
        compact_override=compact_ovr,
        has_compact=True,
    )
