fn _plural(n: Int) -> String:
    var mod10 = n % 10
    var mod100 = n % 100
    if mod10 == 1:
        return "one"
    if mod10 == 2:
        return "two"
    if mod100 == 0 or mod100 == 20 or mod100 == 40 or mod100 == 60 or mod100 == 80:
        return "few"
    return "other"


fn build_gv() -> AgeLocale:
    """Build the Manx locale."""

    var day = plural_unit(one="{n} laa", two="{n} laa", few="{n} laa", other="{n} laa")
    var week = plural_unit(one="{n} hiaghtin", two="{n} hiaghtin", few="{n} shiaghtin", other="{n} shiaghtin")
    var month = plural_unit(one="{n} vee", two="{n} vee", few="{n} mee", other="{n} mee")
    var year = plural_unit(one="{n} vlein", two="{n} vlein", few="{n} blein", other="{n} blein")

    var newborn = stage_neutral("Ruggit noa")
    var infant = stage_neutral("Oikanagh")
    var toddler = stage_neutral("Lhiannoo")
    var child = stage_neutral("Paitchey")
    var teenager = stage_neutral("Fer aeg")
    var adult = stage_neutral("Dooinney aasit")

    var short_ovr = CompactnessOverride()
    short_ovr.day = simple_unit("{n} d")
    short_ovr.has_day = True
    short_ovr.week = simple_unit("{n} wk")
    short_ovr.has_week = True
    short_ovr.month = simple_unit("{n} mo")
    short_ovr.has_month = True
    short_ovr.year = simple_unit("{n} yr")
    short_ovr.has_year = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.day = simple_unit("{n}d")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n}w")
    compact_ovr.has_week = True
    compact_ovr.month = simple_unit("{n}m")
    compact_ovr.has_month = True
    compact_ovr.year = simple_unit("{n}y")
    compact_ovr.has_year = True
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="gv",
        plural_fn=_plural,
        day=day,
        week=week,
        month=month,
        year=year,
        half="{0} as lieh",
