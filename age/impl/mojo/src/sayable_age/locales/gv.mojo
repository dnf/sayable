fn _plural(n: Int) -> String:
    var mod10 = n % 10
    var mod100 = n % 100
    if mod10 == 1:
        return "one"
    if mod10 == 2:
        return "two"
    if mod100 == 0 or mod100 == 20 or mod100 == 40 or mod100 == 60 or mod100 == 80:
        return "few"
    return "other"


