    """Build the Bosnian locale."""

    var units = Dict[String, UnitForms]()
    units["day"] = plural_unit(List[Tuple[String, String]](("one", "{n} dan"), ("few", "{n} dana"), ("many", "{n} dana"), ("other", "{n} dana")))
