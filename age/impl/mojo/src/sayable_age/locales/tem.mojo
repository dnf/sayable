    units["year"] = plural_unit(List[Tuple[String, String]](Tuple[String, String]("one", "əsor {n}"), Tuple[String, String]("other", "ɔsor {n}")))

    var stages = Dict[String, StageLabel]()
    stages["newborn"] = stage_neutral("A mabɔrn")
    stages["infant"] = stage_neutral("Kəbom")
    stages["toddler"] = stage_neutral("Kəbom")
    stages["child"] = stage_neutral("Ɔmɔnthɔ")
    stages["teenager"] = stage_neutral("Ɔkəranthɔ")
    stages["adult"] = stage_neutral("Ɔpa")

    var short_ovr = CompactnessOverride()
    var short_units = Dict[String, UnitForms]()
    short_units["day"] = plural_unit(List[Tuple[String, String]](Tuple[String, String]("one", "ləfɔr {n}"), Tuple[String, String]("other", "ɔfɔr {n}")))
    short_units["week"] = simple_unit("wik {n}")
    short_units["month"] = plural_unit(List[Tuple[String, String]](Tuple[String, String]("one", "kətha {n}"), Tuple[String, String]("other", "ɔtha {n}")))
    short_units["year"] = plural_unit(List[Tuple[String, String]](Tuple[String, String]("one", "əsor {n}"), Tuple[String, String]("other", "ɔsor {n}")))
    short_ovr.units = short_units^

    var compact_ovr = CompactnessOverride()
    var compact_units = Dict[String, UnitForms]()
    compact_units["day"] = simple_unit("{n}d")
    compact_units["week"] = simple_unit("{n}w")
    compact_units["month"] = simple_unit("{n}m")
    compact_units["year"] = simple_unit("{n}y")
    compact_ovr.units = compact_units^
