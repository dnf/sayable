    var year = plural_unit(one="mwaka {n}", other="myaka {n}")

    var newborn = stage_neutral("Mwana wa kubelekwa kwenda")
    var infant = stage_neutral("Mwana mdogo")
    var toddler = stage_neutral("Mwana wa kutembea")
    var child = stage_neutral("Mwana")
    var teenager = stage_neutral("Mhemba")
    var adult = stage_neutral("Muntu mkulu")

    var short_ovr = CompactnessOverride()
    short_ovr.day = plural_unit(one="isiku {n}", other="amasiku {n}")
    short_ovr.has_day = True
    short_ovr.week = plural_unit(one="ish. {n}", other="amash. {n}")
    short_ovr.has_week = True
    short_ovr.month = plural_unit(one="ngw. {n}", other="ngw. {n}")
    short_ovr.has_month = True
    short_ovr.year = plural_unit(one="mw. {n}", other="my. {n}")
    short_ovr.has_year = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.day = simple_unit("{n}d")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n}w")
