    var stages = Dict[String, StageLabel]()
    stages["newborn"] = stage_neutral("Mwana wa kubelekwa kwenda")
    stages["infant"] = stage_neutral("Mwana mdogo")
    stages["toddler"] = stage_neutral("Mwana wa kutembea")
    stages["child"] = stage_neutral("Mwana")
    stages["teenager"] = stage_neutral("Mhemba")
    stages["adult"] = stage_neutral("Muntu mkulu")

    var short_ovr = CompactnessOverride()
