    var toddler = stage_neutral("Väikelaps")
    var child = stage_neutral("Laps")
    var teenager = stage_neutral("Teismeline")
    var adult = stage_neutral("Täiskasvanu")

    var short_ovr = CompactnessOverride()
    short_ovr.day = plural_unit(one="{n} päev", other="{n} päeva")
    short_ovr.has_day = True
    short_ovr.week = simple_unit("{n} näd")
