"""Georgian locale."""

from ..locale import (
    AgeLocale,
    CompactnessOverride,
    StageLabel,
    UnitForms,
    simple_unit,
    plural_unit,
    stage_neutral,
    stage_gendered,
)


fn build_ka() -> AgeLocale:
    """Build the Georgian locale."""
    fn plural(n: Int) -> String:
        if n == 1:
            return "one"
        return "other"

    var units = Dict[String, UnitForms]()
    units["day"] = plural_unit(List[Tuple[String, String]](("one", "{n} დღე"), ("other", "{n} დღე")))
    units["week"] = plural_unit(List[Tuple[String, String]](("one", "{n} კვირა"), ("other", "{n} კვირა")))
    units["month"] = plural_unit(List[Tuple[String, String]](("one", "{n} თვე"), ("other", "{n} თვე")))
    units["year"] = plural_unit(List[Tuple[String, String]](("one", "{n} წელი"), ("other", "{n} წელი")))

    var stages = Dict[String, StageLabel]()
    stages["newborn"] = stage_neutral("ახალშობილი")
    stages["infant"] = stage_neutral("ჩვილი")
    stages["toddler"] = stage_neutral("პატარა ბავშვი")
    stages["child"] = stage_neutral("ბავშვი")
    stages["teenager"] = stage_neutral("მოზარდი")
    stages["adult"] = stage_neutral("ზრდასრული")

    var short_ovr = CompactnessOverride()
    var short_units = Dict[String, UnitForms]()
    short_units["day"] = simple_unit("{n} დღე")
    short_units["week"] = simple_unit("{n} კვრ")
    short_units["month"] = simple_unit("{n} თვე")
    short_units["year"] = simple_unit("{n} წ")
    short_ovr.units = short_units

    var compact_ovr = CompactnessOverride()
    var compact_units = Dict[String, UnitForms]()
    compact_units["day"] = simple_unit("{n} დღე")
    compact_units["week"] = simple_unit("{n} კვრ")
    compact_units["month"] = simple_unit("{n} თვე")
    compact_units["year"] = simple_unit("{n} წ")
    compact_ovr.units = compact_units
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="ka",
        plural_fn=plural,
        units=units,
        half="{0} და ნახევარი",
        delimiter=", ",
        just_born="ახალშობილი",
        stages=stages,
        short_override=short_ovr,
        has_short=True,
        compact_override=compact_ovr,
        has_compact=True,
    )
