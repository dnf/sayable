fn build_ka() -> AgeLocale:
    """Build the Georgian locale."""
    fn plural(n: Int) -> String:
        if n == 1:
            return "one"
        return "other"

    var day = plural_unit(one="{n} დღე", other="{n} დღე")
    var week = plural_unit(one="{n} კვირა", other="{n} კვირა")
    var month = plural_unit(one="{n} თვე", other="{n} თვე")
    var year = plural_unit(one="{n} წელი", other="{n} წელი")

    var newborn = stage_neutral("ახალშობილი")
    var infant = stage_neutral("ჩვილი")
    var toddler = stage_neutral("პატარა ბავშვი")
    var child = stage_neutral("ბავშვი")
    var teenager = stage_neutral("მოზარდი")
    var adult = stage_neutral("ზრდასრული")

    var short_ovr = CompactnessOverride()
    short_ovr.day = simple_unit("{n} დღე")
    short_ovr.has_day = True
    short_ovr.week = simple_unit("{n} კვრ")
    short_ovr.has_week = True
    short_ovr.month = simple_unit("{n} თვე")
    short_ovr.has_month = True
    short_ovr.year = simple_unit("{n} წ")
    short_ovr.has_year = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.day = simple_unit("{n} დღე")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n} კვრ")
    compact_ovr.has_week = True
    compact_ovr.month = simple_unit("{n} თვე")
    compact_ovr.has_month = True
    compact_ovr.year = simple_unit("{n} წ")
    compact_ovr.has_year = True
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="ka",
        plural_fn=plural,
        day=day,
        week=week,
        month=month,
        year=year,
        half="{0} და ნახევარი",
        delimiter=", ",
        just_born="ახალშობილი",
