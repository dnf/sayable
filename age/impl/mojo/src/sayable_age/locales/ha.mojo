"""Hausa locale."""

from ..locale import (
    AgeLocale,
    CompactnessOverride,
    StageLabel,
    UnitForms,
    simple_unit,
    plural_unit,
    stage_neutral,
    stage_gendered,
)


fn build_ha() -> AgeLocale:
    """Build the Hausa locale."""
    fn plural(n: Int) -> String:
        if n == 1:
            return "one"
        return "other"

    var day = plural_unit(one="kwana {n}", other="kwanaki {n}")
    var week = plural_unit(one="mako {n}", other="makonni {n}")
    var month = plural_unit(one="wata {n}", other="watanni {n}")
    var year = plural_unit(one="shekara {n}", other="shekaru {n}")

    var newborn = stage_neutral("Jariri")
    var infant = stage_neutral("Jariri")
    var toddler = stage_gendered("Ƙaramin yaro", "Ƙaramar yarinya")
    var child = stage_gendered("Yaro", "Yarinya")
    var teenager = stage_gendered("Saurayi", "Budurwa")
    var adult = stage_neutral("Babba")

    var short_ovr = CompactnessOverride()
    short_ovr.day = simple_unit("kw. {n}")
    short_ovr.has_day = True
    short_ovr.week = simple_unit("mk. {n}")
    short_ovr.has_week = True
    short_ovr.month = simple_unit("wt. {n}")
    short_ovr.has_month = True
    short_ovr.year = simple_unit("shk. {n}")
    short_ovr.has_year = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.day = simple_unit("{n}d")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n}w")
    compact_ovr.has_week = True
    compact_ovr.month = simple_unit("{n}m")
    compact_ovr.has_month = True
    compact_ovr.year = simple_unit("{n}y")
    compact_ovr.has_year = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True

    return AgeLocale(
        code="ha",
        plural_fn=plural,
        day=day,
        week=week,
        month=month,
        year=year,
        half="{n}½",
        delimiter=", ",
        just_born="Sabon haihuwa",
        newborn=newborn,
        infant=infant,
        toddler=toddler,
        child=child,
        teenager=teenager,
        adult=adult,
        short_override=short_ovr,
        has_short=True,
        compact_override=compact_ovr,
        has_compact=True,
    )
