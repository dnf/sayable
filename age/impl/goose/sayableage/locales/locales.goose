enum PluralRule { Ar, Br, CsSk, Cy, Ga, Gd, Gv, He, Kw, Lt, Lv, Mk, Mt, OneOther, OneOtherZeroOne, OtherOnly, Pl, Ro, RuUk, Shi, Sl, SlavicBcs, Tzm }

fn plural_ar(n: i64) -> PluralCategory {
    if n == 0 { return PluralCategory.Zero; }
    if n == 1 { return PluralCategory.One; }
    if n == 2 { return PluralCategory.Two; }
    let mod100 = n % 100;
    if mod100 >= 3 && mod100 <= 10 { return PluralCategory.Few; }
    if mod100 >= 11 && mod100 <= 99 { return PluralCategory.Many; }
    return PluralCategory.Other;
}

fn plural_br(n: i64) -> PluralCategory {
    let mod10 = n % 10;
    let mod100 = n % 100;
    if mod10 == 1 && mod100 != 11 && mod100 != 71 && mod100 != 91 { return PluralCategory.One; }
    if mod10 == 2 && mod100 != 12 && mod100 != 72 && mod100 != 92 { return PluralCategory.Two; }
    if (mod10 == 3 || mod10 == 4 || mod10 == 9) && (mod100 < 10 || mod100 > 19) && (mod100 < 70 || mod100 > 79) && (mod100 < 90 || mod100 > 99) { return PluralCategory.Few; }
    if n != 0 && n % 1000000 == 0 { return PluralCategory.Many; }
    return PluralCategory.Other;
}

fn plural_cs_sk(n: i64) -> PluralCategory {
    if n == 1 { return PluralCategory.One; }
    if n >= 2 && n <= 4 { return PluralCategory.Few; }
    return PluralCategory.Other;
}

fn plural_cy(n: i64) -> PluralCategory {
    if n == 0 { return PluralCategory.Zero; }
    if n == 1 { return PluralCategory.One; }
    if n == 2 { return PluralCategory.Two; }
    if n == 3 { return PluralCategory.Few; }
    if n == 6 { return PluralCategory.Many; }
    return PluralCategory.Other;
}

fn plural_ga(n: i64) -> PluralCategory {
    if n == 1 { return PluralCategory.One; }
    if n == 2 { return PluralCategory.Two; }
    if n >= 3 && n <= 6 { return PluralCategory.Few; }
    if n >= 7 && n <= 10 { return PluralCategory.Many; }
    return PluralCategory.Other;
}

fn plural_gd(n: i64) -> PluralCategory {
    if n == 1 || n == 11 { return PluralCategory.One; }
    if n == 2 || n == 12 { return PluralCategory.Two; }
    if (n >= 3 && n <= 10) || (n >= 13 && n <= 19) { return PluralCategory.Few; }
    return PluralCategory.Other;
}

fn plural_gv(n: i64) -> PluralCategory {
    let mod10 = n % 10;
    let mod100 = n % 100;
    if mod10 == 1 { return PluralCategory.One; }
    if mod10 == 2 { return PluralCategory.Two; }
    if mod100 == 0 || mod100 == 20 || mod100 == 40 || mod100 == 60 || mod100 == 80 { return PluralCategory.Few; }
    return PluralCategory.Other;
}

fn plural_he(n: i64) -> PluralCategory {
    if n == 1 { return PluralCategory.One; }
    if n == 2 { return PluralCategory.Two; }
    return PluralCategory.Other;
}

fn plural_kw(n: i64) -> PluralCategory {
    if n == 0 { return PluralCategory.Zero; }
    if n == 1 { return PluralCategory.One; }
    let mod100 = n % 100;
    if mod100 == 2 || mod100 == 22 || mod100 == 42 || mod100 == 62 || mod100 == 82 { return PluralCategory.Two; }
    if mod100 == 3 || mod100 == 23 || mod100 == 43 || mod100 == 63 || mod100 == 83 { return PluralCategory.Few; }
    if n != 1 && (mod100 == 1 || mod100 == 21 || mod100 == 41 || mod100 == 61 || mod100 == 81) { return PluralCategory.Many; }
    return PluralCategory.Other;
}

fn plural_lt(n: i64) -> PluralCategory {
    let mod10 = n % 10;
    let mod100 = n % 100;
    if mod10 == 1 && mod100 != 11 { return PluralCategory.One; }
    if mod10 >= 2 && mod10 <= 9 && (mod100 < 12 || mod100 > 19) { return PluralCategory.Few; }
    return PluralCategory.Other;
}

fn plural_lv(n: i64) -> PluralCategory {
    let mod10 = n % 10;
    let mod100 = n % 100;
    if mod10 == 0 || (mod100 >= 11 && mod100 <= 19) { return PluralCategory.Zero; }
    if mod10 == 1 && mod100 != 11 { return PluralCategory.One; }
    return PluralCategory.Other;
}

fn plural_mk(n: i64) -> PluralCategory {
    let mod10 = n % 10;
    let mod100 = n % 100;
    if mod10 == 1 && mod100 != 11 { return PluralCategory.One; }
    return PluralCategory.Other;
}

fn plural_mt(n: i64) -> PluralCategory {
    if n == 1 { return PluralCategory.One; }
    if n == 2 { return PluralCategory.Two; }
    let mod100 = n % 100;
    if n == 0 || (mod100 >= 3 && mod100 <= 10) { return PluralCategory.Few; }
    if mod100 >= 11 && mod100 <= 19 { return PluralCategory.Many; }
    return PluralCategory.Other;
}

fn plural_one_other(n: i64) -> PluralCategory {
    if n == 1 { return PluralCategory.One; }
    return PluralCategory.Other;
}

fn plural_one_other_zero_one(n: i64) -> PluralCategory {
    if n == 0 || n == 1 { return PluralCategory.One; }
    return PluralCategory.Other;
}

fn plural_other_only(n: i64) -> PluralCategory {
    return PluralCategory.Other;
}

fn plural_pl(n: i64) -> PluralCategory {
    if n == 1 { return PluralCategory.One; }
    let mod10 = n % 10;
    let mod100 = n % 100;
    if mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14) { return PluralCategory.Few; }
    return PluralCategory.Many;
}

fn plural_ro(n: i64) -> PluralCategory {
    if n == 1 { return PluralCategory.One; }
    if n == 0 || (n % 100 >= 1 && n % 100 <= 19) { return PluralCategory.Few; }
    return PluralCategory.Other;
}

fn plural_ru_uk(n: i64) -> PluralCategory {
    let mod10 = n % 10;
    let mod100 = n % 100;
    if mod10 == 1 && mod100 != 11 { return PluralCategory.One; }
    if mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14) { return PluralCategory.Few; }
    return PluralCategory.Many;
}

fn plural_shi(n: i64) -> PluralCategory {
    if n == 0 || n == 1 { return PluralCategory.One; }
    if n >= 2 && n <= 10 { return PluralCategory.Few; }
    return PluralCategory.Other;
}

fn plural_sl(n: i64) -> PluralCategory {
    let mod100 = n % 100;
    if mod100 == 1 { return PluralCategory.One; }
    if mod100 == 2 { return PluralCategory.Two; }
    if mod100 == 3 || mod100 == 4 { return PluralCategory.Few; }
    return PluralCategory.Other;
}

fn plural_slavic_bcs(n: i64) -> PluralCategory {
    let mod10 = n % 10;
    let mod100 = n % 100;
    if mod10 == 1 && mod100 != 11 { return PluralCategory.One; }
    if mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14) { return PluralCategory.Few; }
    return PluralCategory.Other;
}

fn plural_tzm(n: i64) -> PluralCategory {
    if n == 0 || n == 1 || (n >= 11 && n <= 99) { return PluralCategory.One; }
    return PluralCategory.Other;
}

fn plural_category(rule: PluralRule, n: i64) -> PluralCategory {
    match rule {
        Ar => plural_ar(n),
        Br => plural_br(n),
        CsSk => plural_cs_sk(n),
        Cy => plural_cy(n),
        Ga => plural_ga(n),
        Gd => plural_gd(n),
        Gv => plural_gv(n),
        He => plural_he(n),
        Kw => plural_kw(n),
        Lt => plural_lt(n),
        Lv => plural_lv(n),
        Mk => plural_mk(n),
        Mt => plural_mt(n),
        OneOther => plural_one_other(n),
        OneOtherZeroOne => plural_one_other_zero_one(n),
        OtherOnly => plural_other_only(n),
        Pl => plural_pl(n),
        Ro => plural_ro(n),
        RuUk => plural_ru_uk(n),
        Shi => plural_shi(n),
        Sl => plural_sl(n),
        SlavicBcs => plural_slavic_bcs(n),
