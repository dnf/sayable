IDENTIFICATION DIVISION.
PROGRAM-ID. TEST-PARENT-TIME.

DATA DIVISION.
WORKING-STORAGE SECTION.

*> Command-line argument handling
 01 WS-ARG-COUNT            PIC 9(4).
 01 WS-RUN-ID               PIC X(20).

*> Test counters
 01 WS-TESTS-PASSED         PIC 9(4) VALUE 0.
 01 WS-TESTS-FAILED         PIC 9(4) VALUE 0.

*> Test working variables
 01 WS-TEST-NAME            PIC X(60).
 01 WS-TEST-EXPECTED        PIC X(256).
 01 WS-TEST-SUBSTR          PIC X(256).
 01 WS-SUBSTR-POS           PIC 9(4).
 01 WS-TEST-GOT-LEN         PIC 9(4).

*> Date-of-birth derivation for the default-asOf tests
 01 WS-OFFSET-YEARS         PIC 9(3).
 01 WS-OFFSET-DAYS          PIC 9(3).
 01 WS-NOW-DATE             PIC 9(8).
 01 WS-DOB-NUM              PIC 9(8).
 01 WS-DOB-PARTS REDEFINES WS-DOB-NUM.
     05 WS-DOB-PART-YEAR    PIC 9(4).
     05 WS-DOB-PART-MONTH   PIC 9(2).
     05 WS-DOB-PART-DAY     PIC 9(2).
 01 WS-DOB-INT              PIC 9(8).
 01 WS-DOB-OUT.
     05 WS-DOB-OUT-YEAR     PIC 9(4).
     05 FILLER              PIC X VALUE "-".
     05 WS-DOB-OUT-MONTH    PIC 9(2).
     05 FILLER              PIC X VALUE "-".
     05 WS-DOB-OUT-DAY      PIC 9(2).

COPY "src/Types.cbl".

PROCEDURE DIVISION.
MAIN-PROGRAM.
    ACCEPT WS-ARG-COUNT FROM ARGUMENT-NUMBER
    IF WS-ARG-COUNT > 0
        DISPLAY 1 UPON ARGUMENT-NUMBER
        ACCEPT WS-RUN-ID FROM ARGUMENT-VALUE
    ELSE
        MOVE SPACES TO WS-RUN-ID
    END-IF

    IF WS-RUN-ID = SPACES
        PERFORM RUN-ALL-TESTS
    ELSE
        PERFORM DISPATCH-TEST
    END-IF

    DISPLAY " "
    DISPLAY "=== Results ==="
    DISPLAY "Passed: " FUNCTION TRIM(WS-TESTS-PASSED)
    DISPLAY "Failed: " FUNCTION TRIM(WS-TESTS-FAILED)

    IF WS-TESTS-FAILED > 0
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.
*> ============================================================
*> Assert helpers
*> ============================================================
ASSERT-EQ.
    IF FUNCTION TRIM(WS-FORMAT-RESULT) =
       FUNCTION TRIM(WS-TEST-EXPECTED)
        ADD 1 TO WS-TESTS-PASSED
    ELSE
        ADD 1 TO WS-TESTS-FAILED
        DISPLAY "FAIL [" FUNCTION TRIM(WS-TEST-NAME)
            "]: got """ FUNCTION TRIM(WS-FORMAT-RESULT)
            """, expected """ FUNCTION TRIM(WS-TEST-EXPECTED)
            """"
    END-IF
    .

ASSERT-STAGE-EQ.
    IF FUNCTION TRIM(WS-STAGE-RESULT) =
       FUNCTION TRIM(WS-TEST-EXPECTED)
        ADD 1 TO WS-TESTS-PASSED
    ELSE
        ADD 1 TO WS-TESTS-FAILED
        DISPLAY "FAIL [" FUNCTION TRIM(WS-TEST-NAME)
            "]: got """ FUNCTION TRIM(WS-STAGE-RESULT)
            """, expected """ FUNCTION TRIM(WS-TEST-EXPECTED)
            """"
    END-IF
    .

ASSERT-NULL.
    IF FUNCTION TRIM(WS-FORMAT-RESULT) = SPACES
        ADD 1 TO WS-TESTS-PASSED
    ELSE
        ADD 1 TO WS-TESTS-FAILED
        DISPLAY "FAIL [" FUNCTION TRIM(WS-TEST-NAME)
            "]: expected empty, got """
            FUNCTION TRIM(WS-FORMAT-RESULT) """"
    END-IF
    .

ASSERT-STAGE-NULL.
    IF FUNCTION TRIM(WS-STAGE-RESULT) = SPACES
        ADD 1 TO WS-TESTS-PASSED
    ELSE
        ADD 1 TO WS-TESTS-FAILED
        DISPLAY "FAIL [" FUNCTION TRIM(WS-TEST-NAME)
            "]: expected empty, got """
            FUNCTION TRIM(WS-STAGE-RESULT) """"
    END-IF
    .

ASSERT-CONTAINS.
    MOVE 0 TO WS-SUBSTR-POS
    INSPECT FUNCTION TRIM(WS-FORMAT-RESULT)
        TALLYING WS-SUBSTR-POS
        FOR CHARACTERS BEFORE INITIAL
        FUNCTION TRIM(WS-TEST-SUBSTR)
    MOVE FUNCTION LENGTH(
        FUNCTION TRIM(WS-FORMAT-RESULT))
        TO WS-TEST-GOT-LEN
    IF WS-SUBSTR-POS < WS-TEST-GOT-LEN
        ADD 1 TO WS-TESTS-PASSED
    ELSE
        ADD 1 TO WS-TESTS-FAILED
        DISPLAY "FAIL [" FUNCTION TRIM(WS-TEST-NAME)
            "]: """ FUNCTION TRIM(WS-FORMAT-RESULT)
            """ does not contain """
            FUNCTION TRIM(WS-TEST-SUBSTR) """"
    END-IF
    .

ASSERT-NOT-EMPTY.
    IF FUNCTION TRIM(WS-FORMAT-RESULT) NOT = SPACES
        ADD 1 TO WS-TESTS-PASSED
    ELSE
        ADD 1 TO WS-TESTS-FAILED
        DISPLAY "FAIL [" FUNCTION TRIM(WS-TEST-NAME)
            "]: expected non-empty result"
    END-IF
    .

ASSERT-STAGE-NOT-EMPTY.
    IF FUNCTION TRIM(WS-STAGE-RESULT) NOT = SPACES
        ADD 1 TO WS-TESTS-PASSED
    ELSE
        ADD 1 TO WS-TESTS-FAILED
        DISPLAY "FAIL [" FUNCTION TRIM(WS-TEST-NAME)
            "]: expected non-empty stage result"
    END-IF
    .
