*> Default asOf: dateOfBirth is derived from the local current date,
*> because the library reads the clock when WS-FMT-AS-OF is blank.
MAKE-DOB-FROM-TODAY.
    MOVE FUNCTION CURRENT-DATE(1:8) TO WS-NOW-DATE
    MOVE WS-NOW-DATE TO WS-DOB-NUM
    SUBTRACT WS-OFFSET-YEARS FROM WS-DOB-PART-YEAR
    IF WS-DOB-PART-MONTH = 2 AND WS-DOB-PART-DAY = 29
        MOVE 28 TO WS-DOB-PART-DAY
    END-IF
    COMPUTE WS-DOB-INT =
        FUNCTION INTEGER-OF-DATE(WS-DOB-NUM) - WS-OFFSET-DAYS
    MOVE FUNCTION DATE-OF-INTEGER(WS-DOB-INT) TO WS-DOB-NUM
    MOVE WS-DOB-PART-YEAR TO WS-DOB-OUT-YEAR
    MOVE WS-DOB-PART-MONTH TO WS-DOB-OUT-MONTH
    MOVE WS-DOB-PART-DAY TO WS-DOB-OUT-DAY
    MOVE WS-DOB-OUT TO WS-FMT-DOB
    MOVE SPACES TO WS-FMT-AS-OF
    MOVE 0 TO WS-FMT-AS-OF-LEN
    MOVE 0 TO WS-FMT-DOB-LEN
    .

