    gnupg \
    gprbuild \
    ldc \
    libc6-dev \
    libcurl4-openssl-dev \
    libedit2 \
    libevent-dev \
    libgmp-dev \
    libicu-dev \
    liblua5.4-dev \
    libncurses-dev \
    libpcre2-dev \
    libpython3-dev \
    libsqlite3-0 \
    libssl-dev \
    libxml2-dev \
    libyaml-dev \
    libz3-dev \
    lua5.4 \
    luarocks \
    make \
    octave \
    opam \
    perl \
    php-cli \
    php-mbstring \
    php-xml \
    pkg-config \
    python3 \
    python3-venv \
    r-base \
    r-cran-testthat \
    racket \
    rakudo \
    rebar3 \
    rlwrap \
