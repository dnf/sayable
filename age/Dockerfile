      rm -f /tmp/jdk.tar.gz; \
    fi && \
    { [ -e /usr/lib/jvm/hecatron-default ] || ln -s "temurin-$1" /usr/lib/jvm/hecatron-default; }
RUN ARCH="$(dpkg --print-architecture | sed 's/amd64/x64/;s/arm64/aarch64/')" && \
