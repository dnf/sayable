# sayable-time task runner: this library only. Run `just --list`.
#
# Per-language runs go through hecatron (https://github.com/dnf/hecatron),
# limited to this library with `-c time`; the root justfile covers all four
# libraries and everything else.

python := if `which python3 2>/dev/null || true` != "" { "python3" } else { "python" }

# Run this library's tests in every language, or the languages named
[group('test')]
test *args:
    hecatron test -c time {{args}}

# Lint this library in every language that has a linter, or the languages named
[group('lint')]
lint *args:
    hecatron lint -c time {{args}}

# Build this library in every compiled language, or the languages named
[group('build')]
build *args:
    hecatron build -c time {{args}}

# Remove this library's build artifacts
[group('build')]
clean *args:
    hecatron clean -c time {{args}}

# Generate locale files from JSON
[group('codegen')]
generate *target:
    #!/usr/bin/env bash
    set -euo pipefail
    _target="{{target}}"
    if [ "${_target}" = "help" ] || [ "${_target}" = "--help" ]; then
        printf '%s\n' \
            "Usage: just generate locales" \
            "" \
            "Generate locale source files from JSON definitions." \
            "" \
            "Targets:" \
            "  locales    Regenerate all locale files" \
            "" \
            "Examples:" \
            "  just generate locales"
        exit 0
    fi
    case "${_target}" in
        locales)
            {{python}} -m codegen.generate
            ;;
        *)
            echo "Unknown target '${_target}'. Try 'just generate help'." >&2
            exit 1
            ;;
    esac

# Verify generated files are current
[group('codegen')]
check:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> Checking codegen is current"
    {{python}} -m codegen.generate --check
    echo ""
    echo "==> Checking locale docs are current"
    (cd .. && {{python}} tools/generate_locale_docs.py --check)
