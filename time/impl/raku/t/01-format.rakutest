use v6.d;
use Test;
use lib 'lib';
use SayableTime::Formatter;
use SayableTime::Locales::Registry;

# Canonical cases from time/config/tests.json. All tests use explicit inputs for determinism.

# ================================================================
# Sections 9-10: minutes in short/compact, input validation
# ================================================================
# 9.1
is SayableTime::Formatter.new(SayableTime::Locales::Registry::get-locale('en'), compactness => 'short').format-time('18:01'), '6:01 PM', '9.1 digital modes keep the exact minute';
# 9.2
is SayableTime::Formatter.new(SayableTime::Locales::Registry::get-locale('en'), compactness => 'compact').format-time('19:05'), '7:05p', '9.2 digital modes keep the exact minute';
# 10.1
is SayableTime::Formatter.new(SayableTime::Locales::Registry::get-locale('en')).format-time('9:30'), 'half past nine', '10.1 one-digit hour';
# 10.2
is SayableTime::Formatter.new(SayableTime::Locales::Registry::get-locale('en')).format-time('09:30'), 'half past nine', '10.2 two-digit hour';
# 10.3
ok !defined(SayableTime::Formatter.new(SayableTime::Locales::Registry::get-locale('en')).format-time(' 9:30')), '10.3 leading whitespace';
# 10.4
ok !defined(SayableTime::Formatter.new(SayableTime::Locales::Registry::get-locale('en')).format-time('9:30 ')), '10.4 trailing whitespace';
# 10.5
ok !defined(SayableTime::Formatter.new(SayableTime::Locales::Registry::get-locale('en')).format-time('9:5')), '10.5 minutes need two digits';
# 10.6
ok !defined(SayableTime::Formatter.new(SayableTime::Locales::Registry::get-locale('en')).format-time('24:00')), '10.6 hour out of range';
# 10.7
is SayableTime::Formatter.new(SayableTime::Locales::Registry::get-locale('en')).format-time('14:15:30'), 'a quarter past two', '10.7 seconds are allowed and ignored';
# 10.8
is SayableTime::Formatter.new(SayableTime::Locales::Registry::get-locale('en')).format-time('2025-01-15T14:15:00Z'), 'a quarter past two', '10.8 ISO datetime with zone suffix (ignored)';
# 10.9
ok !defined(SayableTime::Formatter.new(SayableTime::Locales::Registry::get-locale('en')).format-time('2025-02-30T14:15:00')), '10.9 ISO datetime with an impossible date';

done-testing;
