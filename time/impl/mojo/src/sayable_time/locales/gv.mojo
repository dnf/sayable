    var pattern5 = "queig minnidyn lurg {h}"
    var pattern10 = "jeih minnidyn lurg {h}"
    var pattern15 = "kerroo lurg {h}"
    var pattern20 = "feed minnid lurg {h}"
    var pattern25 = "queig minnidyn as feed lurg {h}"
    var pattern30 = "lieh-oor lurg {h}"
    var pattern35 = "queig minnidyn as feed gys {next_h}"
    var pattern40 = "feed minnid gys {next_h}"
    var pattern45 = "kerroo gys {next_h}"
