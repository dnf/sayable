// Source: locales/zdj.json
fn locale_zdj() -> TimeLocale {
    TimeLocale {
        code: "zdj",
        clock: ClockConfig {
            hours: ["kumi na mbili", "moja", "mbili", "tatu", "nne", "tano", "sita", "saba", "nane", "tisa", "kumi", "kumi na moja"],
            midnight: "usiku wa manane",
            noon: "adhuhuri",
            patterns: ["{h}:00", "{h}:05", "{h}:10", "{h}:15", "{h}:20", "{h}:25", "{h}:30", "{h}:35", "{h}:40", "{h}:45", "{h}:50", "{h}:55"],
        },
        short_override: CompactnessOverride { has_clock: true, clock: ShortClockConfig { use_24h: false, format: "{h}:{mm} {ampm}", am_pm: ["AM", "PM"] } },
        compact_override: CompactnessOverride { has_clock: true, clock: ShortClockConfig { use_24h: false, format: "{h}:{mm}{ampm}", am_pm: ["a", "p"] } },
    }
}

// Source: locales/zh.json
fn locale_zh() -> TimeLocale {
    TimeLocale {
        code: "zh",
        clock: ClockConfig {
            hours: ["十二", "一", "二", "三", "四", "五", "六", "七", "八", "九", "十", "十一"],
            midnight: "午夜",
            noon: "正午",
            patterns: ["{h}点整", "{h}点五分", "{h}点十分", "{h}点十五分", "{h}点二十分", "{h}点二十五分", "{h}点半", "{h}点三十五分", "{h}点四十分", "{h}点四十五分", "{h}点五十分", "{h}点五十五分"],
        },
        short_override: CompactnessOverride { has_clock: true, clock: ShortClockConfig { use_24h: true, format: "{h}:{mm}" } },
