        },
        short_override: CompactnessOverride { has_clock: true, clock: ShortClockConfig { use_24h: false, format: "{h}:{mm} {ampm}", am_pm: ["AM", "PM"] } },
        compact_override: CompactnessOverride { has_clock: true, clock: ShortClockConfig { use_24h: false, format: "{h}:{mm}{ampm}", am_pm: ["a", "p"] } },
    }
}

