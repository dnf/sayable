# sayable-duration task runner
# Run `just --list` to see all available commands.

python := if `which python3 2>/dev/null || true` != "" { "python3" } else { "python" }

_runner := "../.hecatron/tools/runner/run-parallel.sh"

# Resolve abbreviation to full language name
[private]
[no-exit-message]
_name target:
    #!/usr/bin/env bash
    case "{{target}}" in
        c++|cpp)       echo "cpp" ;;
        clj|clojure)   echo "clojure" ;;
        cs|csharp)     echo "csharp" ;;
        fs|fsharp)     echo "fsharp" ;;
        go)            echo "go" ;;
        hs|haskell)    echo "haskell" ;;
        java)          echo "java" ;;
        kt|kotlin)     echo "kotlin" ;;
        lua)           echo "lua" ;;
        php)           echo "php" ;;
        py|python)     echo "python" ;;
        rb|ruby)       echo "ruby" ;;
        rs|rust)       echo "rust" ;;
        sc|scala)      echo "scala" ;;
        ts|typescript) echo "typescript" ;;
        *)             echo "{{target}}" ;;
    esac

# Run test suites + codegen check
[group('test')]
test *target:
    #!/usr/bin/env bash
    set -euo pipefail
    _jflag=""; _sflag=""; _target=""; _prev=""
    for _a in {{target}}; do
        if [ "${_prev}" = "-j" ]; then _jflag="${_a}"; _prev=""; continue; fi
        if [ "${_prev}" = "-s" ]; then _sflag="${_a}"; _prev=""; continue; fi
        if [ "${_a}" = "-j" ]; then _prev="-j"; continue; fi
        if [ "${_a}" = "-s" ]; then _prev="-s"; continue; fi
        _target="${_target:+${_target} }${_a}"
    done
    if [ "${_target}" = "help" ] || [ "${_target}" = "--help" ]; then
        printf '%s\n' \
            "Usage: just test [flags] [target]" \
            "" \
            "Run all test suites + codegen check in parallel, or a single target." \
            "" \
            "Languages:" \
            "  c++ (cpp)        C++ tests via cmake/ctest" \
            "  clojure (clj)    Clojure tests via Cognitect runner" \
            "  csharp (cs)      C# tests via dotnet test" \
            "  fsharp (fs)      F# tests via dotnet test" \
            "  go               Go tests via go test" \
            "  haskell (hs)     Haskell tests via cabal test" \
            "  java             Java tests via Gradle" \
            "  kotlin (kt)      Kotlin tests via Gradle" \
            "  lua              Lua tests via busted" \
            "  php              PHP tests via PHPUnit" \
            "  python (py)      Python tests via pytest" \
            "  ruby (rb)        Ruby tests via ruby" \
            "  rust (rs)        Rust tests via cargo" \
            "  scala (sc)       Scala tests via Gradle" \
            "  typescript (ts)  TypeScript tests via vitest" \
            "" \
            "Flags:" \
            "  -j VALUE   Set concurrency: integer, percentage, or 'unlimited'" \
            "  -s MODE    Visualization: scroll (default), full, or zoom" \
            "" \
            "Examples:" \
            "  just test        Run all test suites + codegen check in parallel" \
            "  just test py     Run Python tests only" \
            "  just test go     Run Go tests only"
        exit 0
    fi
    if [ -z "${_target}" ]; then
        {{_runner}} ${_jflag:+-j "${_jflag}"} ${_sflag:+-s "${_sflag}"} test \
            "check" \
            "test cpp" \
            "test clojure" \
            "test csharp" \
            "test fsharp" \
            "test go" \
            "test haskell" \
            "test java" \
            "test kotlin" \
            "test lua" \
            "test php" \
            "test python" \
            "test ruby" \
            "test rust" \
            "test scala" \
            "test typescript"
    else
        _name="$(just _name "${_target}")"
        mkdir -p .logs/test
        (
            case "${_target}" in
                c++|cpp)
                    cd impl/cpp && cmake -B build -DCMAKE_BUILD_TYPE=Release 2>&1 && cmake --build build 2>&1 && cd build && ctest --output-on-failure
                    ;;
                clojure|clj)
                    cd impl/clojure && clojure -X:test
                    ;;
                csharp|cs)
                    cd impl/csharp && dotnet test
                    ;;
                fsharp|fs)
                    cd impl/fsharp && dotnet test
                    ;;
                go)
                    cd impl/go && go test ./...
                    ;;
                haskell|hs)
                    cd impl/haskell && cabal test
                    ;;
                java)
                    cd impl/java && ./gradlew test
                    ;;
                kotlin|kt)
                    cd impl/kotlin && ./gradlew test
                    ;;
                lua)
                    cd impl/lua && busted test_sayableduration.lua
                    ;;
                php)
                    cd impl/php && vendor/bin/phpunit
                    ;;
                python|py)
                    cd impl/python && uv run --extra dev python -m pytest tests/
                    ;;
                ruby|rb)
                    cd impl/ruby && ruby -Ilib test/test_formatter.rb
                    ;;
                rust|rs)
                    cd impl/rust && cargo test
                    ;;
                scala|sc)
                    cd impl/scala && ./gradlew test
                    ;;
                typescript|ts)
                    cd impl/typescript && npx vitest run
                    ;;
                *)
                    echo "Unknown target '${_target}'. Try 'just test help'." >&2
                    exit 1
                    ;;
            esac
        ) 2>&1 | tee ".logs/test/${_name}.log"
    fi

# Build artifacts
[group('build')]
build *target:
    #!/usr/bin/env bash
    set -euo pipefail
    _jflag=""; _sflag=""; _target=""; _prev=""
    for _a in {{target}}; do
        if [ "${_prev}" = "-j" ]; then _jflag="${_a}"; _prev=""; continue; fi
        if [ "${_prev}" = "-s" ]; then _sflag="${_a}"; _prev=""; continue; fi
        if [ "${_a}" = "-j" ]; then _prev="-j"; continue; fi
        if [ "${_a}" = "-s" ]; then _prev="-s"; continue; fi
        _target="${_target:+${_target} }${_a}"
    done
    if [ "${_target}" = "help" ] || [ "${_target}" = "--help" ]; then
        printf '%s\n' \
            "Usage: just build [flags] [target]" \
            "" \
            "Build all targets in parallel, or a single target." \
            "" \
            "Languages:" \
            "  c++ (cpp)        Build via cmake" \
            "  clojure (clj)    No-op (interpreted)" \
            "  csharp (cs)      Build via dotnet build" \
            "  fsharp (fs)      Build via dotnet build" \
            "  go               Build via go build" \
            "  haskell (hs)     Build via cabal build" \
            "  java             Build via Gradle" \
            "  kotlin (kt)      Build via Gradle" \
            "  lua              No-op (interpreted)" \
            "  php              No-op (interpreted)" \
            "  python (py)      No-op (pure Python)" \
            "  ruby (rb)        No-op (interpreted)" \
            "  rust (rs)        Build via cargo" \
            "  scala (sc)       Build via Gradle" \
            "  typescript (ts)  Build via tsup" \
            "" \
            "Flags:" \
            "  -j VALUE   Set concurrency: integer, percentage, or 'unlimited'" \
            "  -s MODE    Visualization: scroll (default), full, or zoom" \
            "" \
            "Examples:" \
            "  just build       Build all targets in parallel" \
            "  just build rs    Build Rust only"
        exit 0
    fi
    if [ -z "${_target}" ]; then
        {{_runner}} ${_jflag:+-j "${_jflag}"} ${_sflag:+-s "${_sflag}"} build \
            "build cpp" \
            "build clojure" \
            "build csharp" \
            "build fsharp" \
            "build go" \
            "build haskell" \
            "build java" \
            "build kotlin" \
            "build lua" \
            "build php" \
            "build python" \
            "build ruby" \
            "build rust" \
            "build scala" \
            "build typescript"
    else
        _name="$(just _name "${_target}")"
        mkdir -p .logs/build
        (
            case "${_target}" in
                c++|cpp)
                    cd impl/cpp && cmake -B build -DCMAKE_BUILD_TYPE=Release 2>&1 && cmake --build build 2>&1
                    ;;
                clojure|clj)
                    echo "No build step needed — interpreted language."
                    ;;
                csharp|cs)
                    cd impl/csharp && dotnet build
                    ;;
                fsharp|fs)
                    cd impl/fsharp && dotnet build
                    ;;
                go)
                    cd impl/go && go build ./...
                    ;;
                haskell|hs)
                    cd impl/haskell && cabal build
                    ;;
                java)
                    cd impl/java && ./gradlew build
                    ;;
                kotlin|kt)
                    cd impl/kotlin && ./gradlew build
                    ;;
                lua)
                    echo "No build step needed — interpreted language."
                    ;;
                php)
                    echo "No build step needed — interpreted language."
                    ;;
                python|py)
                    echo "No build step needed — pure Python package."
                    ;;
                ruby|rb)
                    echo "No build step needed — interpreted language."
                    ;;
                rust|rs)
                    cd impl/rust && cargo build
                    ;;
                scala|sc)
                    cd impl/scala && ./gradlew build
                    ;;
                typescript|ts)
                    cd impl/typescript && npm run build
                    ;;
                *)
                    echo "Unknown target '${_target}'. Try 'just build help'." >&2
                    exit 1
                    ;;
            esac
        ) 2>&1 | tee ".logs/build/${_name}.log"
    fi

# Run linters
[group('lint')]
lint *target:
    #!/usr/bin/env bash
    set -euo pipefail
    _jflag=""; _sflag=""; _target=""; _prev=""
    for _a in {{target}}; do
        if [ "${_prev}" = "-j" ]; then _jflag="${_a}"; _prev=""; continue; fi
        if [ "${_prev}" = "-s" ]; then _sflag="${_a}"; _prev=""; continue; fi
        if [ "${_a}" = "-j" ]; then _prev="-j"; continue; fi
        if [ "${_a}" = "-s" ]; then _prev="-s"; continue; fi
        _target="${_target:+${_target} }${_a}"
    done
    if [ "${_target}" = "help" ] || [ "${_target}" = "--help" ]; then
        printf '%s\n' \
            "Usage: just lint [flags] [target]" \
            "" \
            "Run linters for all languages in parallel, or a single target." \
            "" \
            "Languages:" \
            "  c++ (cpp)        Compiler warnings (cmake build)" \
            "  clojure (clj)    No-op" \
            "  csharp (cs)      dotnet build (warnings=errors)" \
            "  fsharp (fs)      dotnet build (warnings=errors)" \
            "  go               golangci-lint" \
            "  haskell (hs)     GHC -Wall -Werror (via cabal build)" \
            "  java             Gradle build (compiler warnings)" \
            "  kotlin (kt)      Gradle build (compiler warnings)" \
            "  lua              No-op" \
            "  php              PHPStan" \
            "  python (py)      Ruff + Pyright" \
            "  ruby (rb)        No-op" \
            "  rust (rs)        cargo clippy" \
            "  scala (sc)       Gradle build (compiler warnings)" \
            "  typescript (ts)  tsc + ESLint" \
            "" \
            "Flags:" \
            "  -j VALUE   Set concurrency: integer, percentage, or 'unlimited'" \
            "  -s MODE    Visualization: scroll (default), full, or zoom" \
            "" \
            "Examples:" \
            "  just lint        Lint all languages in parallel" \
            "  just lint py     Lint Python only"
        exit 0
    fi
    if [ -z "${_target}" ]; then
        {{_runner}} ${_jflag:+-j "${_jflag}"} ${_sflag:+-s "${_sflag}"} lint \
            "lint cpp" \
            "lint clojure" \
            "lint csharp" \
            "lint fsharp" \
            "lint go" \
            "lint haskell" \
            "lint java" \
            "lint kotlin" \
            "lint lua" \
            "lint php" \
            "lint python" \
            "lint ruby" \
            "lint rust" \
            "lint scala" \
            "lint typescript"
    else
        _name="$(just _name "${_target}")"
        mkdir -p .logs/lint
        (
            case "${_target}" in
                c++|cpp)
                    cd impl/cpp && cmake -B build -DCMAKE_BUILD_TYPE=Release 2>&1 && cmake --build build 2>&1
                    ;;
                clojure|clj)
                    echo "No linter configured for Clojure."
                    ;;
                csharp|cs)
                    cd impl/csharp && dotnet build
                    ;;
                fsharp|fs)
                    cd impl/fsharp && dotnet build
                    ;;
                go)
                    cd impl/go && golangci-lint run
                    ;;
                haskell|hs)
                    cd impl/haskell && cabal build
                    ;;
                java)
                    cd impl/java && ./gradlew build
                    ;;
                kotlin|kt)
                    cd impl/kotlin && ./gradlew build
                    ;;
                lua)
                    echo "No linter configured for Lua."
                    ;;
                php)
                    cd impl/php && vendor/bin/phpstan analyse
                    ;;
                python|py)
                    cd impl/python && uv run --extra dev ruff check . && uv run --extra dev pyright
                    ;;
                ruby|rb)
                    echo "No linter configured for Ruby."
                    ;;
                rust|rs)
                    cd impl/rust && cargo clippy -- -D warnings
                    ;;
                scala|sc)
                    cd impl/scala && ./gradlew build
                    ;;
                typescript|ts)
                    cd impl/typescript && npm run lint
                    ;;
                *)
                    echo "Unknown target '${_target}'. Try 'just lint help'." >&2
                    exit 1
                    ;;
            esac
        ) 2>&1 | tee ".logs/lint/${_name}.log"
    fi

# Generate locale files from JSON
[group('codegen')]
generate *target:
    #!/usr/bin/env bash
    set -euo pipefail
    _target="{{target}}"
    if [ "${_target}" = "help" ] || [ "${_target}" = "--help" ]; then
        printf '%s\n' \
            "Usage: just generate locales" \
            "" \
            "Generate locale source files from JSON definitions." \
            "" \
            "Targets:" \
            "  locales    Regenerate all locale files" \
            "" \
            "Examples:" \
            "  just generate locales"
        exit 0
    fi
    case "${_target}" in
        locales)
            {{python}} -m codegen.generate
            ;;
        *)
            echo "Unknown target '${_target}'. Try 'just generate help'." >&2
            exit 1
            ;;
    esac

# Verify generated files are current
[group('codegen')]
check:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> Checking codegen is current"
    {{python}} -m codegen.generate --check
    echo ""
    echo "==> Checking locale docs are current"
    (cd .. && {{python}} tools/generate_locale_docs.py --check)

# Remove build artifacts
[group('clean')]
clean *target:
    #!/usr/bin/env bash
    set -euo pipefail
    _jflag=""; _sflag=""; _target=""; _prev=""
    for _a in {{target}}; do
        if [ "${_prev}" = "-j" ]; then _jflag="${_a}"; _prev=""; continue; fi
        if [ "${_prev}" = "-s" ]; then _sflag="${_a}"; _prev=""; continue; fi
        if [ "${_a}" = "-j" ]; then _prev="-j"; continue; fi
        if [ "${_a}" = "-s" ]; then _prev="-s"; continue; fi
        _target="${_target:+${_target} }${_a}"
    done
    if [ "${_target}" = "help" ] || [ "${_target}" = "--help" ]; then
        printf '%s\n' \
            "Usage: just clean [flags] [target]" \
            "" \
            "Remove build artifacts for all or one language." \
            "" \
            "Languages:" \
            "  c++ (cpp)        Remove build/" \
            "  clojure (clj)    Remove .cpcache" \
            "  csharp (cs)      Remove bin/ and obj/" \
            "  fsharp (fs)      Remove bin/ and obj/" \
            "  go               No artifacts to clean" \
            "  haskell (hs)     Remove dist-newstyle/" \
            "  java             Gradle clean" \
            "  kotlin (kt)      Gradle clean" \
            "  lua              No artifacts to clean" \
            "  php              Remove vendor, caches" \
            "  python (py)      Remove .venv, dist, egg-info, caches" \
            "  ruby (rb)        No artifacts to clean" \
            "  rust (rs)        cargo clean" \
            "  scala (sc)       Gradle clean" \
            "  typescript (ts)  Remove node_modules, dist, tsbuildinfo" \
            "" \
            "Flags:" \
            "  -j VALUE   Set concurrency: integer, percentage, or 'unlimited'" \
            "  -s MODE    Visualization: scroll (default), full, or zoom" \
            "" \
            "Examples:" \
            "  just clean       Clean all artifacts in parallel" \
            "  just clean py    Clean Python artifacts only"
        exit 0
    fi
    if [ -z "${_target}" ]; then
        {{_runner}} ${_jflag:+-j "${_jflag}"} ${_sflag:+-s "${_sflag}"} clean \
            "clean cpp" \
            "clean clojure" \
            "clean csharp" \
            "clean fsharp" \
            "clean go" \
            "clean haskell" \
            "clean java" \
            "clean kotlin" \
            "clean lua" \
            "clean php" \
            "clean python" \
            "clean ruby" \
            "clean rust" \
            "clean scala" \
            "clean typescript"
    else
        case "${_target}" in
            c++|cpp)
                rm -rf impl/cpp/build
                ;;
            clojure|clj)
                rm -rf impl/clojure/.cpcache
                ;;
            csharp|cs)
                rm -rf impl/csharp/*/bin impl/csharp/*/obj
                ;;
            fsharp|fs)
                rm -rf impl/fsharp/*/bin impl/fsharp/*/obj
                ;;
            go)
                echo "No artifacts to clean for Go."
                ;;
            haskell|hs)
                rm -rf impl/haskell/dist-newstyle
                ;;
            java)
                cd impl/java && ./gradlew clean
                ;;
            kotlin|kt)
                cd impl/kotlin && ./gradlew clean
                ;;
            lua)
                echo "No artifacts to clean for Lua."
                ;;
            php)
                rm -rf impl/php/vendor impl/php/.phpunit.cache impl/php/.phpstan.cache impl/php/.php-cs-fixer.cache
                ;;
            python|py)
                rm -rf impl/python/.venv impl/python/dist impl/python/*.egg-info impl/python/.pytest_cache
                find impl/python -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
                ;;
            ruby|rb)
                echo "No artifacts to clean for Ruby."
                ;;
            rust|rs)
                cd impl/rust && cargo clean
                ;;
            scala|sc)
                cd impl/scala && ./gradlew clean
                ;;
            typescript|ts)
                rm -rf impl/typescript/node_modules impl/typescript/dist impl/typescript/.tsbuildinfo
                ;;
            *)
                echo "Unknown target '${_target}'. Try 'just clean help'." >&2
                exit 1
                ;;
        esac
    fi
