(defn- plural [n]
  (if (= n 1) :one
    (let [mod10 (% n 10)
          mod100 (% n 100)]
      (if (and (>= mod10 2) (<= mod10 4)
               (or (< mod100 12) (> mod100 14)))
        :few
        :many))))

