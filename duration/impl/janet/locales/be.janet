(defn- plural [n]
  (let [mod10 (% n 10)
        mod100 (% n 100)]
    (cond
      (and (= mod10 1) (not= mod100 11)) :one
      (and (>= mod10 2) (<= mod10 4)
           (or (< mod100 12) (> mod100 14))) :few
      :many)))

