(defn- plural [n]
  (let [mod10 (% n 10)
        mod100 (% n 100)]
    (cond
      (or (= mod10 0) (and (>= mod100 11) (<= mod100 19))) :zero
      (and (= mod10 1) (not= mod100 11)) :one
      :other)))

