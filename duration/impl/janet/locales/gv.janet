(defn- plural [n]
  (let [mod10 (% n 10)
        mod100 (% n 100)]
    (cond
      (= mod10 1) :one
      (= mod10 2) :two
      (or (= mod100 0) (= mod100 20) (= mod100 40) (= mod100 60) (= mod100 80)) :few
      :other)))

