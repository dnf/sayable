fn build_bn() -> DurationLocale:
    """Build the Bengali locale."""
    fn plural(n: Int) -> String:
        if n == 0 or n == 1:
            return "one"
        return "other"

    var second = simple_unit("{n} সেকেন্ড")
    var minute = simple_unit("{n} মিনিট")
    var hour = simple_unit("{n} ঘন্টা")
    var day = plural_unit(one="{n} দিন", other="{n} দিন")
    var week = plural_unit(one="{n} সপ্তাহ", other="{n} সপ্তাহ")
    var month = plural_unit(one="{n} মাস", other="{n} মাস")
    var year = plural_unit(one="{n} বছর", other="{n} বছর")

    var short_ovr = CompactnessOverride()
    short_ovr.second = simple_unit("{n} সেকেন্ড")
    short_ovr.has_second = True
    short_ovr.minute = simple_unit("{n} মিনিট")
    short_ovr.has_minute = True
    short_ovr.hour = simple_unit("{n} ঘণ্টা")
    short_ovr.has_hour = True
    short_ovr.day = simple_unit("{n} দিন")
    short_ovr.has_day = True
    short_ovr.week = simple_unit("{n} সপ্তাহ")
    short_ovr.has_week = True
    short_ovr.month = simple_unit("{n} মাস")
    short_ovr.has_month = True
    short_ovr.year = simple_unit("{n} বছর")
    short_ovr.has_year = True
    short_ovr.ago = "{0} আগে"
    short_ovr.has_ago = True
    short_ovr.in_future = "{0} পরে"
    short_ovr.has_in_future = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.second = simple_unit("{n} সেঃ")
    compact_ovr.has_second = True
    compact_ovr.minute = simple_unit("{n} মিঃ")
    compact_ovr.has_minute = True
    compact_ovr.hour = simple_unit("{n} ঘঃ")
    compact_ovr.has_hour = True
    compact_ovr.day = simple_unit("{n} দিন")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n} সপ্তাহ")
    compact_ovr.has_week = True
    compact_ovr.month = simple_unit("{n} মাস")
    compact_ovr.has_month = True
    compact_ovr.year = simple_unit("{n} বছর")
    compact_ovr.has_year = True
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True
    compact_ovr.ago = "{0} আগে"
    compact_ovr.has_ago = True
    compact_ovr.in_future = "{0} পরে"
    compact_ovr.has_in_future = True

    return DurationLocale(
