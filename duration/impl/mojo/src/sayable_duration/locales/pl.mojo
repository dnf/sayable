fn _plural(n: Int) -> String:
    if n == 1:
        return "one"
    var mod10 = n % 10
    var mod100 = n % 100
    if 2 <= mod10 <= 4 and (mod100 < 12 or mod100 > 14):
        return "few"
    return "many"


