    short_ovr.ago = "{0} క్రితం"
    short_ovr.has_ago = True
    short_ovr.in_future = "{0} తర్వాత"
    short_ovr.has_in_future = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.second = simple_unit("{n}సె")
    compact_ovr.has_second = True
    compact_ovr.minute = simple_unit("{n}ని")
