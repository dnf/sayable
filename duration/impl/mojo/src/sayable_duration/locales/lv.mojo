fn _plural(n: Int) -> String:
    var mod10 = n % 10
    var mod100 = n % 100
    if mod10 == 0 or 11 <= mod100 <= 19:
        return "zero"
    if mod10 == 1 and mod100 != 11:
        return "one"
    return "other"


