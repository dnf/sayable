"""Amharic locale."""

from ..locale import (
    DurationLocale,
    CompactnessOverride,
    UnitForms,
    simple_unit,
    plural_unit,
)


fn build_am() -> DurationLocale:
    """Build the Amharic locale."""
    fn plural(n: Int) -> String:
        if n == 0 or n == 1:
            return "one"
        return "other"

    var second = plural_unit(one="{n} ሰከንድ", other="{n} ሰከንዶች")
    var minute = plural_unit(one="{n} ደቂቃ", other="{n} ደቂቃዎች")
    var hour = plural_unit(one="{n} ሰዓት", other="{n} ሰዓቶች")
    var day = plural_unit(one="{n} ቀን", other="{n} ቀናት")
    var week = plural_unit(one="{n} ሳምንት", other="{n} ሳምንታት")
    var month = plural_unit(one="{n} ወር", other="{n} ወራት")
    var year = plural_unit(one="{n} ዓመት", other="{n} ዓመታት")

    var short_ovr = CompactnessOverride()
    short_ovr.second = simple_unit("{n} ሰከ")
    short_ovr.has_second = True
    short_ovr.minute = plural_unit(one="{n} ደቂ", other="{n} ደቂቃ")
    short_ovr.has_minute = True
    short_ovr.hour = simple_unit("{n} ሰዓ")
    short_ovr.has_hour = True
    short_ovr.day = simple_unit("{n} ቀናት")
    short_ovr.has_day = True
    short_ovr.week = plural_unit(one="{n} ሳምንት", other="{n} ሳምንታት")
    short_ovr.has_week = True
    short_ovr.month = simple_unit("{n} ወራት")
    short_ovr.has_month = True
    short_ovr.year = plural_unit(one="{n} ዓመት", other="{n} ዓመታት")
    short_ovr.has_year = True
    short_ovr.ago = "ከ{0} በፊት"
    short_ovr.has_ago = True
    short_ovr.in_future = "በ{0} ውስጥ"
    short_ovr.has_in_future = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.second = simple_unit("{n} ሰ")
    compact_ovr.has_second = True
    compact_ovr.minute = simple_unit("{n} ደ")
    compact_ovr.has_minute = True
    compact_ovr.hour = simple_unit("{n} ሰ")
    compact_ovr.has_hour = True
    compact_ovr.day = simple_unit("{n} ቀ")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n} ሳምንት")
    compact_ovr.has_week = True
    compact_ovr.month = simple_unit("{n} ወር")
    compact_ovr.has_month = True
    compact_ovr.year = plural_unit(one="{n} ዓመት", other="{n} ዓ")
    compact_ovr.has_year = True
    compact_ovr.half = "{n}½"
    compact_ovr.has_half = True
    compact_ovr.delimiter = ""
    compact_ovr.has_delimiter = True
    compact_ovr.ago = "ከ{0} በፊት"
    compact_ovr.has_ago = True
    compact_ovr.in_future = "በ{0} ውስጥ"
    compact_ovr.has_in_future = True

    return DurationLocale(
        code="am",
        plural_fn=plural,
        second=second,
        minute=minute,
        hour=hour,
        day=day,
        week=week,
        month=month,
        year=year,
        half="{0} ተኩል",
        delimiter="፣ ",
        just_now="አሁን",
        ago="ከ{0} በፊት",
        in_future="በ{0} ውስጥ",
        short_override=short_ovr,
        has_short=True,
        compact_override=compact_ovr,
        has_compact=True,
    )
