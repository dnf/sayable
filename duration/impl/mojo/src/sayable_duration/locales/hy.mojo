    var compact_ovr = CompactnessOverride()
    compact_ovr.second = simple_unit("{n} վ")
    compact_ovr.has_second = True
    compact_ovr.minute = simple_unit("{n} ր")
    compact_ovr.has_minute = True
    compact_ovr.hour = simple_unit("{n} ժ")
    compact_ovr.has_hour = True
    compact_ovr.day = simple_unit("{n} օ")
    compact_ovr.has_day = True
    compact_ovr.week = simple_unit("{n} շ")
