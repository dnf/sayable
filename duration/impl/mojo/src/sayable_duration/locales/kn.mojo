    var month = plural_unit(one="{n} ತಿಂಗಳು", other="{n} ತಿಂಗಳುಗಳು")
    var year = plural_unit(one="{n} ವರ್ಷ", other="{n} ವರ್ಷಗಳು")

    var short_ovr = CompactnessOverride()
    short_ovr.second = simple_unit("{n} ಸೆ॰")
    short_ovr.has_second = True
