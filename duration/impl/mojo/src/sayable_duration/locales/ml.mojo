    short_ovr.year = simple_unit("{n} വർഷം")
    short_ovr.has_year = True
    short_ovr.ago = "{0} മുമ്പ്"
    short_ovr.has_ago = True
    short_ovr.in_future = "{0} കഴിഞ്ഞ്"
    short_ovr.has_in_future = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.second = simple_unit("{n} സെ")
    compact_ovr.has_second = True
    compact_ovr.minute = simple_unit("{n} മി")
