    var month = plural_unit(one="{n} മാസം", other="{n} മാസങ്ങൾ")
    var year = plural_unit(one="{n} വർഷം", other="{n} വർഷങ്ങൾ")

    var short_ovr = CompactnessOverride()
    short_ovr.second = simple_unit("{n} സെ॰")
    short_ovr.has_second = True
