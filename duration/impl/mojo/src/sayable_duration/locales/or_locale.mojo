    var month = plural_unit(one="{n} ମାସ", other="{n} ମାସ")
    var year = plural_unit(one="{n} ବର୍ଷ", other="{n} ବର୍ଷ")

    var short_ovr = CompactnessOverride()
    short_ovr.second = simple_unit("{n} ସେ॰")
    short_ovr.has_second = True
    short_ovr.minute = simple_unit("{n} ମି॰")
    short_ovr.has_minute = True
    short_ovr.hour = simple_unit("{n} ଘ॰")
