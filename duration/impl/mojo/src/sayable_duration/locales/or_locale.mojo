    short_ovr.month = simple_unit("{n} ମାସ")
    short_ovr.has_month = True
    short_ovr.year = simple_unit("{n} ବର୍ଷ")
    short_ovr.has_year = True
    short_ovr.ago = "{0} ପୂର୍ବେ"
    short_ovr.has_ago = True
    short_ovr.in_future = "{0} ପରେ"
    short_ovr.has_in_future = True

    var compact_ovr = CompactnessOverride()
    compact_ovr.second = simple_unit("{n} ସେ")
    compact_ovr.has_second = True
    compact_ovr.minute = simple_unit("{n} ମି")
