use v6.d;
use Test;
use lib 'lib';
use SayableDuration::Formatter;
use SayableDuration::Locales::Registry;

# Canonical cases from duration/config/tests.json. All tests use explicit inputs for determinism.

# Null / edge cases
# 1.1
ok !defined(SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(Int)), '1.1 Null / edge cases';
# 1.2
ok !defined(SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(-1)), '1.2 Null / edge cases';
# 1.3
ok !defined(SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-since(Str, '2025-01-15T10:00:00')), '1.3 Null / edge cases';
# 1.4
ok !defined(SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-until(Str, '2025-01-15T10:00:00')), '1.4 Null / edge cases';
# 1.6
ok !defined(SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-until('2025-01-15T09:00:00', '2025-01-15T10:00:00')), '1.6 target in the past';
# Duration — seconds tier (0-59s)
# 2.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(0), 'just now', '2.1 Duration — seconds tier (0-59s)';
# 2.2
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(1), '1 second', '2.2 Duration — seconds tier (0-59s)';
# 2.3
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(45), '45 seconds', '2.3 Duration — seconds tier (0-59s)';
# 2.4
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(59), '59 seconds', '2.4 Duration — seconds tier (0-59s)';
# Duration — minutes + seconds tier (1-4 min)
# 3.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(60), '1 minute', '3.1 Duration — minutes + seconds tier (1-4 min)';
# 3.2
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(90), '1 minute, 30 seconds', '3.2 Duration — minutes + seconds tier (1-4 min)';
# 3.3
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(240), '4 minutes', '3.3 Duration — minutes + seconds tier (1-4 min)';
# 3.4
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(270), '4 minutes, 30 seconds', '3.4 Duration — minutes + seconds tier (1-4 min)';
# Duration — minutes tier (5-59 min)
# 4.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(300), '5 minutes', '4.1 Duration — minutes tier (5-59 min)';
# 4.2
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(1500), '25 minutes', '4.2 Duration — minutes tier (5-59 min)';
# 4.3
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(3540), '59 minutes', '4.3 Duration — minutes tier (5-59 min)';
# Duration — hours + minutes tier (1-5 hr)
# 5.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(3600), '1 hour', '5.1 Duration — hours + minutes tier (1-5 hr)';
# 5.2
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(5400), '1½ hours', '5.2 half marker';
# 5.3
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(8100), '2 hours, 15 minutes', '5.3 Duration — hours + minutes tier (1-5 hr)';
# 5.4
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(18000), '5 hours', '5.4 Duration — hours + minutes tier (1-5 hr)';
# Duration — hours tier (6-23 hr)
# 6.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(28800), '8 hours', '6.1 Duration — hours tier (6-23 hr)';
# 6.2
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(82800), '23 hours', '6.2 Duration — hours tier (6-23 hr)';
# Duration — days tier
# 7.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(86400), '1 day', '7.1 Duration — days tier';
# 7.2
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(97200), '1 day, 3 hours', '7.2 Duration — days tier';
# 7.3
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(129600), '1½ days', '7.3 half marker';
# 7.4
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(432000), '5 days', '7.4 Duration — days tier';
# 7.5
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(172800), '2 days', '7.5 Duration — days tier';
# Duration — weeks tier
# 8.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(604800), '1 week', '8.1 Duration — weeks tier';
# 8.2
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(1296000), '2 weeks, 1 day', '8.2 Duration — weeks tier';
# 8.3
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(2419200), '4 weeks', '8.3 Duration — weeks tier';
# Duration — months and years tier
# 9.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(2678400), '1 month', '9.1 ~31 days';
# 9.2
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(7884000), '3 months', '9.2 ~91 days';
# 9.3
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(31536000), '1 year', '9.3 365 days';
# 9.4
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(39420000), '1 year, 3 months', '9.4 ~456 days';
# Duration from ISO timestamps
# 10.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration('2025-01-15T10:00:00', '2025-01-15T11:30:00'), '1½ hours', '10.1 Duration from ISO timestamps';
# 10.2
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration('2025-01-15T10:00:00', '2025-01-15T10:45:00'), '45 minutes', '10.2 Duration from ISO timestamps';
# Relative time — since
# 11.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-since('2025-01-15T10:00:00', '2025-01-15T10:00:00'), 'just now', '11.1 Relative time — since';
# 11.2
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-since('2025-01-15T10:00:00', '2025-01-15T10:00:30'), '30 seconds ago', '11.2 Relative time — since';
# 11.3
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-since('2025-01-15T10:00:00', '2025-01-15T10:45:00'), '45 minutes ago', '11.3 Relative time — since';
# 11.4
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-since('2025-01-15T10:00:00', '2025-01-15T13:00:00'), '3 hours ago', '11.4 Relative time — since';
# Relative time — until
# 12.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-until('2025-01-15T10:00:00', '2025-01-15T10:00:00'), 'just now', '12.1 Relative time — until';
# 12.2
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-until('2025-01-15T10:20:00', '2025-01-15T10:00:00'), 'in 20 minutes', '12.2 Relative time — until';
# 12.3
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-until('2025-01-15T13:00:00', '2025-01-15T10:00:00'), 'in 3 hours', '12.3 Relative time — until';
# Locale — German
# 13.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('de')).format-duration(3600), '1 Stunde', '13.1 Locale — German';
# 13.2
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('de')).format-since('2025-01-15T10:00:00', '2025-01-15T10:05:00'), 'vor 5 Minuten', '13.2 uses locale ago template: \'vor {0}\'';
# Locale — French
# 14.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('fr')).format-duration(7200), '2 heures', '14.1 Locale — French';
# Locale — Japanese
# 15.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('ja')).format-duration(120), '2分', '15.1 Locale — Japanese';
# 15.2
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('ja')).format-since('2025-01-15T10:00:00', '2025-01-15T11:00:00'), '1時間前', '15.2 Locale — Japanese';
# Short compactness — duration
# 16.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en'), compactness => 'short').format-duration(3600), '1h', '16.1 Short compactness — duration';
# 16.2
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en'), compactness => 'short').format-duration(90), '1m, 30s', '16.2 Short compactness — duration';
# Compact compactness — duration
# 17.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en'), compactness => 'compact').format-duration(3600), '1h', '17.1 Compact compactness — duration';
# 17.2
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en'), compactness => 'compact').format-duration(90), '1m30s', '17.2 Compact compactness — duration';

# ================================================================
# Sections 18-20: short since, 500-year ceiling, timestamp validation
# ================================================================
# 18.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('men'), compactness => 'short').format-since('2025-01-20T01:32:11', '2025-01-22T15:39:16'), 'lɔhɔnga 2, awa 14 taa gbɔyɔ', '18.1 days and hours both kept';
# 19.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(15778800000), '500 years', '19.1 500 Julian years: 6000 months, the ceiling';
# 19.2
ok !defined(SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(15800000000)), '19.2 over 6000 months';
# 19.3
ok !defined(SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration(99999999999)), '19.3 well beyond the ceiling (and 32-bit range)';
# 19.4
ok !defined(SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-since('1500-01-01T00:00:00', '2025-01-01T00:00:00')), '19.4 525 years ago';
# 19.5
ok !defined(SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-until('2600-01-01T00:00:00', '2025-01-01T00:00:00')), '19.5 575 years from now';
# 20.1
is SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration('2025-01-15T10:00', '2025-01-15T11:30:00'), '1½ hours', '20.1 seconds are optional';
# 20.2
ok !defined(SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration('2025-01-15T10', '2025-01-15T11:30:00')), '20.2 minutes are required';
# 20.3
ok !defined(SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration('2025-1-5T10:00:00', '2025-01-15T11:30:00')), '20.3 unpadded date';
# 20.4
ok !defined(SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-duration('2025-02-30T10:00:00', '2025-03-15T11:30:00')), '20.4 impossible date';
# 20.5
ok !defined(SayableDuration::Formatter.new(SayableDuration::Locales::Registry::get-locale('en')).format-since('2025-01-15T10:00:00', '2025-01-15T25:00:00')), '20.5 hour out of range';

done-testing;
