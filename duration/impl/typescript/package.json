{
  "name": "sayable-duration",
  "version": "0.5.0",
  "description": "Human-friendly duration and relative time formatting",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit && eslint src/",
    "test": "vitest run"
  },
  "keywords": [
    "duration",
    "relative",
    "time",
    "human-readable",
    "format",
    "ago",
    "since",
    "hours",
    "minutes",
    "seconds"
  ],
  "author": "Don Neufeld",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnf/sayable.git",
    "directory": "duration/impl/typescript"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "homepage": "https://github.com/dnf/sayable",
  "bugs": "https://github.com/dnf/sayable/issues",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}
