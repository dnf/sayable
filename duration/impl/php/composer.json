{
    "name": "dnf/sayable-duration",
    "description": "Human-friendly duration formatting — how people actually talk about elapsed time",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Don Neufeld"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "SayableDuration\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SayableDuration\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff"
    },
    "homepage": "https://github.com/dnf/sayable",
    "keywords": [
        "duration",
        "time",
        "elapsed",
        "format",
        "relative",
        "i18n",
        "localization"
    ],
    "support": {
        "issues": "https://github.com/dnf/sayable/issues",
        "source": "https://github.com/dnf/sayable/tree/main/duration/impl/php"
    }
}
