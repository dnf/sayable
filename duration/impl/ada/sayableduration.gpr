project Sayableduration is

   type Build_Mode_Type is ("build", "test");
   Build_Mode : Build_Mode_Type := external ("BUILD_MODE", "test");

   for Source_Dirs use ("src", "src/locales");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2012", "-gnatwa", "-gnatwe", "-gnata", "-gnatVa",
         "-gnatyaAbcefhiklnOprStux");
   end Compiler;

   case Build_Mode is
      when "build" =>
         for Library_Name use "sayableduration";
         for Library_Dir use "build";
         for Library_Kind use "static";

      when "test" =>
         for Source_Dirs use ("src", "src/locales", "test");
         for Main use ("test_format_duration.adb");
         for Exec_Dir use "build";
   end case;

end Sayableduration;
