proc plural_pl {n} {
    if {$n == 1} { return "one" }
    set mod10 [expr {$n % 10}]
    set mod100 [expr {$n % 100}]
    if {$mod10 >= 2 && $mod10 <= 4 && ($mod100 < 12 || $mod100 > 14)} { return "few" }
    return "many"
}

