        plural: PluralRule.OneOtherZeroOne,
        units: UnitSet {
            second: UnitForms { one: "isekhondi {n}", other: "amasekhondi {n}" },
            minute: UnitForms { one: "umzuzu {n}", other: "imizuzu {n}" },
            hour: UnitForms { one: "ihora {n}", other: "amahora {n}" },
            day: UnitForms { one: "usuku {n}", other: "izinsuku {n}" },
            week: UnitForms { one: "iviki {n}", other: "amaviki {n}" },
            month: UnitForms { one: "inyanga {n}", other: "izinyanga {n}" },
            year: UnitForms { one: "unyaka {n}", other: "iminyaka {n}" },
        },
        half: "{0} nohhafu",
        delimiter: ", ",
        just_now: "khona manje",
        ago: "{0} edlule",
        in_future: "ngo-{0}",
        short_override: CompactnessOverride {
            units: UnitSet {
                second: UnitForms { one: "isekhondi {n}", other: "amasekhondi {n}" },
                minute: UnitForms { one: "umzuzu {n}", other: "imizuzu {n}" },
                hour: UnitForms { one: "ihora {n}", other: "amahora {n}" },
                day: UnitForms { one: "usuku {n}", other: "izinsuku {n}" },
                week: UnitForms { one: "iviki {n}", other: "amaviki {n}" },
                month: UnitForms { one: "inyanga {n}", other: "izinyanga {n}" },
                year: UnitForms { one: "unyaka {n}", other: "iminyaka {n}" },
            },
            has_ago: true, ago: "{0} edlule",
            has_in_future: true, in_future: "ngo-{0}",
            ..
        },
        compact_override: CompactnessOverride {
            units: UnitSet {
                second: UnitForms { other: "{n} sk" },
                minute: UnitForms { other: "{n} mz" },
                hour: UnitForms { other: "{n} hr" },
                day: UnitForms { other: "{n} ns" },
                week: UnitForms { other: "{n} vk" },
                month: UnitForms { other: "{n} ny" },
                year: UnitForms { other: "{n} mk" },
            },
            has_half: true, half: "{n}½",
            has_delimiter: true, delimiter: "",
            has_ago: true, ago: "{0} edlule",
            has_in_future: true, in_future: "ngo-{0}",
            ..
        },
    };
}

