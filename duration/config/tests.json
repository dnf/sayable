{
  "meta": {
    "description": "Canonical test cases for sayable-duration. This is the single source of truth — every test case listed here must be implemented in every language.",
    "totalTests": 55,
    "notes": [
      "All test cases use explicit inputs for determinism.",
      "When a single test covers multiple canonical IDs, list them with commas."
    ]
  },
  "sections": [
    {
      "id": 1,
      "title": "Null / edge cases",
      "tests": [
        {"id": "1.1", "function": "format_duration", "input": {"seconds": null}, "expected": null},
        {"id": "1.2", "function": "format_duration", "input": {"seconds": -1}, "expected": null},
        {"id": "1.3", "function": "format_since", "input": {"start": null, "asOf": "2025-01-15T10:00:00"}, "expected": null},
        {"id": "1.4", "function": "format_until", "input": {"target": null, "asOf": "2025-01-15T10:00:00"}, "expected": null},
        {"id": "1.5", "function": "format_since", "input": {"start": "2025-01-15T10:00:00", "asOf": "2025-01-15T09:00:00"}, "expected": null, "notes": "asOf before start"},
        {"id": "1.6", "function": "format_until", "input": {"target": "2025-01-15T09:00:00", "asOf": "2025-01-15T10:00:00"}, "expected": null, "notes": "target in the past"}
      ]
    },
    {
      "id": 2,
      "title": "Duration — seconds tier (0-59s)",
      "tests": [
        {"id": "2.1", "function": "format_duration", "input": {"seconds": 0}, "expected": "just now"},
        {"id": "2.2", "function": "format_duration", "input": {"seconds": 1}, "expected": "1 second"},
        {"id": "2.3", "function": "format_duration", "input": {"seconds": 45}, "expected": "45 seconds"},
        {"id": "2.4", "function": "format_duration", "input": {"seconds": 59}, "expected": "59 seconds"}
      ]
    },
    {
      "id": 3,
      "title": "Duration — minutes + seconds tier (1-4 min)",
      "tests": [
        {"id": "3.1", "function": "format_duration", "input": {"seconds": 60}, "expected": "1 minute"},
        {"id": "3.2", "function": "format_duration", "input": {"seconds": 90}, "expected": "1 minute, 30 seconds"},
        {"id": "3.3", "function": "format_duration", "input": {"seconds": 240}, "expected": "4 minutes"},
        {"id": "3.4", "function": "format_duration", "input": {"seconds": 270}, "expected": "4 minutes, 30 seconds"}
      ]
    },
    {
      "id": 4,
      "title": "Duration — minutes tier (5-59 min)",
      "tests": [
        {"id": "4.1", "function": "format_duration", "input": {"seconds": 300}, "expected": "5 minutes"},
        {"id": "4.2", "function": "format_duration", "input": {"seconds": 1500}, "expected": "25 minutes"},
        {"id": "4.3", "function": "format_duration", "input": {"seconds": 3540}, "expected": "59 minutes"}
      ]
    },
    {
      "id": 5,
      "title": "Duration — hours + minutes tier (1-5 hr)",
      "tests": [
        {"id": "5.1", "function": "format_duration", "input": {"seconds": 3600}, "expected": "1 hour"},
        {"id": "5.2", "function": "format_duration", "input": {"seconds": 5400}, "expected": "1½ hours", "notes": "half marker"},
        {"id": "5.3", "function": "format_duration", "input": {"seconds": 8100}, "expected": "2 hours, 15 minutes"},
        {"id": "5.4", "function": "format_duration", "input": {"seconds": 18000}, "expected": "5 hours"}
      ]
    },
    {
      "id": 6,
      "title": "Duration — hours tier (6-23 hr)",
      "tests": [
        {"id": "6.1", "function": "format_duration", "input": {"seconds": 28800}, "expected": "8 hours"},
        {"id": "6.2", "function": "format_duration", "input": {"seconds": 82800}, "expected": "23 hours"}
      ]
    },
    {
      "id": 7,
      "title": "Duration — days tier",
      "tests": [
        {"id": "7.1", "function": "format_duration", "input": {"seconds": 86400}, "expected": "1 day"},
        {"id": "7.2", "function": "format_duration", "input": {"seconds": 97200}, "expected": "1 day, 3 hours"},
        {"id": "7.3", "function": "format_duration", "input": {"seconds": 129600}, "expected": "1½ days", "notes": "half marker"},
        {"id": "7.4", "function": "format_duration", "input": {"seconds": 432000}, "expected": "5 days"},
        {"id": "7.5", "function": "format_duration", "input": {"seconds": 172800}, "expected": "2 days"}
      ]
    },
    {
      "id": 8,
      "title": "Duration — weeks tier",
      "tests": [
        {"id": "8.1", "function": "format_duration", "input": {"seconds": 604800}, "expected": "1 week"},
        {"id": "8.2", "function": "format_duration", "input": {"seconds": 1296000}, "expected": "2 weeks, 1 day"},
        {"id": "8.3", "function": "format_duration", "input": {"seconds": 2419200}, "expected": "4 weeks"}
      ]
    },
    {
      "id": 9,
      "title": "Duration — months and years tier",
      "tests": [
        {"id": "9.1", "function": "format_duration", "input": {"seconds": 2678400}, "expected": "1 month", "notes": "~31 days"},
        {"id": "9.2", "function": "format_duration", "input": {"seconds": 7884000}, "expected": "3 months", "notes": "~91 days"},
        {"id": "9.3", "function": "format_duration", "input": {"seconds": 31536000}, "expected": "1 year", "notes": "365 days"},
        {"id": "9.4", "function": "format_duration", "input": {"seconds": 39420000}, "expected": "1 year, 3 months", "notes": "~456 days"}
      ]
    },
    {
      "id": 10,
      "title": "Duration from ISO timestamps",
      "tests": [
        {"id": "10.1", "function": "format_duration", "input": {"start": "2025-01-15T10:00:00", "end": "2025-01-15T11:30:00"}, "expected": "1½ hours"},
        {"id": "10.2", "function": "format_duration", "input": {"start": "2025-01-15T10:00:00", "end": "2025-01-15T10:45:00"}, "expected": "45 minutes"}
      ]
    },
    {
      "id": 11,
      "title": "Relative time — since",
      "tests": [
        {"id": "11.1", "function": "format_since", "input": {"start": "2025-01-15T10:00:00", "asOf": "2025-01-15T10:00:00"}, "expected": "just now"},
        {"id": "11.2", "function": "format_since", "input": {"start": "2025-01-15T10:00:00", "asOf": "2025-01-15T10:00:30"}, "expected": "30 seconds ago"},
        {"id": "11.3", "function": "format_since", "input": {"start": "2025-01-15T10:00:00", "asOf": "2025-01-15T10:45:00"}, "expected": "45 minutes ago"},
        {"id": "11.4", "function": "format_since", "input": {"start": "2025-01-15T10:00:00", "asOf": "2025-01-15T13:00:00"}, "expected": "3 hours ago"}
      ]
    },
    {
      "id": 12,
      "title": "Relative time — until",
      "tests": [
        {"id": "12.1", "function": "format_until", "input": {"target": "2025-01-15T10:00:00", "asOf": "2025-01-15T10:00:00"}, "expected": "just now"},
        {"id": "12.2", "function": "format_until", "input": {"target": "2025-01-15T10:20:00", "asOf": "2025-01-15T10:00:00"}, "expected": "in 20 minutes"},
        {"id": "12.3", "function": "format_until", "input": {"target": "2025-01-15T13:00:00", "asOf": "2025-01-15T10:00:00"}, "expected": "in 3 hours"}
      ]
    },
    {
      "id": 13,
      "title": "Locale — German",
      "locale": "de",
      "tests": [
        {"id": "13.1", "function": "format_duration", "input": {"seconds": 3600}, "expected": "1 Stunde"},
        {"id": "13.2", "function": "format_since", "input": {"start": "2025-01-15T10:00:00", "asOf": "2025-01-15T10:05:00"}, "expected": "vor 5 Minuten", "notes": "uses locale ago template: 'vor {0}'"}
      ]
    },
    {
      "id": 14,
      "title": "Locale — French",
      "locale": "fr",
      "tests": [
        {"id": "14.1", "function": "format_duration", "input": {"seconds": 7200}, "expected": "2 heures"}
      ]
    },
    {
      "id": 15,
      "title": "Locale — Japanese",
      "locale": "ja",
      "tests": [
        {"id": "15.1", "function": "format_duration", "input": {"seconds": 120}, "expected": "2分"},
        {"id": "15.2", "function": "format_since", "input": {"start": "2025-01-15T10:00:00", "asOf": "2025-01-15T11:00:00"}, "expected": "1時間前"}
      ]
    },
    {
      "id": 16,
      "title": "Short compactness — duration",
      "compactness": "short",
      "tests": [
        {"id": "16.1", "function": "format_duration", "input": {"seconds": 3600}, "expected": "1h"},
        {"id": "16.2", "function": "format_duration", "input": {"seconds": 90}, "expected": "1m, 30s"}
      ]
    },
    {
      "id": 17,
      "title": "Compact compactness — duration",
      "compactness": "compact",
      "tests": [
        {"id": "17.1", "function": "format_duration", "input": {"seconds": 3600}, "expected": "1h"},
        {"id": "17.2", "function": "format_duration", "input": {"seconds": 90}, "expected": "1m30s"}
      ]
    }
  ]
}
