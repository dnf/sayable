{
  "code": "bg",
  "name": "Bulgarian",
  "pluralRule": "one_other",
  "units": {
    "second": {
      "one": "{n} секунда",
      "other": "{n} секунди"
    },
    "minute": {
      "one": "{n} минута",
      "other": "{n} минути"
    },
    "hour": {
      "one": "{n} час",
      "other": "{n} часа"
    },
    "day": {
      "one": "{n} ден",
      "other": "{n} дни"
    },
    "week": {
      "one": "{n} седмица",
      "other": "{n} седмици"
    },
    "month": {
      "one": "{n} месец",
      "other": "{n} месеца"
    },
    "year": {
      "one": "{n} година",
      "other": "{n} години"
    }
  },
  "half": "{0} и половина",
  "delimiter": ", ",
  "justNow": "току-що",
  "ago": "преди {0}",
  "inFuture": "след {0}",
  "short": {
    "units": {
      "second": "{n} сек",
      "minute": "{n} мин",
      "hour": "{n} ч",
      "day": "{n} д",
      "week": "{n} седм.",
      "month": "{n} мес.",
      "year": "{n} год."
    },
    "ago": "преди {0}",
    "inFuture": "след {0}",
    "clock": {
      "use24h": true,
      "format": "{h}:{mm}"
    }
  },
  "compact": {
    "units": {
      "second": "{n} с",
      "minute": "{n} мин",
      "hour": "{n} ч",
      "day": "{n} д",
      "week": "{n} седм.",
      "month": "{n} мес.",
      "year": "{n} г."
    },
    "delimiter": "",
    "half": "{n}½",
    "ago": "преди {0}",
    "inFuture": "след {0}",
    "clock": {
      "use24h": true,
      "format": "{h}:{mm}"
    }
  }
}
